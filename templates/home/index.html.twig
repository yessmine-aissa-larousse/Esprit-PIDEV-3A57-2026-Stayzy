{% extends 'base.html.twig' %}

{% block title %}Bienvenue sur StayZy{% endblock %}

{% block body %}
<div class="min-vh-100 d-flex align-items-center" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
    <div class="container">
        <!-- En-tête principal -->
        <div class="text-center text-white mb-5">
            <div class="mb-4">
                <i class="bi bi-house-heart-fill" style="font-size: 5rem;"></i>
            </div>
            <h1 class="display-4 fw-bold mb-3">Bienvenue sur StayZy</h1>
            <p class="lead">Plateforme de gestion locative intelligente</p>
        </div>

        <!-- Cartes d'accès -->
        <div class="row g-4 justify-content-center">
            <!-- Accès Administrateur -->
            <div class="col-lg-4 col-md-6">
                <div class="card shadow-lg border-0 h-100 hover-card">
                    <div class="card-body text-center p-5">
                        <div class="mb-4">
                            <div class="icon-circle bg-primary bg-opacity-10 mx-auto" style="width: 100px; height: 100px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-shield-check" style="font-size: 3rem; color: #0d6efd;"></i>
                            </div>
                        </div>
                        <h3 class="h4 mb-3 fw-bold text-primary">
                            <i class="bi bi-shield-lock"></i> Accès Administrateur
                        </h3>
                        <p class="text-muted mb-4">
                            Cette section est réservée aux administrateurs de la plateforme. Gérez les utilisateurs, propriétés et paramètres système.
                        </p>
                        <a href="{{ path('app_login') }}" class="btn btn-primary btn-lg w-100 shadow-sm">
                            <i class="bi bi-box-arrow-in-right"></i> Se connecter
                        </a>
                        <div class="mt-3">
                            <small class="text-muted">
                                <i class="bi bi-people-fill"></i> Gestion complète du système
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Accès Client -->
            <div class="col-lg-4 col-md-6">
                <div class="card shadow-lg border-0 h-100 hover-card">
                    <div class="card-body text-center p-5">
                        <div class="mb-4">
                            <div class="icon-circle bg-success bg-opacity-10 mx-auto" style="width: 100px; height: 100px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-person-check" style="font-size: 3rem; color: #198754;"></i>
                            </div>
                        </div>
                        <h3 class="h4 mb-3 fw-bold text-success">
                            <i class="bi bi-person-circle"></i> Accès Client
                        </h3>
                        <p class="text-muted mb-4">
                            Espace dédié aux clients. Recherchez et réservez des propriétés, gérez vos réservations et communiquez avec les propriétaires.
                        </p>
                        <a href="{{ path('app_client_portal') }}" class="btn btn-success btn-lg w-100 shadow-sm">
                            <i class="bi bi-box-arrow-in-right"></i> Accéder
                        </a>
                        <div class="mt-3">
                            <small class="text-muted">
                                <i class="bi bi-search"></i> Trouvez votre logement idéal
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Accès Propriétaire -->
            <div class="col-lg-4 col-md-6">
                <div class="card shadow-lg border-0 h-100 hover-card">
                    <div class="card-body text-center p-5">
                        <div class="mb-4">
                            <div class="icon-circle bg-warning bg-opacity-10 mx-auto" style="width: 100px; height: 100px; border-radius: 50%; display: flex; align-items: center; justify-content: center;">
                                <i class="bi bi-house-check" style="font-size: 3rem; color: #ffc107;"></i>
                            </div>
                        </div>
                        <h3 class="h4 mb-3 fw-bold text-warning">
                            <i class="bi bi-building"></i> Accès Propriétaire
                        </h3>
                        <p class="text-muted mb-4">
                            Espace pour les propriétaires. Gérez vos propriétés, suivez vos réservations et optimisez vos revenus locatifs.
                        </p>
                        <a href="{{ path('app_proprietaire_portal') }}" class="btn btn-warning btn-lg w-100 shadow-sm">
                            <i class="bi bi-box-arrow-in-right"></i> Accéder
                        </a>
                        <div class="mt-3">
                            <small class="text-muted">
                                <i class="bi bi-graph-up"></i> Maximisez vos revenus
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Informations supplémentaires -->
        <div class="text-center mt-5 text-white">
            <p class="mb-2">
                <i class="bi bi-info-circle"></i> Besoin d'aide ? 
                <a href="#" class="text-white text-decoration-underline fw-bold">Contactez-nous</a>
            </p>
            <small class="text-white-50">
                <i class="bi bi-shield-check"></i> Plateforme sécurisée et confidentielle
            </small>
        </div>
    </div>
</div>

<style>
    .hover-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    
    .hover-card:hover {
        transform: translateY(-10px);
        box-shadow: 0 1rem 3rem rgba(0,0,0,.3) !important;
    }
    
    .icon-circle {
        transition: transform 0.3s ease;
    }
    
    .hover-card:hover .icon-circle {
        transform: scale(1.1);
    }
    
    body {
        overflow-x: hidden;
    }
</style>
{% endblock %}
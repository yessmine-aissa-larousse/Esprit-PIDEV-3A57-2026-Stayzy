{# Affichage du score de confiance #}
{% set score = user.trustScore %}
{% set level = user.trustBadgeLevel %}
{% set badgeName = user.trustBadgeName %}

<div class="trust-score-widget" style="background: linear-gradient(135deg, 
    {% if level == 'gold' %}#ffd700, #ffed4e{% elseif level == 'silver' %}#c0c0c0, #e8e8e8{% else %}#cd7f32, #e8a87c{% endif %}); 
    padding: 20px; border-radius: 16px; color: white; text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
    
    {# Badge Icon #}
    <div style="margin-bottom: 15px;">
        <i class="bi bi-award-fill" style="font-size: 50px; 
            {% if level == 'gold' %}color: #fff;{% elseif level == 'silver' %}color: #fff;{% else %}color: #fff;{% endif %}"></i>
    </div>
    
    {# Score #}
    <h2 style="font-weight: 700; margin: 0; font-size: 48px; text-shadow: 2px 2px 4px rgba(0,0,0,0.2);">
        {{ score }}<span style="font-size: 24px;">/100</span>
    </h2>
    
    {# Badge Name #}
    <div style="margin-top: 10px; font-size: 18px; font-weight: 600; text-transform: uppercase; letter-spacing: 2px;">
        Badge {{ badgeName }}
    </div>
    
    {# Progress Bar #}
    <div style="background: rgba(255,255,255,0.3); height: 12px; border-radius: 20px; margin-top: 15px; overflow: hidden;">
        <div style="background: white; height: 100%; width: {{ score }}%; border-radius: 20px; transition: width 0.5s;"></div>
    </div>
    
    {# Message #}
    <p style="margin-top: 15px; margin-bottom: 0; font-size: 13px; opacity: 0.9;">
        {% if score >= 71 %}
            🎉 Excellent! Profil de confiance maximale
        {% elseif score >= 41 %}
            👍 Bon profil! Continuez à l'améliorer
        {% else %}
            💪 Complétez votre profil pour gagner plus de confiance
        {% endif %}
    </p>
</div>
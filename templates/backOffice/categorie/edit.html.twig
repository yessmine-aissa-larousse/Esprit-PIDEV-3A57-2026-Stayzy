{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Modifier une catégorie{% endblock %}

{% block admin_content %}
    {# App Content Header #}
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Modifier la catégorie</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('admin_categorie_list') }}">Catégories</a></li>
                        <li class="breadcrumb-item active">Modifier</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    {# App Content #}
    <div class="app-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-8 offset-md-2">
                    
                    {# Messages Flash #}
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                    
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                        
                        {# CARD : Informations de la catégorie #}
                        <div class="card card-warning card-outline mb-4">
                            <div class="card-header">
                                <div class="card-title">Informations de la catégorie</div>
                            </div>
                            <div class="card-body">
                                
                                {# Nom #}
                                <div class="mb-3">
                                    {{ form_label(form.nom) }}
                                    {{ form_widget(form.nom) }}
                                    {% if form.nom.vars.errors|length > 0 %}
                                        <div class="text-danger mt-1">
                                            {{ form_errors(form.nom) }}
                                        </div>
                                    {% endif %}
                                </div>

                                {# Description #}
                                <div class="mb-3">
                                    {{ form_label(form.description) }}
                                    {{ form_widget(form.description) }}
                                    {% if form.description.vars.errors|length > 0 %}
                                        <div class="text-danger mt-1">
                                            {{ form_errors(form.description) }}
                                        </div>
                                    {% endif %}
                                </div>

                                {# Icône actuelle #}
                                {% if categorie.icone %}
                                    <div class="mb-3">
                                        <label class="form-label">Icône actuelle</label>
                                        <div>
                                            <img src="{{ asset('uploads/categories/' ~ categorie.icone) }}" 
                                                 alt="Icône {{ categorie.nom }}" 
                                                 class="img-thumbnail"
                                                 style="max-width: 100px; max-height: 100px; object-fit: contain;">
                                        </div>
                                    </div>
                                {% endif %}

                                {# Icône #}
                                <div class="mb-3">
                                    {{ form_label(form.icone, categorie.icone ? 'Changer l\'icône' : 'Ajouter une icône') }}
                                    {{ form_widget(form.icone) }}
                                    <div class="form-text">{{ form_help(form.icone) }}</div>
                                </div>

                                {# Statistiques #}
                                <div class="alert alert-info">
                                    <i class="bi bi-info-circle"></i>
                                    Cette catégorie contient actuellement <strong>{{ categorie.logements|length }} logement(s)</strong>
                                </div>
                            </div>
                        </div>
                        {# Boutons d'action #}
                        <div class="card">
                            <div class="card-footer">
                                <button type="submit" class="btn btn-warning">
                                    <i class="bi bi-check-circle"></i> Enregistrer les modifications
                                </button>
                                <a href="{{ path('admin_categorie_list') }}" class="btn btn-secondary">
                                    <i class="bi bi-x-circle"></i> Annuler
                                </a>
                            </div>
                        </div>
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
{% endblock %}

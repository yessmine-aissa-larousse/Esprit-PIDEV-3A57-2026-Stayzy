{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Mes Réservations - Propriétaire{% endblock %}

{% block admin_content %}
<div class="container-fluid my-4">

    <div class="mb-4 text-center">
        <h2 class="fw-semibold text-secondary">Mes Réservations</h2>
    </div>

    {# Flash messages #}
    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show small" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    {# Filtre par logement #}
    <div class="mb-4 d-flex justify-content-center">
        <form method="get" class="d-flex align-items-center gap-2">
        
            <select name="logement" id="logement" class="form-select form-select-sm" onchange="this.form.submit()">
                <option value="">Tous les logements</option>
                {% for l in logements %}
                    <option value="{{ l.id }}" {% if selectedLogement == l.id %}selected{% endif %}>{{ l.titre }}</option>
                {% endfor %}
            </select>
        </form>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th>#</th>
                        <th>Client</th>
                        <th>Logement</th>
                        <th>Date Début</th>
                        <th>Date Fin</th>
                        <th>Personnes</th>
                        <th>Prix</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody class="small">
                    {% for r in reservations %}
                        <tr>
                            <td class="fw-medium">#{{ loop.index }}</td>
                            <td>{{ r.user.nom ~ ' ' ~ r.user.prenom }}</td>
                            <td>{{ r.logement.titre }}</td>
                            <td>{{ r.dateDebut|date('d/m/Y') }}</td>
                            <td>{{ r.dateFin|date('d/m/Y') }}</td>
                            <td>{{ r.nombrePersonnes }}</td>
                            <td>{{ r.prixTotal }} DT</td>
                            <td>
                                {% if r.status == 'EN_ATTENTE' %}
                                    <span class="badge bg-warning bg-opacity-25 text-warning-emphasis fw-normal">En attente</span>
                                {% elseif r.status == 'CONFIRMÉE' %}
                                    <span class="badge bg-success bg-opacity-25 text-success fw-normal">Confirmée</span>
                                {% else %}
                                    <span class="badge bg-danger bg-opacity-25 text-danger fw-normal">Annulée</span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                {% if r.status == 'EN_ATTENTE' %}
                                    <a href="{{ path('front_reservation_proprietaire_action', {'id': r.id, 'status': 'CONFIRMÉE'}) }}"
                                       class="btn btn-sm btn-success">Confirmer </a>
                                    <a href="{{ path('front_reservation_proprietaire_action', {'id': r.id, 'status': 'ANNULÉE'}) }}"
                                       class="btn btn-sm btn-danger ms-1">Annuler </a>
                                {% else %}
                                    <button class="btn btn-sm btn-secondary" disabled>Action impossible</button>
                                
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="9" class="text-center text-muted py-4">Aucune réservation trouvée.</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>
{% endblock %}

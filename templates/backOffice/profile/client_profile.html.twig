{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Mon Profil - Stayzy{% endblock %}

{% block admin_content %}

    {# App Content Header #}
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Mon Profil</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="{{ path('app_client_dashboard') }}">Accueil</a></li>
                        <li class="breadcrumb-item active">Mon Profil</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    {# App Content #}
    <div class="app-content">
        <div class="container-fluid">

            {# Messages Flash #}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    <i class="bi bi-check-circle me-2"></i>{{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <i class="bi bi-exclamation-triangle me-2"></i>{{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            <div class="row g-4">

                {# ══════════════════════════════════ #}
                {# COLONNE GAUCHE — Carte identité   #}
                {# ══════════════════════════════════ #}
                <div class="col-lg-3">
                    <div class="card card-primary card-outline" style="position: sticky; top: 80px;">
                        <div class="card-body text-center p-4">

                            {# Photo de profil #}
                            <div class="position-relative d-inline-block mb-3">
                                {% if app.user.profilePicture %}
                                    <img src="{{ asset('uploads/profiles/' ~ app.user.profilePicture) }}"
                                         alt="Photo de profil"
                                         class="rounded-circle"
                                         style="width: 110px; height: 110px; object-fit: cover; border: 4px solid #0d6efd;">
                                {% else %}
                                    <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold mx-auto"
                                         style="width: 110px; height: 110px; font-size: 40px; background: linear-gradient(135deg, #0d6efd, #0a58ca);">
                                        {{ app.user.prenom|slice(0,1)|upper }}{{ app.user.nom|slice(0,1)|upper }}
                                    </div>
                                {% endif %}

                                {# Badge actif #}
                                {% if app.user.isActive %}
                                    <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-success" style="font-size: 10px;">✅ Actif</span>
                                {% else %}
                                    <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-danger" style="font-size: 10px;">❌ Inactif</span>
                                {% endif %}
                            </div>

                            {# Nom + email #}
                            <h5 class="fw-bold mb-1">{{ app.user.prenom }} {{ app.user.nom }}</h5>
                            <p class="text-muted small mb-1">
                                <i class="bi bi-envelope me-1"></i>{{ app.user.email }}
                            </p>
                            {% if app.user.tel %}
                                <p class="text-muted small mb-2">
                                    <i class="bi bi-telephone me-1"></i>{{ app.user.tel }}
                                </p>
                            {% endif %}
                            <span class="badge rounded-pill px-3 py-2" style="background: #cfe2ff; color: #084298; font-size: 12px;">
                                <i class="bi bi-person-circle me-1"></i> Client
                            </span>

                            <hr>

                            {# Stats rapides #}
                            <div class="row g-2 text-center">
                                <div class="col-6">
                                    <div class="rounded-3 p-2" style="background: #e8f5e9;">
                                        <div class="fw-bold fs-5 text-success">{{ app.user.nombreFavoris }}</div>
                                        <small class="text-muted" style="font-size: 11px;">Favoris</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="rounded-3 p-2" style="background: #fff3cd;">
                                        <div class="fw-bold fs-5 text-warning">0</div>
                                        <small class="text-muted" style="font-size: 11px;">Réservations</small>
                                    </div>
                                </div>
                            </div>

                            <hr>

                            {# Score de confiance #}
                            {% include 'components/trust_score.html.twig' %}

                            <p class="text-muted small mt-3 mb-0">
                                <i class="bi bi-calendar3 me-1"></i>
                                Membre depuis {{ app.user.createdAt|date('M Y') }}
                            </p>

                        </div>
                    </div>
                </div>

                {# ══════════════════════════════════════ #}
                {# COLONNE DROITE — Formulaire + Favoris  #}
                {# ══════════════════════════════════════ #}
                <div class="col-lg-9">

                    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}}) }}

                    {# CARD 1 : Photo de profil #}
                    <div class="card card-primary card-outline mb-4">
                        <div class="card-header">
                            <div class="card-title">
                                <i class="bi bi-camera me-2"></i>Photo de profil
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="d-flex align-items-center gap-3">
                                <div id="preview">
                                    {% if app.user.profilePicture %}
                                        <img src="{{ asset('uploads/profiles/' ~ app.user.profilePicture) }}"
                                             class="rounded-circle"
                                             style="width: 70px; height: 70px; object-fit: cover; border: 3px solid #0d6efd;">
                                    {% else %}
                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-muted"
                                             style="width: 70px; height: 70px; background: #eee; font-size: 28px;">
                                            <i class="bi bi-person"></i>
                                        </div>
                                    {% endif %}
                                </div>
                                <div class="flex-grow-1">
                                    <input type="file"
                                           name="profile_picture"
                                           class="form-control"
                                           accept="image/*"
                                           onchange="previewImage(event)">
                                    <small class="text-muted">JPG, PNG — Max 2MB</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# CARD 2 : Informations personnelles #}
                    <div class="card card-info card-outline mb-4">
                        <div class="card-header">
                            <div class="card-title">
                                <i class="bi bi-person-badge me-2"></i>Informations personnelles
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="row">
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form.prenom) }}
                                        {{ form_widget(form.prenom, {'attr': {'class': 'form-control'}}) }}
                                        {% if form.prenom.vars.errors|length > 0 %}
                                            <div class="text-danger mt-1">{{ form_errors(form.prenom) }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form.nom) }}
                                        {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                                        {% if form.nom.vars.errors|length > 0 %}
                                            <div class="text-danger mt-1">{{ form_errors(form.nom) }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form.email) }}
                                        {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                                        {% if form.email.vars.errors|length > 0 %}
                                            <div class="text-danger mt-1">{{ form_errors(form.email) }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="mb-3">
                                        {{ form_label(form.tel) }}
                                        {{ form_widget(form.tel, {'attr': {'class': 'form-control', 'placeholder': '+216 XX XXX XXX'}}) }}
                                        {% if form.tel.vars.errors|length > 0 %}
                                            <div class="text-danger mt-1">{{ form_errors(form.tel) }}</div>
                                        {% endif %}
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# CARD 3 : Mot de passe #}
                    <div class="card card-warning card-outline mb-4">
                        <div class="card-header">
                            <div class="card-title">
                                <i class="bi bi-key me-2"></i>Changer le mot de passe
                            </div>
                        </div>
                        <div class="card-body">
                            <div class="col-md-8">
                                {{ form_label(form.password) }}
                                {{ form_widget(form.password, {'attr': {'class': 'form-control', 'placeholder': 'Laisser vide pour ne pas changer'}}) }}
                                <small class="text-muted">Laisser vide si vous ne souhaitez pas changer votre mot de passe</small>
                            </div>
                        </div>
                    </div>

                    {# Boutons d'action #}
                    <div class="card mb-4">
                        <div class="card-footer">
                            <button type="submit" class="btn btn-primary fw-semibold">
                                <i class="bi bi-check-circle me-2"></i>Enregistrer les modifications
                            </button>
                            <a href="{{ path('app_client_dashboard') }}" class="btn btn-secondary ms-2">
                                <i class="bi bi-x-circle me-1"></i>Annuler
                            </a>
                        </div>
                    </div>

                    {{ form_end(form) }}

                    {# Suggestions Trust Score #}
                    {% include 'components/trust_suggestions.html.twig' %}

                    {# CARD 4 : Mes favoris #}
                    <div class="card card-danger card-outline mt-4">
                        <div class="card-header">
                            <div class="card-title">
                                <i class="bi bi-heart-fill me-2"></i>Mes favoris
                                <span class="badge bg-danger ms-1">{{ app.user.nombreFavoris }}</span>
                            </div>
                            <div class="card-tools">
                                <a href="{{ path('admin_mes_favoris') }}" class="btn btn-danger btn-sm">
                                    <i class="bi bi-heart me-1"></i> Voir tous mes favoris
                                </a>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            {% if app.user.favoris|length > 0 %}
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Logement</th>
                                            <th>Prix / nuit</th>
                                            <th>Localisation</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for logement in app.user.favoris|slice(0, 5) %}
                                        <tr>
                                            <td class="ps-3 fw-semibold">{{ logement.titre }}</td>
                                            <td><span class="badge bg-success">{{ logement.prix }} €</span></td>
                                            <td class="text-muted small">
                                                {{ logement.adresse.ville|default('N/A') }}
                                            </td>
                                            <td>
                                                <a href="{{ path('app_property_details', {id: logement.id}) }}"
                                                   class="btn btn-sm btn-outline-primary"
                                                   target="_blank">
                                                    <i class="bi bi-eye"></i> Voir
                                                </a>
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                                <div class="card-footer text-end">
                                    <a href="{{ path('admin_mes_favoris') }}" class="btn btn-outline-danger btn-sm">
                                        Voir tous mes favoris <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            {% else %}
                                <div class="text-center py-5">
                                    <i class="bi bi-heart text-danger" style="font-size: 55px; opacity: 0.3;"></i>
                                    <h6 class="mt-3 text-muted">Aucun favori pour l'instant</h6>
                                    <p class="text-muted small mb-4">Parcourez nos logements et ajoutez vos coups de cœur !</p>
                                    <a href="{{ path('app_properties') }}" class="btn btn-danger">
                                        <i class="bi bi-search me-2"></i>Rechercher un logement
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                </div>
                {# fin col droite #}

            </div>
        </div>
    </div>

    <script>
    function previewImage(event) {
        const file = event.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = (e) => {
            document.getElementById('preview').innerHTML =
                `<img src="${e.target.result}" class="rounded-circle"
                      style="width:70px;height:70px;object-fit:cover;border:3px solid #0d6efd;">`;
        };
        reader.readAsDataURL(file);
    }
    </script>

{% endblock %}

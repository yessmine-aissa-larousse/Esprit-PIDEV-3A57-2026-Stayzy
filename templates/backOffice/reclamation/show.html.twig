{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Détails Réclamation{% endblock %}

{% block admin_content %}

<div class="app-content-header">
    <div class="container-fluid">
        <h4 class="mb-4">Détails de la Réclamation</h4>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">

        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="card shadow border-0">

                    <div class="card-header bg-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0 fw-semibold">
                            {{ reclamation.sujet }}
                        </h5>
                    </div>

                    <div class="card-body">

                        <div class="mb-3">
                            <small class="text-muted">Description</small>
                            <div class="mt-2">
                                {{ reclamation.description }}
                            </div>
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0 fw-semibold">Réponses</h6>

                            <a href="{{ path('reponse_new', {'id': reclamation.id}) }}"
                               class="btn btn-success btn-sm">
                                Ajouter Réponse
                            </a>
                        </div>

                        {% for reponse in reclamation.reponses %}
                            <div class="card mb-3 border-0 shadow-sm">
                                <div class="card-body">

                                    <div class="d-flex justify-content-between mb-2">
                                        <small class="text-muted">
                                            {{ reponse.dateReponse|date('d-m-Y H:i') }}
                                        </small>
                                    </div>

                                    <div>
                                        {{ reponse.contenu }}
                                    </div>

                                </div>
                            </div>
                        {% else %}
                            <div class="alert alert-light border">
                                Aucune réponse ajoutée.
                            </div>
                        {% endfor %}

                    </div>

                    <div class="card-footer bg-white text-end">
                        <a href="{{ path('reclamation_index') }}"
                           class="btn btn-outline-secondary btn-sm">
                            Retour
                        </a>
                    </div>

                </div>

            </div>
        </div>

    </div>
</div>

{% endblock %}

{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Mes Réclamations{% endblock %}

{% block admin_content %}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Mes Réclamations</h4>
            <span class="badge bg-dark px-3 py-2">
                {{ reclamations|length }} Réclamation(s)
            </span>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">

        <div class="row g-4 mt-2">

            {% for rec in reclamations %}
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm border-0 h-100">

                        <div class="card-body d-flex flex-column">

                            <!-- Sujet + Statut -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="fw-semibold mb-0 text-dark">
                                    {{ rec.sujet }}
                                </h6>

                                {% if rec.statut == 'EN_ATTENTE' %}
                                    <span class="badge bg-warning text-dark">En attente</span>
                                {% elseif rec.statut == 'TRAITEE' %}
                                    <span class="badge bg-success">Traitée</span>
                                {% endif %}
                            </div>

                            <!-- Date -->
                            <small class="text-muted mb-2">
                                {{ rec.dateReclamation|date('d-m-Y H:i') }}
                            </small>

                            <!-- Description -->
                            <p class="text-secondary small">
                                {{ rec.description }}
                            </p>

                            <hr>

                            <!-- ====== REPONSES ====== -->
                            <h6 class="text-success">Réponse :</h6>

                            {% if rec.reponses|length > 0 %}
                                {% for rep in rec.reponses %}
                                    <div class="alert alert-success py-2 px-3 mt-2 mb-2">
                                        <div class="small">
                                            {{ rep.contenu }}
                                        </div>
                                        <small class="text-muted">
                                            {{ rep.dateReponse|date('d-m-Y H:i') }}
                                        </small>
                                    </div>
                                {% endfor %}
                            {% else %}
                                <div class="alert alert-warning py-2 mt-2">
                                    Pas encore de réponse
                                </div>
                            {% endif %}

                        </div>
                    </div>
                </div>

            {% else %}
                <div class="col-12">
                    <div class="alert alert-light border text-center">
                        Aucune réclamation trouvée.
                    </div>
                </div>
            {% endfor %}

        </div>

    </div>
</div>

{% endblock %}

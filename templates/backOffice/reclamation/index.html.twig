{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Liste Réclamations{% endblock %}

{% block admin_content %}
<form method="get" class="d-flex mb-3">

    <input type="text"
           name="search"
           class="form-control me-2"
           placeholder="Rechercher par sujet"
           value="{{ app.request.get('search') }}">

    <select name="statut" class="form-select me-2">
        <option value="">Tous</option>

        <option value="EN_ATTENTE"
            {% if app.request.get('statut') == 'EN_ATTENTE' %}selected{% endif %}>
            En attente
        </option>

        <option value="TRAITEE"
            {% if app.request.get('statut') == 'TRAITEE' %}selected{% endif %}>
            Traitée
        </option>
    </select>

    <button class="btn btn-dark">Filtrer</button>

</form>


<div class="app-content-header">
    <div class="container-fluid">
        <div class="d-flex justify-content-between align-items-center">
            <h4 class="mb-0">Liste des Réclamations</h4>
            <span class="badge bg-dark px-3 py-2">
                {{ reclamations|length }} Réclamation(s)
            </span>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">

        <div class="row g-4 mt-2">

            {% for rec in reclamations %}
                <div class="col-md-6 col-lg-4">
                    <div class="card shadow-sm border-0 h-100">

                        <div class="card-body d-flex flex-column">

                            <!-- Sujet + Statut -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h6 class="fw-semibold mb-0 text-dark">
                                    {{ rec.sujet }}
                                </h6>

                                {% if rec.statut == 'EN_ATTENTE' %}
                                    <span class="badge bg-warning text-dark">En attente</span>
                                {% elseif rec.statut == 'TRAITEE' %}
                                    <span class="badge bg-success">Traitée</span>
                                {% else %}
                                    <span class="badge bg-secondary">
                                        {{ rec.statut }}
                                    </span>
                                {% endif %}
                            </div>

                            <!-- Date -->
                            <small class="text-muted mb-2">
                                {{ rec.dateReclamation|date('d-m-Y H:i') }}
                            </small>

                            <!-- Description courte -->
                            <p class="text-secondary small flex-grow-1">
                                {{ rec.description|length > 100 
                                    ? rec.description|slice(0,100) ~ '...' 
                                    : rec.description }}
                            </p>

                            <!-- Boutons -->
                            <div class="d-flex justify-content-between align-items-center mt-3">

                                <a href="{{ path('reclamation_show', {'id': rec.id}) }}"
                                   class="btn btn-sm btn-outline-dark">
                                    Voir details
                                </a>

                                <div class="d-flex gap-2">

                                    <a href="{{ path('reclamation_edit', {'id': rec.id}) }}"
                                       class="btn btn-sm btn-outline-primary">
                                        Modifier
                                    </a>

                                    <form method="post"
                                          action="{{ path('reclamation_delete', {'id': rec.id}) }}"
                                          onsubmit="return confirm('Supprimer cette réclamation ?');">

                                        <input type="hidden" name="_token"
                                               value="{{ csrf_token('delete' ~ rec.id) }}">

                                        <button class="btn btn-sm btn-outline-danger">
                                            Supprimer
                                        </button>
                                    </form>

                                </div>
                            </div>

                        </div>
                    </div>
                </div>

            {% else %}
                <div class="col-12">
                    <div class="alert alert-light border text-center">
                        Aucune réclamation trouvée.
                    </div>
                </div>
            {% endfor %}

        </div>

    </div>
</div>

{% endblock %}

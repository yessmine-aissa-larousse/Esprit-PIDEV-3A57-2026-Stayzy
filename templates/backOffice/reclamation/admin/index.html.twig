{% extends 'backOffice/base_admin.html.twig' %}
{% block title %}Supervision Réclamations{% endblock %}

{% block admin_content %}

<div class="card shadow-sm">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h3 class="card-title mb-0">Supervision réclamations</h3>

        <div>
            <span class="badge bg-danger">
                {{ reclamations|filter(r => r.riskScore > 70)|length }} Critiques
            </span>

            <span class="badge bg-warning text-dark ms-2">
                {{ reclamations|filter(r => r.riskScore > 30 and r.riskScore <= 70)|length }} Moyennes
            </span>

            <span class="badge bg-secondary ms-2">
                {{ reclamations|filter(r => r.riskScore <= 30)|length }} Normales
            </span>
        </div>
    </div>
</div>

<div class="app-content">
<div class="container-fluid">

    <!-- ===== FILTRES ===== -->
    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <form method="get" class="row g-2">
                <div class="col-md-4">
                    <input type="text" name="sujet"
                           value="{{ app.request.get('sujet') }}"
                           class="form-control"
                           placeholder="Rechercher par sujet...">
                </div>

                <div class="col-md-3">
                    <select name="statut" class="form-select">
                        <option value="">Tous les statuts</option>
                        <option value="EN_ATTENTE" {{ app.request.get('statut') == 'EN_ATTENTE' ? 'selected' }}>
                            En attente
                        </option>
                        <option value="TRAITEE" {{ app.request.get('statut') == 'TRAITEE' ? 'selected' }}>
                            Traitée
                        </option>
                    </select>
                </div>

                <div class="col-md-3">
                    <select name="tri" class="form-select">
                        <option value="DESC" {{ app.request.get('tri') != 'ASC' ? 'selected' }}>
                            Plus récentes
                        </option>
                        <option value="ASC" {{ app.request.get('tri') == 'ASC' ? 'selected' }}>
                            Plus anciennes
                        </option>
                    </select>
                </div>

                <div class="col-md-2 d-grid">
                    <button class="btn btn-primary">Filtrer</button>
                </div>
            </form>
        </div>
    </div>

    <!-- ===== TABLE ===== -->
    <div class="card shadow-sm">
        <div class="card-body table-responsive p-0">

            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Client</th>
                    <th>Sujet</th>
                    <th>Description</th>
                    <th>Risk</th>
                    <th>Orientation</th>
                    <th>Statut</th>
                    <th>Réponse</th>
                    <th>Action</th>
                </tr>
                </thead>

                <tbody>
                {% for rec in reclamations %}
                {% set target = intelligenceService.detectTargetRole(rec) %}
                <tr>

                    <td>#{{ rec.id }}</td>
                    <td>{{ rec.user.id }}</td>
                    <td>{{ rec.sujet }}</td>

                    <!-- DESCRIPTION -->
                    <td style="max-width:250px;">
                        {% if rec.description|length > 60 %}
                            {{ rec.description|slice(0,60) }}...
                            <button class="btn btn-sm btn-link p-0"
                                    onclick="showFullDescription(`{{ rec.description|e('js') }}`)">
                                Voir
                            </button>
                        {% else %}
                            {{ rec.description }}
                        {% endif %}

                        <div class="mt-2 d-flex gap-2">

                            <select class="form-select form-select-sm"
                                    id="lang-{{ rec.id }}"
                                    style="width:110px;">
                                <option value="en">EN</option>
                                <option value="fr">FR</option>
                                <option value="ar">AR</option>
                                <option value="de">DE</option>
                                <option value="es">ES</option>
                            </select>

                            <button class="btn btn-sm btn-outline-info"
                                    onclick="translateDescription({{ rec.id }})">
                                🌍
                            </button>

                        </div>
                    </td>

                    <!-- RISK -->
                    <td>
                        {% if rec.riskScore > 70 %}
                            <span class="badge bg-danger">{{ rec.riskScore }}</span>
                        {% elseif rec.riskScore > 30 %}
                            <span class="badge bg-warning text-dark">{{ rec.riskScore }}</span>
                        {% else %}
                            <span class="badge bg-success">{{ rec.riskScore }}</span>
                        {% endif %}
                    </td>

                    <!-- ORIENTATION -->
                    <td>
                        {% if target == 'ADMIN' %}
                            <span class="badge bg-primary">Admin</span>
                        {% else %}
                            <span class="badge bg-info text-dark">Propriétaire</span>
                        {% endif %}
                    </td>

                    <!-- STATUT -->
<td>
    {% if rec.statut == 'ESCALATED' %}
        <span class="badge bg-danger">
            +48h Escaladée
        </span>

    {% elseif rec.statut == 'EN_ATTENTE' %}
        <span class="badge bg-warning text-dark">
            En attente
        </span>

    {% elseif rec.statut == 'TRAITEE' %}
        <span class="badge bg-success">
            Traitée
        </span>

    {% else %}
        <span class="badge bg-secondary">
            {{ rec.statut }}
        </span>
    {% endif %}
</td>

                    <!-- REPONSE -->
                    <td>
                        {% if rec.reponses|length > 0 %}
                            {{ rec.reponses[0].contenu|slice(0,40) }}...
                        {% else %}
                            <span class="text-muted">Pas encore répondu</span>
                        {% endif %}
                    </td>

                   <!-- ACTION -->
<td>
    {% if rec.reponses|length == 0 and target == 'ADMIN' %}
        <a href="{{ path('admin_reponse_new', {'id': rec.id}) }}"
           class="btn btn-sm btn-outline-primary">
            Répondre
        </a>

    {% elseif rec.reponses|length > 0 and target == 'ADMIN' %}
<a href="{{ path('admin_reponse_edit', {'id': rec.reponses|first.id}) }}"
           class="btn btn-sm btn-outline-warning">
            Modifier
        </a>

    {% else %}
        <span class="text-muted">—</span>
    {% endif %}
</td>

                </tr>
                {% else %}
                <tr>
                    <td colspan="9" class="text-center text-muted p-4">
                        Aucun résultat
                    </td>
                </tr>
                {% endfor %}
                </tbody>

            </table>

            <div class="d-flex justify-content-center mt-3">
    {{ knp_pagination_render(reclamations) }}
</div>
        </div>
    </div>

</div>
</div>

{{ include('_translate_modal.html.twig') }}

<script>
function showFullDescription(text) { alert(text); }
function translateDescription(id) {
    var lang = document.getElementById('lang-' + id).value;
    translateText('/reclamation/api/' + id + '/translate?lang=' + lang, 'Description');
}
</script>

{% endblock %}
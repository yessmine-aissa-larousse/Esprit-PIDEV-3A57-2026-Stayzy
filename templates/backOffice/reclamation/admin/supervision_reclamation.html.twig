{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Supervision Réclamations - Stayzy{% endblock %}

{% block admin_content %}

{# ================= HEADER ================= #}
<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0">
                    <i class="bi bi-eye-fill me-2 text-primary"></i>
                    Supervision Réclamations
                </h3>
            </div>

            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item">
                        <a href="{{ path('admin_dashboard') }}">Accueil</a>
                    </li>
                    <li class="breadcrumb-item active">
                        Supervision
                    </li>
                </ol>
            </div>
        </div>
    </div>
</div>


{# ================= CONTENT ================= #}
<div class="app-content">
<div class="container-fluid">

    {# ═══════════════════════════════ #}
    {# STAT CARDS                     #}
    {# ═══════════════════════════════ #}
    <div class="row g-3 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm"
                 style="border-left:4px solid #5a6acf;border-radius:12px;">
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted">Total Réclamations</h6>
                        <h2 class="fw-bold">{{ total }}</h2>
                    </div>
                    <i class="bi bi-collection fs-1 text-primary"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm"
                 style="border-left:4px solid #e6a23c;border-radius:12px;">
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted">En Attente</h6>
                        <h2 class="fw-bold text-warning">{{ enAttente }}</h2>
                    </div>
                    <i class="bi bi-hourglass-split fs-1 text-warning"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm"
                 style="border-left:4px solid #2eae7b;border-radius:12px;">
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted">Traitées</h6>
                        <h2 class="fw-bold text-success">{{ traitee }}</h2>
                    </div>
                    <i class="bi bi-check-circle-fill fs-1 text-success"></i>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm"
                 style="border-left:4px solid #d64545;border-radius:12px;">
                <div class="card-body d-flex justify-content-between">
                    <div>
                        <h6 class="text-muted">Urgentes</h6>
                        <h2 class="fw-bold text-danger">{{ urgentCount }}</h2>
                    </div>
                    <i class="bi bi-exclamation-triangle-fill fs-1 text-danger"></i>
                </div>
            </div>
        </div>

    </div>


    {# ═══════════════════════════════ #}
    {# CHARTS                         #}
    {# ═══════════════════════════════ #}
    <div class="row g-3">

        <div class="col-lg-4">
            <div class="card card-outline card-primary">
                <div class="card-header fw-bold">
                    <i class="bi bi-pie-chart-fill me-2"></i>
                    Statut Réclamations
                </div>
                <div class="card-body">
                    {{ render_chart(statutChart) }}
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card card-outline card-warning">
                <div class="card-header fw-bold">
                    <i class="bi bi-bar-chart-fill me-2"></i>
                    Analyse des Risques
                </div>
                <div class="card-body">
                    {{ render_chart(riskChart) }}
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card card-outline card-danger">
                <div class="card-header fw-bold">
                    <i class="bi bi-shield-lock-fill me-2"></i>
                    Security Monitoring
                </div>
                <div class="card-body">
                    {{ render_chart(securityChart) }}
                </div>
            </div>
        </div>

    </div>

</div>
</div>

{% endblock %}
{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Supervision Réclamations - Stayzy{% endblock %}

{% block admin_content %}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0">
                    <i class="bi bi-eye-fill me-2 text-primary"></i>
                    Supervision Réclamations
                </h3>
            </div>

            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item">
                        <a href="{{ path('admin_dashboard') }}">Accueil</a>
                    </li>
                    <li class="breadcrumb-item active">
                        Supervision
                    </li>
                </ol>
            </div>
        </div>
    </div>
</div>


<div class="app-content">
<div class="container-fluid">

{# ================= STATS ================= #}
<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="card shadow-sm text-center p-3">
            <h6>Total Réclamations</h6>
            <h2>{{ total }}</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm text-center p-3">
            <h6>En Attente</h6>
            <h2 class="text-warning">{{ enAttente }}</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm text-center p-3">
            <h6>Traitées</h6>
            <h2 class="text-success">{{ traitee }}</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm text-center p-3">
            <h6>Urgentes</h6>
            <h2 class="text-danger">{{ urgentCount }}</h2>
        </div>
    </div>

</div>


{# ================= CHARTS ================= #}
<div class="row">

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">
                Statut Réclamations
            </div>
            <div class="card-body text-center">
                {{ render_chart(statutChart) }}
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">
                Analyse des Risques
            </div>
            <div class="card-body text-center">
                {{ render_chart(riskChart) }}
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">
                Security Monitoring
            </div>
            <div class="card-body text-center">
                {{ render_chart(securityChart) }}
            </div>
        </div>
    </div>

</div>

</div>
</div>

{% endblock %}
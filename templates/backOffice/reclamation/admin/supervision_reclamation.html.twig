{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Supervision Réclamations - Stayzy{% endblock %}

{% block admin_content %}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0">
                    <i class="bi bi-eye-fill me-2 text-primary"></i>
                    Supervision Réclamations
                    <span class="badge bg-primary ms-2" style="font-size:.6rem; vertical-align:middle;">
                        🤖 IA Active
                    </span>
                </h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item">
                        <a href="{{ path('admin_dashboard') }}">Accueil</a>
                    </li>
                    <li class="breadcrumb-item active">Supervision</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
<div class="container-fluid">

{# ================= STATS ================= #}
<div class="row g-3 mb-4">

    <div class="col-md-3">
        <div class="card shadow-sm text-center p-3">
            <h6>Total Réclamations</h6>
            <h2>{{ total }}</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm text-center p-3">
            <h6>En Attente</h6>
            <h2 class="text-warning">{{ enAttente }}</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm text-center p-3">
            <h6>Traitées</h6>
            <h2 class="text-success">{{ traitee }}</h2>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow-sm text-center p-3">
            <h6>Urgentes</h6>
            <h2 class="text-danger">{{ urgentCount }}</h2>
        </div>
    </div>

</div>

{# ================= IA RISK STATS ================= #}
<div class="row g-3 mb-4">

    <div class="col-12">
        <div class="card shadow-sm border-0" style="background: linear-gradient(135deg, #6c47ff11, #00c2ff11); border-left: 4px solid #6c47ff !important;">
            <div class="card-body py-2 px-3">
                <small class="text-muted fw-semibold">🤖 Analyse IA des Risques (Flask ML Model)</small>
                <div class="d-flex gap-3 mt-1 flex-wrap">
                    <span class="badge bg-danger fs-6 px-3">
                        🚨 Critiques : {{ critiques ?? 0 }}
                    </span>
                    <span class="badge bg-warning text-dark fs-6 px-3">
                        ⚠️ Moyennes : {{ moyennes ?? 0 }}
                    </span>
                    <span class="badge bg-success fs-6 px-3">
                        ✅ Normales : {{ normales ?? 0 }}
                    </span>
                    <span class="badge bg-dark fs-6 px-3">
                        🕵️ Suspects : {{ abuseCount }}
                    </span>
                </div>
            </div>
        </div>
    </div>

</div>

{# ================= CHARTS ================= #}
<div class="row">

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">
                Statut Réclamations
            </div>
            <div class="card-body text-center">
                {{ render_chart(statutChart) }}
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header fw-bold d-flex justify-content-between align-items-center">
                Analyse des Risques
                <span class="badge bg-primary" style="font-size:.65rem;">🤖 IA</span>
            </div>
            <div class="card-body text-center">
                {{ render_chart(riskChart) }}
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="card shadow-sm">
            <div class="card-header fw-bold">
                Security Monitoring
            </div>
            <div class="card-body text-center">
                {{ render_chart(securityChart) }}
            </div>
        </div>
    </div>

</div>

</div>
</div>

{% endblock %}

{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Modifier Réclamation{% endblock %}

{% block admin_content %}

<div class="app-content-header">
    <div class="container-fluid">
        <div class="row">
            <div class="col-sm-6">
                <h3 class="mb-0">Modifier Réclamation</h3>
            </div>
            <div class="col-sm-6">
                <ol class="breadcrumb float-sm-end">
                    <li class="breadcrumb-item">
                        <a href="{{ path('reclamation_index') }}">Réclamations</a>
                    </li>
                    <li class="breadcrumb-item active">Modifier</li>
                </ol>
            </div>
        </div>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">

        <div class="row justify-content-center">
            <div class="col-lg-6">

                <div class="card shadow-sm border-0">

                    <div class="card-header bg-white">
                        <h5 class="mb-0 fw-semibold">
                            <i class="bi bi-pencil-square me-2"></i>
                            Modifier les informations
                        </h5>
                    </div>

                    <div class="card-body">

                        {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                        <div class="mb-3">
                            {{ form_label(form.sujet, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.sujet, {'attr': {'class': 'form-control'}}) }}
                            <div class="text-danger small">
                                {{ form_errors(form.sujet) }}
                            </div>
                        </div>

                        <div class="mb-3">
                            {{ form_label(form.description, null, {'label_attr': {'class': 'form-label'}}) }}
                            {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5}}) }}
                            <div class="text-danger small">
                                {{ form_errors(form.description) }}
                            </div>
                        </div>

                        <div class="d-flex justify-content-end mt-4">
                            <a href="{{ path('reclamation_index') }}"
                               class="btn btn-outline-secondary me-2">
                                Annuler
                            </a>

                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>
                                Enregistrer
                            </button>
                        </div>

                        {{ form_end(form) }}

                    </div>

                </div>

            </div>
        </div>

    </div>
</div>

{% endblock %}

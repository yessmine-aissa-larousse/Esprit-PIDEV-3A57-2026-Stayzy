{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Favoris de mes clients - Stayzy{% endblock %}

{% block admin_content %}

    {# En-tête de page #}
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">
                        <i class="bi bi-star-fill text-warning me-2"></i>
                        Favoris de mes clients
                    </h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item">
                            <a href="{{ path('admin_dashboard') }}">Dashboard</a>
                        </li>
                        <li class="breadcrumb-item active" aria-current="page">Favoris clients</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    {# Contenu principal #}
    <div class="app-content">
        <div class="container-fluid">

            {# ── Small Boxes statistiques ── #}
            <div class="row mb-4">

                {# Nombre de logements #}
                <div class="col-lg-4 col-6">
                    <div class="small-box text-bg-warning">
                        <div class="inner">
                            <h3>{{ statistiques|length }}</h3>
                            <p>Logements publiés</p>
                        </div>
                        <svg class="small-box-icon" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path d="M11.47 3.84a.75.75 0 011.06 0l8.69 8.69a.75.75 0 101.06-1.06l-8.689-8.69a2.25 2.25 0 00-3.182 0l-8.69 8.69a.75.75 0 001.061 1.06l8.69-8.69z"/>
                            <path d="M12 5.432l8.159 8.159c.03.03.06.058.091.086v6.198c0 1.035-.84 1.875-1.875 1.875H15a.75.75 0 01-.75-.75v-4.5a.75.75 0 00-.75-.75h-3a.75.75 0 00-.75.75V21a.75.75 0 01-.75.75H5.625a1.875 1.875 0 01-1.875-1.875v-6.198a2.29 2.29 0 00.091-.086L12 5.43z"/>
                        </svg>
                        <a href="{{ path('admin_logement_list') }}" class="small-box-footer link-dark link-underline-opacity-0 link-underline-opacity-50-hover">
                            Voir mes logements <i class="bi bi-link-45deg"></i>
                        </a>
                    </div>
                </div>

                {# Total favoris reçus #}
                <div class="col-lg-4 col-6">
                    <div class="small-box text-bg-success">
                        <div class="inner">
                            <h3>{{ statistiques|reduce((carry, s) => carry + s.nombre_favoris, 0) }}</h3>
                            <p>Total favoris reçus</p>
                        </div>
                        <svg class="small-box-icon" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd"/>
                        </svg>
                        <span class="small-box-footer">Toutes propriétés confondues</span>
                    </div>
                </div>

                {# Logement le plus populaire #}
                <div class="col-lg-4 col-6">
                    <div class="small-box text-bg-primary">
                        <div class="inner">
                            <h3 style="font-size: 1.3rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                {% if statistiques|length > 0 and statistiques[0].nombre_favoris > 0 %}
                                    {{ statistiques[0].logement.titre }}
                                {% else %}
                                    —
                                {% endif %}
                            </h3>
                            <p>Logement le plus populaire</p>
                        </div>
                        <svg class="small-box-icon" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                            <path fill-rule="evenodd" d="M11.54 22.351l.07.04.028.016a.76.76 0 00.723 0l.028-.015.071-.041a16.975 16.975 0 001.144-.742 19.58 19.58 0 002.683-2.282c1.944-2.003 3.5-4.697 3.5-8.083a8.25 8.25 0 00-16.5 0c0 3.386 1.555 6.08 3.5 8.083a19.58 19.58 0 002.682 2.282 16.975 16.975 0 001.144.742z" clip-rule="evenodd"/>
                        </svg>
                        <span class="small-box-footer">Par nombre de favoris</span>
                    </div>
                </div>

            </div>

            {# ── Tableau principal ── #}
            {% if statistiques is empty %}
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-star fs-1 text-muted mb-3 d-block"></i>
                        <h4 class="text-muted">Aucun logement publié</h4>
                        <p class="text-muted">Vous n'avez pas encore de logements ou aucun client ne les a mis en favoris.</p>
                        <a href="{{ path('admin_logement_add') }}" class="btn btn-primary mt-2">
                            <i class="bi bi-plus-lg me-1"></i> Ajouter un logement
                        </a>
                    </div>
                </div>

            {% else %}
                <div class="card">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="bi bi-house-heart-fill me-2 text-danger"></i>
                            Popularité de vos logements
                        </h3>
                        <div class="card-tools">
                            <span class="badge text-bg-secondary">{{ statistiques|length }} logement(s)</span>
                        </div>
                    </div>

                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th style="width: 50px" class="text-center">#</th>
                                        <th>Logement</th>
                                        <th class="text-center" style="width: 120px">
                                            <i class="bi bi-star-fill text-warning me-1"></i> Favoris
                                        </th>
                                        <th>Clients intéressés</th>
                                        <th style="width: 150px">Popularité</th>
                                        <th style="width: 100px" class="text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% set maxFavoris = statistiques[0].nombre_favoris %}

                                    {% for item in statistiques %}
                                    <tr>

                                        {# Rang avec trophée pour le 1er #}
                                        <td class="text-center fw-bold text-muted">
                                            {% if loop.index == 1 and item.nombre_favoris > 0 %}
                                                <i class="bi bi-trophy-fill text-warning fs-5"></i>
                                            {% else %}
                                                {{ loop.index }}
                                            {% endif %}
                                        </td>

                                        {# Photo + infos logement #}
                                        <td>
                                            <div class="d-flex align-items-center gap-3">

                                                {# Photo #}
                                                {% if item.logement.photoPrincipale %}
                                                    <img src="{{ asset('uploads/logements/' ~ item.logement.photoPrincipale) }}"
                                                         alt="{{ item.logement.titre }}"
                                                         class="rounded shadow-sm"
                                                         style="width: 62px; height: 62px; object-fit: cover;" />
                                                {% elseif item.logement.photos and item.logement.photos|length > 0 %}
                                                    <img src="{{ asset('uploads/logements/' ~ item.logement.photos[0]) }}"
                                                         alt="{{ item.logement.titre }}"
                                                         class="rounded shadow-sm"
                                                         style="width: 62px; height: 62px; object-fit: cover;" />
                                                {% else %}
                                                    <div class="rounded bg-light d-flex align-items-center justify-content-center shadow-sm"
                                                         style="width: 62px; height: 62px; min-width: 62px;">
                                                        <i class="bi bi-house-fill text-muted fs-3"></i>
                                                    </div>
                                                {% endif %}

                                                <div>
                                                    {# Titre #}
                                                    <div class="fw-semibold">{{ item.logement.titre }}</div>

                                                    {# Catégorie #}
                                                    {% if item.logement.categorie %}
                                                        <span class="badge text-bg-light border text-dark" style="font-size:0.7rem;">
                                                            {{ item.logement.categorie.nom }}
                                                        </span>
                                                    {% endif %}

                                                    {# Adresse #}
                                                    {% if item.logement.adresse %}
                                                        <div class="text-muted" style="font-size:0.78rem;">
                                                            <i class="bi bi-geo-alt me-1"></i>
                                                            {{- item.logement.adresse.ville
                                                                ?? item.logement.adresse.rue
                                                                ?? item.logement.adresse.pays
                                                                ?? 'Adresse non précisée' -}}
                                                        </div>
                                                    {% endif %}

                                                    {# Prix #}
                                                    <div style="font-size:0.82rem;">
                                                        <span class="text-success fw-semibold">{{ item.logement.prix }} €</span>
                                                        <span class="text-muted">/ nuit</span>

                                                        {# Disponibilité #}
                                                        {% if item.logement.disponible %}
                                                            <span class="badge text-bg-success ms-1" style="font-size:0.65rem;">Disponible</span>
                                                        {% else %}
                                                            <span class="badge text-bg-danger ms-1" style="font-size:0.65rem;">Indisponible</span>
                                                        {% endif %}
                                                    </div>

                                                    {# Chambres + Superficie #}
                                                    <div class="text-muted" style="font-size:0.75rem;">
                                                        <i class="bi bi-door-closed me-1"></i>{{ item.logement.nombreChambres }} ch.
                                                        &nbsp;·&nbsp;
                                                        <i class="bi bi-arrows-angle-expand me-1"></i>{{ item.logement.superficie }} m²
                                                    </div>
                                                </div>
                                            </div>
                                        </td>

                                        {# Compteur favoris #}
                                        <td class="text-center">
                                            {% if item.nombre_favoris > 0 %}
                                                <span class="badge text-bg-warning fs-6 px-3 py-2">
                                                    <i class="bi bi-star-fill me-1"></i>{{ item.nombre_favoris }}
                                                </span>
                                            {% else %}
                                                <span class="badge text-bg-secondary px-3 py-2">
                                                    <i class="bi bi-star me-1"></i> 0
                                                </span>
                                            {% endif %}
                                        </td>

                                        {# Clients #}
                                        <td>
                                            {% if item.utilisateurs|length > 0 %}
                                                <div class="d-flex align-items-center gap-1 flex-wrap">
                                                    {% for user in item.utilisateurs|slice(0, 5) %}
                                                        <span class="badge text-bg-light border text-dark"
                                                              title="{{ user.email }}">
                                                            <i class="bi bi-person-circle me-1"></i>
                                                            {{ user.prenom ~ ' ' ~ user.nom }}
                                                        </span>
                                                    {% endfor %}
                                                    {% if item.utilisateurs|length > 5 %}
                                                        <span class="badge text-bg-secondary">
                                                            +{{ item.utilisateurs|length - 5 }} autres
                                                        </span>
                                                    {% endif %}
                                                </div>
                                            {% else %}
                                                <span class="text-muted fst-italic small">Aucun favori pour l'instant</span>
                                            {% endif %}
                                        </td>

                                        {# Barre de popularité #}
                                        <td>
                                            {% if maxFavoris > 0 %}
                                                {% set pct = (item.nombre_favoris / maxFavoris * 100)|round %}
                                                <div class="progress mb-1" style="height: 10px;" title="{{ pct }}%">
                                                    <div class="progress-bar
                                                        {% if pct >= 75 %}bg-success
                                                        {% elseif pct >= 40 %}bg-warning
                                                        {% else %}bg-danger{% endif %}"
                                                         role="progressbar"
                                                         style="--bs-progress-bar-width: {{ pct }}%; width: var(--bs-progress-bar-width);"
                                                         aria-valuenow="{{ pct }}"
                                                         aria-valuemin="0"
                                                         aria-valuemax="100">
                                                    </div>
                                                </div>
                                                <small class="text-muted">{{ pct }}% du max</small>
                                            {% else %}
                                                <span class="text-muted">—</span>
                                            {% endif %}
                                        </td>

                                        {# Actions - ✅ CORRIGÉ #}
                                        <td class="text-center">
                                            <a href="{{ path('app_property_details', {id: item.logement.id}) }}"
                                               class="btn btn-sm btn-outline-primary"
                                               title="Voir le logement"
                                               target="_blank">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            <a href="{{ path('admin_logement_edit', {id: item.logement.id}) }}"
                                               class="btn btn-sm btn-outline-secondary ms-1"
                                               title="Modifier">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                        </td>

                                    </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <div class="card-footer text-muted small">
                        <i class="bi bi-info-circle me-1"></i>
                        Classement par nombre de favoris décroissant.
                        <i class="bi bi-trophy-fill text-warning ms-2 me-1"></i> = logement le plus apprécié.
                    </div>
                </div>
            {% endif %}

        </div>
    </div>

{% endblock %}

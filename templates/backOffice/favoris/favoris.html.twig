{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Mes Favoris - Stayzy{% endblock %}

{% block admin_content %}
    {# App Content Header #}
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">
                        <i class="bi bi-heart-fill text-danger me-2"></i>Mes Favoris
                    </h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
                        <li class="breadcrumb-item active">Mes Favoris</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    {# App Content #}
    <div class="app-content">
        <div class="container-fluid">

            {% if favoris|length == 0 %}
                {# État vide #}
                <div class="row">
                    <div class="col-12">
                        <div class="card card-danger card-outline">
                            <div class="card-body text-center py-5">
                                <i class="bi bi-heart text-danger mb-3" style="font-size: 80px; opacity: 0.3;"></i>
                                <h4 class="text-muted">Aucun favori pour le moment</h4>
                                <p class="text-muted mb-4">
                                    Parcourez nos logements et ajoutez vos coups de cœur en cliquant sur 
                                    <i class="bi bi-heart text-danger"></i>
                                </p>
                                <a href="{{ path('app_properties') }}" class="btn btn-danger btn-lg">
                                    <i class="bi bi-search me-2"></i>Découvrir nos logements
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                {# Carte compteur #}
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="card card-danger card-outline">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <h5 class="mb-1">
                                            <i class="bi bi-heart-fill text-danger me-2"></i>
                                            {{ favoris|length }} Logement{{ favoris|length > 1 ? 's' : '' }} dans vos favoris
                                        </h5>
                                        <p class="text-muted mb-0">Vos coups de cœur sauvegardés</p>
                                    </div>
                                    <div>
                                        <a href="{{ path('app_properties') }}" class="btn btn-outline-danger">
                                            <i class="bi bi-plus-circle me-1"></i>Ajouter d'autres favoris
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Grille de cartes #}
                <div class="row g-4">
                    {% for logement in favoris %}
                        <div class="col-lg-4 col-md-6">
                            <div class="card card-danger card-outline h-100">
                                {# Image #}
                                <div class="position-relative">
                                    {% if logement.photoPrincipale %}
                                        <img src="{{ asset('uploads/logements/' ~ logement.photoPrincipale) }}" 
                                             class="card-img-top" 
                                             alt="{{ logement.titre }}"
                                             style="height: 200px; object-fit: cover;">
                                    {% else %}
                                        <div class="card-img-top d-flex align-items-center justify-content-center text-muted"
                                             style="height: 200px; background: #f0f0f0;">
                                            <i class="bi bi-image" style="font-size: 60px;"></i>
                                        </div>
                                    {% endif %}

                                    {# Badge prix #}
                                    <span class="position-absolute top-0 start-0 m-2 badge bg-success" style="font-size: 14px;">
                                        {{ logement.prix }}€/nuit
                                    </span>

                                    {# Bouton retirer des favoris #}
                                    <button class="favorite-btn active position-absolute top-0 end-0 m-2 btn btn-light btn-sm rounded-circle"
                                            data-logement-id="{{ logement.id }}"
                                            title="Retirer des favoris"
                                            style="width: 40px; height: 40px;">
                                        <i class="bi bi-heart-fill text-danger"></i>
                                    </button>

                                    {# Badge catégorie #}
                                    {% if logement.categorie %}
                                        <span class="position-absolute bottom-0 start-0 m-2 badge bg-primary">
                                            {{ logement.categorie.nom }}
                                        </span>
                                    {% endif %}
                                </div>

                                {# Corps de la carte #}
                                <div class="card-body">
                                    <h5 class="card-title mb-2">
                                        <a href="{{ path('app_property_details', {id: logement.id}) }}" 
                                           class="text-decoration-none text-dark"
                                           target="_blank">
                                            {{ logement.titre }}
                                        </a>
                                    </h5>

                                    {# Localisation #}
                                    <p class="text-muted small mb-3">
                                        <i class="bi bi-geo-alt text-danger"></i>
                                        {% if logement.adresse %}
                                            {{ logement.adresse.ville|default('') }}
                                            {% if logement.adresse.codePostal %}
                                                ({{ logement.adresse.codePostal }})
                                            {% endif %}
                                        {% else %}
                                            Localisation non renseignée
                                        {% endif %}
                                    </p>

                                    {# Caractéristiques #}
                                    <div class="d-flex gap-3 mb-3">
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-house-door me-1"></i>
                                            {{ logement.nombreChambres }} ch
                                        </span>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-droplet me-1"></i>
                                            {{ logement.nombreSalleDeBain }} sdb
                                        </span>
                                        <span class="badge bg-light text-dark border">
                                            <i class="bi bi-arrows-angle-expand me-1"></i>
                                            {{ logement.superficie }} m²
                                        </span>
                                    </div>

                                    {# Description courte #}
                                    {% if logement.description %}
                                        <p class="card-text text-muted small mb-3" style="max-height: 60px; overflow: hidden;">
                                            {{ logement.description|slice(0, 120) }}{{ logement.description|length > 120 ? '...' : '' }}
                                        </p>
                                    {% endif %}
                                </div>

                                {# Pied de carte #}
                                <div class="card-footer bg-white border-top">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted">
                                            <i class="bi bi-calendar-plus me-1"></i>
                                            Ajouté le {{ "now"|date('d/m/Y') }}
                                        </small>
                                        <a href="{{ path('app_property_details', {id: logement.id}) }}" 
                                           class="btn btn-sm btn-outline-danger"
                                           target="_blank">
                                            <i class="bi bi-eye me-1"></i>Voir
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% endfor %}
                </div>

                {# Card informative #}
                <div class="row mt-4">
                    <div class="col-12">
                        <div class="card card-info card-outline">
                            <div class="card-body">
                                <div class="d-flex align-items-start gap-3">
                                    <i class="bi bi-info-circle text-info" style="font-size: 30px;"></i>
                                    <div>
                                        <h6 class="mb-2">💡 Astuce</h6>
                                        <p class="mb-0 text-muted">
                                            Vos favoris sont sauvegardés automatiquement. 
                                            Cliquez sur <i class="bi bi-heart-fill text-danger"></i> pour retirer un logement de vos favoris.
                                            Vous pouvez ajouter autant de favoris que vous le souhaitez !
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            {% endif %}

        </div>
    </div>
{% endblock %}

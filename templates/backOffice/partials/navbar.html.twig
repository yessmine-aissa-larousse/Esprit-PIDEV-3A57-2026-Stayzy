<nav class="app-header navbar navbar-expand bg-body">
    <div class="container-fluid">
        {# Start Navbar Links #}
        <ul class="navbar-nav">
            <li class="nav-item">
                <a class="nav-link" data-lte-toggle="sidebar" href="#" role="button">
                    <i class="bi bi-list"></i>
                </a>
            </li>
            <li class="nav-item d-none d-md-block">
                <a href="{{ path('app_home') }}" class="nav-link">Home</a>
            </li>
            <li class="nav-item d-none d-md-block">
                <a href="{{ path('admin_dashboard') }}" class="nav-link">Dashboard</a>
            </li>
        </ul>

        {# End Navbar Links #}
        <ul class="navbar-nav ms-auto">
            {# Navbar Search #}
            <li class="nav-item">
                <a class="nav-link" data-widget="navbar-search" href="#" role="button">
                    <i class="bi bi-search"></i>
                </a>
            </li>

            {# Messages Dropdown #}
            <li class="nav-item dropdown">
                <a class="nav-link" data-bs-toggle="dropdown" href="#">
                    <i class="bi bi-chat-text"></i>
                    <span class="navbar-badge badge text-bg-danger">3</span>
                </a>
                <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                    <a href="#" class="dropdown-item">
                        <div class="d-flex">
                            <div class="flex-shrink-0">
                                <img src="{{ asset('backOffice/assets/img/user1-128x128.jpg') }}" 
                                     alt="User Avatar" 
                                     class="img-size-50 rounded-circle me-3" />
                            </div>
                            <div class="flex-grow-1">
                                <h3 class="dropdown-item-title">
                                    Message exemple
                                    <span class="float-end fs-7 text-danger"><i class="bi bi-star-fill"></i></span>
                                </h3>
                                <p class="fs-7">Nouveau message...</p>
                                <p class="fs-7 text-secondary">
                                    <i class="bi bi-clock-fill me-1"></i> 4 Hours Ago
                                </p>
                            </div>
                        </div>
                    </a>
                    <div class="dropdown-divider"></div>
                    <a href="#" class="dropdown-item dropdown-footer">See All Messages</a>
                </div>
            </li>

            {# Notifications Dropdown #}
            {# ⭐ NOTIFICATIONS ADMIN #}
            <li class="nav-item dropdown">
                <a class="nav-link" data-bs-toggle="dropdown" href="#">
                    <i class="bi bi-bell-fill"></i>
                    {% if app.user %}
                        {% set nbNonLues = app.user.notificationsNonLues %}
                        {% if nbNonLues > 0 %}
                            <span class="navbar-badge badge text-bg-danger">{{ nbNonLues }}</span>
                        {% endif %}
                    {% endif %}
                </a>
                <div class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                    {% if app.user %}
                        {% set notifications = app.user.notifications|slice(0, 5) %}
                        
                        <span class="dropdown-item dropdown-header">
                            {{ app.user.notificationsNonLues }} Notification{{ app.user.notificationsNonLues > 1 ? 's' : '' }}
                        </span>
                        
                        {% if notifications|length > 0 %}
                            <div class="dropdown-divider"></div>
                            
                            {% for notif in notifications %}
                                <a href="{{ path('admin_notification_voir', {id: notif.id}) }}" 
                                class="dropdown-item {% if not notif.lu %}fw-bold{% endif %}">
                                    <i class="bi bi-house me-2"></i> {{ notif.message|slice(0, 40) }}...
                                    <span class="float-end text-secondary fs-7">
                                        {{ notif.createdAt|date('d/m H:i') }}
                                    </span>
                                </a>
                                <div class="dropdown-divider"></div>
                            {% endfor %}
                            
                            <a href="{{ path('admin_notifications') }}" class="dropdown-item dropdown-footer">
                                Voir toutes les notifications
                            </a>
                        {% else %}
                            <div class="dropdown-divider"></div>
                            <span class="dropdown-item text-center text-muted">
                                Aucune notification
                            </span>
                        {% endif %}
                    {% endif %}
                </div>
            </li>

            {# Fullscreen Toggle #}
            <li class="nav-item">
                <a class="nav-link" href="#" data-lte-toggle="fullscreen">
                    <i data-lte-icon="maximize" class="bi bi-arrows-fullscreen"></i>
                    <i data-lte-icon="minimize" class="bi bi-fullscreen-exit" style="display: none"></i>
                </a>
            </li>

            {# User Menu Dropdown - ✅ CORRIGÉ #}
            <li class="nav-item dropdown user-menu">
                <a href="#" class="nav-link dropdown-toggle" data-bs-toggle="dropdown">
                    {% if app.user and app.user.profilePicture %}
                        <img src="{{ asset('uploads/profiles/' ~ app.user.profilePicture) }}" 
                             class="user-image rounded-circle shadow" 
                             alt="{{ app.user.fullName }}" />
                    {% else %}
                        <img src="{{ asset('backOffice/assets/img/user2-160x160.jpg') }}" 
                             class="user-image rounded-circle shadow" 
                             alt="User Image" />
                    {% endif %}
                    <span class="d-none d-md-inline">{{ app.user ? app.user.prenom : 'Admin' }}</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                    {% if app.user %}
                        <li class="user-header text-bg-primary">
                            {% if app.user.profilePicture %}
                                <img src="{{ asset('uploads/profiles/' ~ app.user.profilePicture) }}" 
                                     class="rounded-circle shadow" 
                                     alt="{{ app.user.fullName }}" />
                            {% else %}
                                <img src="{{ asset('backOffice/assets/img/user2-160x160.jpg') }}" 
                                     class="rounded-circle shadow" 
                                     alt="User Image" />
                            {% endif %}
                            <p>
                                {{ app.user.fullName }}
                                {% if app.user.isProprietaire %}
                                    - Propriétaire
                                {% elseif app.user.isClient %}
                                    - Client
                                {% else %}
                                    - Administrateur
                                {% endif %}
                                <small>Membre depuis {{ app.user.createdAt|date('M Y') }}</small>
                            </p>
                        </li>
                        <li class="user-body">
                            <div class="row">
                                <div class="col-12 text-center">
                                    <small>{{ app.user.email }}</small>
                                </div>
                            </div>
                        </li>
                        <li class="user-footer">
                            {% if app.user.isProprietaire %}
                                <a href="{{ path('app_proprietaire_profile') }}" class="btn btn-outline-secondary">Mon profil</a>
                            {% elseif app.user.isClient %}
                                <a href="{{ path('app_client_profile') }}" class="btn btn-outline-secondary">Mon profil</a>
                            {% else %}
                                <a href="{{ path('admin_dashboard') }}" class="btn btn-outline-secondary">Dashboard</a>
                            {% endif %}
                            <a href="{{ path('app_logout') }}" class="btn btn-outline-danger float-end">Déconnexion</a>
                        </li>
                    {% endif %}
                </ul>
            </li>
        </ul>
    </div>
</nav>

                        <img src="{{ app.user.imageUrl }}" 
                             class="user-image rounded-circle shadow" 
                             alt="{{ app.user.fullName }}" />
                    {% else %}
                        <img src="{{ asset('backOffice/assets/img/user2-160x160.jpg') }}" 
                             class="user-image rounded-circle shadow" 
                             alt="User Image" />
                    {% endif %}
                    <span class="d-none d-md-inline">{{ app.user ? app.user.prenom : 'Admin' }}</span>
                </a>
                <ul class="dropdown-menu dropdown-menu-lg dropdown-menu-end">
                    {% if app.user %}
                        <li class="user-header text-bg-primary">
                            {% if app.user.imageUrl %}
                                <img src="{{ app.user.imageUrl }}" 
                                     class="rounded-circle shadow" 
                                     alt="{{ app.user.fullName }}" />
                            {% else %}
                                <img src="{{ asset('backOffice/assets/img/user2-160x160.jpg') }}" 
                                     class="rounded-circle shadow" 
                                     alt="User Image" />
                            {% endif %}
                            <p>
                                {{ app.user.fullName }} - Administrateur
                                <small>Membre depuis {{ app.user.createdAt|date('M Y') }}</small>
                            </p>

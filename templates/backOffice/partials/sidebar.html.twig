{% set current = app.request.attributes.get('_route') %}
{% set isAdmin = current starts with 'admin_' %}
{% set isProp  = current starts with 'prop_' %}

<aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">

    <div class="sidebar-brand">
        <a href="{{ isAdmin ? path('admin_reclamations') : path('prop_reclamations') }}" class="brand-link">
            <img src="{{ asset('backOffice/assets/img/AdminLTELogo.png') }}"
                 class="brand-image opacity-75 shadow" />
            <span class="brand-text fw-light">Stayzy</span>
        </a>
    </div>

    <div class="sidebar-wrapper">
        <nav class="mt-2">
            <ul class="nav sidebar-menu flex-column">

                {# ================= ADMIN ================= #}
                {% if isAdmin %}
                    <li class="nav-header text-uppercase text-muted small px-3 mt-2">
                        Administration
                    </li>
                    <li class="nav-item">
                        <a href="{{ path('admin_dashboard') }}"
                           class="nav-link {{ current == 'admin_dashboard' ? 'active' }}">
                            <i class="nav-icon bi bi-speedometer2"></i>
                            <p>Dashboard</p>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="{{ path('admin_reclamations') }}"
                           class="nav-link {{ current == 'admin_reclamations' ? 'active' }}">
                            <i class="nav-icon bi bi-bar-chart-line-fill"></i>
                            <p>Toutes les réclamations</p>
                        </a>
                    </li>

                    
                {% endif %}


                {# ================= PROPRIETAIRE ================= #}
                {% if isProp %}
                    <li class="nav-header text-uppercase text-muted small px-3 mt-2">
                        Propriétaire
                    </li>

                    <li class="nav-item">
                        <a href="{{ path('prop_reclamations') }}"
                           class="nav-link {{ current == 'prop_reclamations' ? 'active' }}">
                            <i class="nav-icon bi bi-exclamation-circle"></i>
                            <p>Réclamations reçues</p>
                        </a>
                    </li>

                    <li class="nav-item">
                        <a href="{{ path('prop_reponses') }}"
                           class="nav-link {{ current == 'prop_reponses' ? 'active' }}">
                            <i class="nav-icon bi bi-chat-left-text"></i>
                            <p>Mes réponses</p>
                        </a>
                    </li>
                {% endif %}

            </ul>
        </nav>
    </div>

</aside>

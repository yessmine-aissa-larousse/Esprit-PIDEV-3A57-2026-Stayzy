{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Liste des logements{% endblock %}

{% block admin_content %}
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Liste des logements</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
                        <li class="breadcrumb-item active">Logements</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="app-content">
        <div class="container-fluid">
            
            {# Messages Flash #}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            {# Card principal #}
            <div class="card">
                <div class="card-header">
                    <div class="row align-items-center">
                        <div class="col-md-8">
                            <div class="row g-2">
                                {# Recherche #}
                                <div class="col-md-6">
                                    <input type="text" 
                                           class="form-control form-control-sm" 
                                           id="searchInput" 
                                           placeholder="🔍 Rechercher un logement..."
                                           value="{{ app.request.query.get('search') }}">
                                </div>
                                
                                {# Catégorie #}
                                <div class="col-md-4">
                                    <select class="form-select form-select-sm" id="categorieSelect">
                                        <option value="">📂 Toutes les catégories</option>
                                        {% for cat in categories %}
                                            <option value="{{ cat.id }}" 
                                                {% if app.request.query.get('categorie') == cat.id %}selected{% endif %}>
                                                {{ cat.nom }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                                
                                {# Reset #}
                                <div class="col-md-2">
                                    <a href="{{ path('admin_logement_list') }}" 
                                       class="btn btn-outline-secondary btn-sm w-100">
                                        ↻ Reset
                                    </a>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-4 text-end">
                            <a href="{{ path('admin_logement_add') }}" class="btn btn-success btn-sm">
                                <i class="bi bi-plus-circle"></i> Ajouter
                            </a>
                        </div>
                    </div>
                </div>
                
                <div class="card-body p-0">
                    <table class="table table-striped table-hover mb-0">
                        <thead>
                            <tr>
                                <th style="width: 10px">#</th>
                                <th style="width: 70px">Photo</th>
                                <th>Titre</th>
                                <th style="width: 120px">Catégorie</th>
                                <th style="width: 150px">Adresse</th>
                                <th style="width: 100px">Prix</th>
                                <th style="width: 80px" class="text-center">Chambres</th>
                                <th style="width: 120px" class="text-center">Statut</th>
                                <th style="width: 150px" class="text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% if logements is empty %}
                                <tr>
                                    <td colspan="9" class="text-center py-5">
                                        <i class="bi bi-inbox fs-1 text-muted"></i>
                                        <p class="text-muted mt-2">Aucun logement trouvé</p>
                                    </td>
                                </tr>
                            {% else %}
                                {% for logement in logements %}
                                    <tr class="align-middle">
                                        <td class="text-muted">{{ logement.id }}</td>
                                        
                                        <td>
                                            {% if logement.photoPrincipale %}
                                                <img src="{{ asset('uploads/logements/' ~ logement.photoPrincipale) }}" 
                                                     class="rounded" 
                                                     style="width: 50px; height: 50px; object-fit: cover;">
                                            {% else %}
                                                <div class="bg-light rounded d-flex align-items-center justify-content-center" 
                                                     style="width: 50px; height: 50px;">
                                                    <i class="bi bi-image text-muted"></i>
                                                </div>
                                            {% endif %}
                                        </td>
                                        
                                        <td>
                                            <strong>{{ logement.titre }}</strong>
                                            {% if logement.description %}
                                                <br><small class="text-muted">{{ logement.description|slice(0, 40) }}...</small>
                                            {% endif %}
                                        </td>
                                        
                                        <td>
                                            <span class="badge bg-info">
                                                {{ logement.categorie ? logement.categorie.nom : 'N/A' }}
                                            </span>
                                        </td>
                                        
                                        <td>
                                            {% if logement.adresse %}
                                                <small>{{ logement.adresse.ville }}, {{ logement.adresse.codePostal }}</small>
                                            {% else %}
                                                <small class="text-muted">-</small>
                                            {% endif %}
                                        </td>
                                        
                                        <td><strong class="text-success">{{ logement.prix|number_format(0) }}€</strong></td>
                                        
                                        <td class="text-center">
                                            <span class="badge bg-light text-dark">{{ logement.nombreChambres }}</span>
                                        </td>
                                        
                                        <td class="text-center">
                                            {% if logement.disponible %}
                                                <span class="badge bg-success">Disponible</span>
                                            {% else %}
                                                <span class="badge bg-danger">Indisponible</span>
                                            {% endif %}
                                        </td>
                                        
                                        <td class="text-center">
                                            <div class="btn-group btn-group-sm">
                                                <a href="{{ path('admin_logement_details', {id: logement.id}) }}" 
                                                   class="btn btn-info btn-sm">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a href="{{ path('admin_logement_edit', {id: logement.id}) }}" 
                                                   class="btn btn-warning btn-sm">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a href="{{ path('admin_logement_delete', {id: logement.id}) }}" 
                                                   class="btn btn-danger btn-sm"
                                                   onclick="return confirm('Supprimer ?')">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                {% endfor %}
                            {% endif %}
                        </tbody>
                    </table>
                </div>
                
                <div class="card-footer">
                    <strong>{{ logements|length }}</strong> logement(s) trouvé(s)
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Filtrage simple
        let timer;
        
        // Recherche (500ms après frappe)
        document.getElementById('searchInput').addEventListener('input', function() {
            clearTimeout(timer);
            timer = setTimeout(() => {
                filter();
            }, 500);
        });
        
        // Catégorie (immédiat)
        document.getElementById('categorieSelect').addEventListener('change', function() {
            filter();
        });
        
        // Fonction de filtrage
        function filter() {
            const search = document.getElementById('searchInput').value;
            const categorie = document.getElementById('categorieSelect').value;
            
            let url = "{{ path('admin_logement_list') }}?";
            
            if (search) url += 'search=' + search + '&';
            if (categorie) url += 'categorie=' + categorie;
            
            window.location.href = url;
        }
    </script>
{% endblock %}

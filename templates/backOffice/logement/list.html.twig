{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Liste des logements{% endblock %}

{% block admin_content %}
    {# App Content Header #}
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Liste des logements</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="#">Logements</a></li>
                        <li class="breadcrumb-item active">Liste</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    {# App Content #}
    <div class="app-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-12">
                    
                    {# Messages Flash #}
                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            {{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    {# Card avec le tableau #}
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title">Tous les logements</h3>
                            <div class="card-tools">
                                <a href="{{ path('admin_logement_add') }}" class="btn btn-primary btn-sm">
                                    <i class="bi bi-plus-circle"></i> Ajouter un logement
                                </a>
                            </div>
                        </div>
                        
                        <div class="card-body p-0">
                            <table class="table table-striped table-hover">
                                <thead>
                                    <tr>
                                        <th style="width: 10px">#</th>
                                        <th>Photo</th>
                                        <th>Titre</th>
                                        <th>Catégorie</th>
                                        <th>Adresse</th>
                                        <th>Prix/nuit</th>
                                        <th style="width: 80px">Chambres</th>
                                        <th style="width: 80px">Surface</th>
                                        <th style="width: 120px">Disponibilité</th>
                                        <th style="width: 150px">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% if logements is empty %}
                                        <tr>
                                            <td colspan="10" class="text-center py-4">
                                                <i class="bi bi-inbox fs-1 text-muted"></i>
                                                <p class="text-muted mt-2">Aucun logement disponible</p>
                                                <a href="{{ path('admin_logement_add') }}" class="btn btn-primary btn-sm">
                                                    <i class="bi bi-plus-circle"></i> Ajouter votre premier logement
                                                </a>
                                            </td>
                                        </tr>
                                    {% else %}
                                        {% for logement in logements %}
                                            <tr class="align-middle">
                                                <td>{{ logement.id }}</td>
                                                
                                                {# Photo #}
                                                <td>
                                                    {% if logement.photoPrincipale %}
                                                        <img src="{{ asset('uploads/logements/' ~ logement.photoPrincipale) }}" 
                                                             alt="{{ logement.titre }}" 
                                                             class="img-thumbnail"
                                                             style="width: 60px; height: 60px; object-fit: cover;">
                                                    {% else %}
                                                        <div class="bg-secondary text-white d-flex align-items-center justify-content-center" 
                                                             style="width: 60px; height: 60px;">
                                                            <i class="bi bi-image fs-4"></i>
                                                        </div>
                                                    {% endif %}
                                                </td>
                                                
                                                {# Titre #}
                                                <td>
                                                    <strong>{{ logement.titre }}</strong>
                                                    {% if logement.description %}
                                                        <br>
                                                        <small class="text-muted">
                                                            {{ logement.description|length > 50 ? logement.description|slice(0, 50) ~ '...' : logement.description }}
                                                        </small>
                                                    {% endif %}
                                                </td>
                                                
                                                {# Catégorie #}
                                                <td>
                                                    <span class="badge text-bg-info">
                                                        {{ logement.categorie ? logement.categorie.nom : 'N/A' }}
                                                    </span>
                                                </td>
                                                
                                                {# Adresse #}
                                                <td>
                                                    {% if logement.adresse %}
                                                        <small>
                                                            {{ logement.adresse.ville }}, 
                                                            {{ logement.adresse.codePostal }}
                                                        </small>
                                                    {% else %}
                                                        <small class="text-muted">Non renseignée</small>
                                                    {% endif %}
                                                </td>
                                                
                                                {# Prix #}
                                                <td>
                                                    <strong class="text-success">{{ logement.prix|number_format(2, ',', ' ') }} €</strong>
                                                </td>
                                                
                                                {# Chambres #}
                                                <td class="text-center">
                                                    <i class="bi bi-door-closed"></i> {{ logement.nombreChambres }}
                                                </td>
                                                
                                                {# Surface #}
                                                <td class="text-center">
                                                    {{ logement.superficie }} m²
                                                </td>
                                                
                                                {# Disponibilité #}
                                                <td>
                                                    {% if logement.disponible %}
                                                        <span class="badge text-bg-success">
                                                            <i class="bi bi-check-circle"></i> Disponible
                                                        </span>
                                                    {% else %}
                                                        <span class="badge text-bg-danger">
                                                            <i class="bi bi-x-circle"></i> Indisponible
                                                        </span>
                                                    {% endif %}
                                                </td>
                                                
                                                {# Actions #}
                                                <td>
                                                    <div class="btn-group btn-group-sm" role="group">
                                                        <a href="{{ path('admin_logement_details', {id: logement.id}) }}" 
                                                        class="btn btn-info" 
                                                        title="Voir">
                                                            <i class="bi bi-eye"></i>
                                                        </a>
                                                        <a href="{{ path('admin_logement_edit', {id: logement.id}) }}" 
                                                           class="btn btn-warning" 
                                                           title="Modifier">
                                                            <i class="bi bi-pencil"></i>
                                                        </a>
                                                        <a href="{{ path('admin_logement_delete', {id: logement.id}) }}" 
                                                           class="btn btn-danger" 
                                                           title="Supprimer"
                                                           onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce logement ? Cette action est irréversible et supprimera également toutes les photos associées.')">
                                                            <i class="bi bi-trash"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    {% endif %}
                                </tbody>
                            </table>
                        </div>
                        
                        {# Footer avec statistiques #}
                        <div class="card-footer clearfix">
                            <div class="float-start">
                                <strong>Total : {{ logements|length }} logement(s)</strong>
                            </div>
                            <div class="float-end">
                                {# Vous pourrez ajouter une pagination ici plus tard #}
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
{% endblock %}

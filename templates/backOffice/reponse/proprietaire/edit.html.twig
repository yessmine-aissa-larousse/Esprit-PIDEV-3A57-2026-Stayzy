{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Modifier Réponse{% endblock %}

{% block admin_content %}

<div class="app-content-header">
    <div class="container-fluid">
        <h3 class="mb-3">Modifier la Réponse #{{ reponse.id }}</h3>
    </div>
</div>

<div class="app-content">
    <div class="container-fluid">

        <div class="card shadow">
            <div class="card-header bg-primary text-white">
                <h3 class="card-title mb-0">Modification</h3>
            </div>

            <div class="card-body">

                {{ form_start(form) }}

                <div class="mb-3">
                    {{ form_label(form.contenu, 'Contenu de la réponse') }}
                    {{ form_widget(form.contenu, {'attr': {'class': 'form-control'}}) }}
                    <div class="text-danger small">
                        {{ form_errors(form.contenu) }}
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle"></i> Enregistrer
                    </button>

                    {# 🔥 SOLUTION DEFINITIVE — يرجع لنفس الصفحة السابقة #}
                    <a href="{{ app.request.headers.get('referer') }}" class="btn btn-secondary">
                        <i class="bi bi-arrow-left"></i> Retour
                    </a>
                </div>

                {{ form_end(form) }}

            </div>
        </div>

    </div>
</div>

{% endblock %}

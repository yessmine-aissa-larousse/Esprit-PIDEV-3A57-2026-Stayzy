{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Répondre à la réclamation{% endblock %}

{% block admin_content %}

<div class="container-fluid mt-4">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="card card-primary card-outline shadow-sm">

                <div class="card-header">
                    <h3 class="card-title">Répondre à la réclamation #{{ reclamation.id }}</h3>
                </div>

                <div class="card-body">

                    <div class="p-3 mb-4 bg-light rounded border">
                        <p class="mb-1 fw-semibold">{{ reclamation.sujet }}</p>
                        <p class="mb-2 text-muted" style="white-space:pre-wrap;">{{ reclamation.description }}</p>
                        <div class="d-flex gap-1">
                            <select id="lang-rec-admin-new" class="form-select form-select-sm" style="width:100px;">
                                <option value="en">English</option>
                                <option value="fr">Français</option>
                                <option value="ar">العربية</option>
                                <option value="de">Deutsch</option>
                                <option value="es">Español</option>
                            </select>
                            <button type="button" class="btn btn-sm btn-outline-info"
                                    onclick="translateText('/reclamation/api/{{ reclamation.id }}/translate?lang='+document.getElementById('lang-rec-admin-new').value,'Description réclamation')">
                                🌍 Traduire
                            </button>
                        </div>
                    </div>

                    {{ form_start(form) }}

                    <div class="mb-3">
                        <label class="form-label fw-semibold">
                            Votre réponse
                        </label>

                        {{ form_widget(form.contenu, {
                            'attr': {
                                'class': 'form-control',
                                'rows': 6,
                                'placeholder': 'Écrire votre réponse ici...'
                            }
                        }) }}

                        <div class="text-danger small mt-1">
                            {{ form_errors(form.contenu) }}
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">

                        <a href="{{ path('admin_reclamations') }}"
                           class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left"></i>
                            Annuler
                        </a>

                        <button class="btn btn-success px-4">
                            <i class="bi bi-send"></i>
                            Envoyer la réponse
                        </button>

                    </div>

                    {{ form_end(form) }}

                </div>

            </div>

        </div>
    </div>

</div>

{{ include('_translate_modal.html.twig') }}
{% endblock %}
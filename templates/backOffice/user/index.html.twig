{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <!-- En-tête -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="h3 mb-0"><i class="bi bi-people"></i> Gestion des Utilisateurs</h1>
        <div>
            <a href="{{ path('app_user_pending') }}" class="btn btn-warning">
                <i class="bi bi-clock-history"></i> Demandes en attente
            </a>
            <a href="{{ path('app_user_export_csv') }}" class="btn btn-success">
                <i class="bi bi-file-earmark-spreadsheet"></i> Exporter CSV
            </a>
            <a href="{{ path('app_user_new') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Ajouter
            </a>
        </div>
    </div>

    <!-- Filtres (inchangé) -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-funnel"></i> Filtres de recherche</h5>
        </div>
        <div class="card-body">
            <form method="get" action="{{ path('app_user_index') }}" class="row g-3">
                <div class="col-md-6">
                    <input type="text" name="search" class="form-control" 
                           placeholder="Rechercher par nom, prénom, email, téléphone..." 
                           value="{{ search }}">
                </div>
                <div class="col-md-4">
                    <select name="role" class="form-select">
                        <option value="">Tous les rôles</option>
                        <option value="ROLE_CLIENT" {{ role == 'ROLE_CLIENT' ? 'selected' : '' }}>Client</option>
                        <option value="ROLE_PROPRIETAIRE" {{ role == 'ROLE_PROPRIETAIRE' ? 'selected' : '' }}>Propriétaire</option>
                        <option value="ROLE_ADMIN" {{ role == 'ROLE_ADMIN' ? 'selected' : '' }}>Administrateur</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-search"></i> Rechercher
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Tableau -->
    <div class="card shadow-sm">
        <div class="card-body">
            {% if users|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover">
                        <thead class="table-dark">
                            <tr>
                                <th>ID</th>
                                <th>Email</th>
                                <th>Nom</th>
                                <th>Prénom</th>
                                <th>Téléphone</th>
                                <th>Rôle(s)</th>
                                <th>Approbation</th>   <!-- Nouvelle colonne -->
                                <th>Statut</th>
                                <th>Créé le</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for user in users %}
                            <tr>
                                <td>{{ user.id }}</td>
                                <td>{{ user.email }}</td>
                                <td>{{ user.nom }}</td>
                                <td>{{ user.prenom }}</td>
                                <td>{{ user.tel ?? '-' }}</td>
                                <td>
                                    {% for role in user.getRoleNames() %}
                                        <span class="badge bg-{{ 
                                            role == 'ADMIN' ? 'danger' : 
                                            role == 'PROPRIETAIRE' ? 'warning' : 
                                            'info' 
                                        }}">
                                            {{ role }}
                                        </span>
                                    {% endfor %}
                                </td>
                                <td>
                                    {% if 'PROPRIETAIRE' in user.getRoleNames() %}
                                        <span class="badge bg-{{
                                            user.approvalStatus == 'approved' ? 'success' :
                                            user.approvalStatus == 'pending' ? 'warning' :
                                            user.approvalStatus == 'rejected' ? 'danger' : 'secondary'
                                        }}">
                                            {{ user.approvalStatusLabel }}
                                        </span>
                                    {% else %}
                                        <span class="text-muted">—</span>
                                    {% endif %}
                                </td>
                                <td>
                                    <span class="badge bg-{{ user.isActive ? 'success' : 'secondary' }}">
                                        {{ user.isActive ? 'Actif' : 'Inactif' }}
                                    </span>
                                </td>
                                <td>{{ user.createdAt|date('d/m/Y H:i') }}</td>
                                <td>
                                    <div class="btn-group btn-group-sm" role="group">
                                        <!-- Activer/Désactiver -->
                                        <form action="{{ path('app_user_toggle_status', {'id': user.id}) }}" method="post">
                                            <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ user.id) }}">
                                            <button type="submit" class="btn btn-{{ user.isActive ? 'warning' : 'success' }}" 
                                                    title="{{ user.isActive ? 'Désactiver' : 'Activer' }}">
                                                <i class="bi bi-{{ user.isActive ? 'lock' : 'unlock' }}"></i>
                                            </button>
                                        </form>
                                        <!-- Modifier -->
                                        <a href="{{ path('app_user_edit', {'id': user.id}) }}" 
                                           class="btn btn-info" title="Modifier">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <!-- Supprimer -->
                                        <form action="{{ path('app_user_delete', {'id': user.id}) }}" method="post">
                                            <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                            <button type="submit" class="btn btn-danger" 
                                                    onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur?')"
                                                    title="Supprimer">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                <div class="mt-3 text-muted">
                    <small><i class="bi bi-info-circle"></i> Total: {{ users|length }} utilisateur(s)</small>
                </div>
            {% else %}
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-people" style="font-size: 4rem; color: #6c757d;"></i>
                    </div>
                    <h4>Aucun utilisateur trouvé</h4>
                    <p class="text-muted">Commencez par ajouter un utilisateur</p>
                    <a href="{{ path('app_user_new') }}" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Ajouter le premier utilisateur
                    </a>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
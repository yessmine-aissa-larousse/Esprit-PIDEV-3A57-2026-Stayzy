{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Gestion Utilisateurs - Stayzy{% endblock %}

{% block admin_content %}
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0"><i class="bi bi-people-fill"></i> Gestion des Utilisateurs</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
                        <li class="breadcrumb-item active">Utilisateurs</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="app-content">
        <div class="container-fluid">
            {# Actions et Recherche #}
            <div class="row mb-3">
                <div class="col-md-6">
                    <a href="{{ path('app_user_new') }}" class="btn btn-primary">
                        <i class="bi bi-plus-circle"></i> Ajouter un utilisateur
                    </a>
                    <a href="{{ path('app_user_pending') }}" class="btn btn-warning">
                        <i class="bi bi-clock-history"></i> Demandes en attente
                    </a>
                    <a href="{{ path('app_user_export_csv') }}" class="btn btn-secondary">
                        <i class="bi bi-download"></i> Exporter CSV
                    </a>
                </div>
                <div class="col-md-6">
                    <form method="get" class="d-flex gap-2">
                        <input type="text" name="search" class="form-control" 
                               placeholder="Rechercher..." value="{{ search|default('') }}">
                        <select name="role" class="form-select" style="max-width: 200px;">
                            <option value="">Tous les rôles</option>
                            <option value="ROLE_CLIENT" {{ role|default('') == 'ROLE_CLIENT' ? 'selected' : '' }}>Clients</option>
                            <option value="ROLE_PROPRIETAIRE" {{ role|default('') == 'ROLE_PROPRIETAIRE' ? 'selected' : '' }}>Propriétaires</option>
                            <option value="ROLE_ADMIN" {{ role|default('') == 'ROLE_ADMIN' ? 'selected' : '' }}>Admins</option>
                        </select>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>
                </div>
            </div>

            {# Table #}
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">Liste des utilisateurs ({{ users|length }})</h3>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover mb-0">
                            <thead>
                                <tr>
                                    <th style="width: 50px;">ID</th>
                                    <th>Nom complet</th>
                                    <th>Email</th>
                                    <th>Rôle</th>
                                    <th>Téléphone</th>
                                    <th>Statut</th>
                                    <th>Date création</th>
                                    <th style="width: 200px;">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% if users|length == 0 %}
                                    <tr>
                                        <td colspan="8" class="text-center py-4">
                                            <i class="bi bi-inbox" style="font-size: 3rem; color: #ccc;"></i>
                                            <p class="text-muted mt-2">Aucun utilisateur trouvé</p>
                                        </td>
                                    </tr>
                                {% else %}
                                    {% for user in users %}
                                        <tr>
                                            <td>{{ user.id }}</td>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    {% if user.imageUrl %}
                                                        <img src="{{ user.imageUrl }}" class="rounded-circle me-2" style="width: 32px; height: 32px;">
                                                    {% else %}
                                                        <i class="bi bi-person-circle me-2" style="font-size: 32px; color: #ccc;"></i>
                                                    {% endif %}
                                                    <strong>{{ user.prenom }} {{ user.nom }}</strong>
                                                </div>
                                            </td>
                                            <td>{{ user.email }}</td>
                                            <td>
                                                {% for roleName in user.roleNames %}
                                                    <span class="badge bg-{{ roleName == 'ADMIN' ? 'danger' : (roleName == 'PROPRIETAIRE' ? 'info' : 'primary') }}">
                                                        {{ roleName }}
                                                    </span>
                                                {% endfor %}
                                            </td>
                                            <td>{{ user.tel ?? '-' }}</td>
                                            <td>
                                                {% if user.isActive %}
                                                    <span class="badge bg-success">Actif</span>
                                                {% else %}
                                                    <span class="badge bg-danger">Inactif</span>
                                                {% endif %}
                                                
                                                {% if user.isProprietaire %}
                                                    <br>
                                                    {% if user.isPending %}
                                                        <span class="badge bg-warning mt-1">En attente</span>
                                                    {% elseif user.isApproved %}
                                                        <span class="badge bg-success mt-1">Approuvé</span>
                                                    {% elseif user.isRejected %}
                                                        <span class="badge bg-danger mt-1">Rejeté</span>
                                                    {% endif %}
                                                {% endif %}
                                            </td>
                                            <td>{{ user.createdAt|date('d/m/Y') }}</td>
                                            <td>
                                                <div class="btn-group btn-group-sm" role="group">
                                                    <a href="{{ path('app_user_show', {id: user.id}) }}" 
                                                       class="btn btn-info" 
                                                       title="Voir"
                                                       data-bs-toggle="tooltip">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                    <a href="{{ path('app_user_edit', {id: user.id}) }}" 
                                                       class="btn btn-warning" 
                                                       title="Modifier"
                                                       data-bs-toggle="tooltip">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                    
                                                    <form action="{{ path('app_user_toggle_status', {id: user.id}) }}" 
                                                          method="post" 
                                                          style="display:inline;">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ user.id) }}">
                                                        <button type="submit" 
                                                                class="btn btn-{{ user.isActive ? 'secondary' : 'success' }}" 
                                                                title="{{ user.isActive ? 'Désactiver' : 'Activer' }}"
                                                                data-bs-toggle="tooltip">
                                                            <i class="bi bi-{{ user.isActive ? 'x-circle' : 'check-circle' }}"></i>
                                                        </button>
                                                    </form>

                                                    <form action="{{ path('app_user_delete', {id: user.id}) }}" 
                                                          method="post" 
                                                          onsubmit="return confirm('Êtes-vous sûr de vouloir supprimer cet utilisateur ?');" 
                                                          style="display:inline;">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                                                        <button type="submit" 
                                                                class="btn btn-danger" 
                                                                title="Supprimer"
                                                                data-bs-toggle="tooltip">
                                                            <i class="bi bi-trash"></i>
                                                        </button>
                                                    </form>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                {% endif %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

{% block javascripts %}
    {{ parent() }}
    <script>
        // Initialize Bootstrap tooltips
        var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'))
        var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
            return new bootstrap.Tooltip(tooltipTriggerEl)
        })
    </script>
{% endblock %}
{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Ajouter un utilisateur - Stayzy{% endblock %}

{% block admin_content %}
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0"><i class="bi bi-plus-circle"></i> Ajouter un utilisateur</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('app_user_index') }}">Utilisateurs</a></li>
                        <li class="breadcrumb-item active">Ajouter</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="app-content">
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-10 offset-md-1">
                    <div class="card">
                        <div class="card-header">
                            <h3 class="card-title"><i class="bi bi-person-plus"></i> Formulaire d'ajout d'utilisateur</h3>
                        </div>
                        <div class="card-body">
                            {{ form_start(form) }}
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            {{ form_label(form.nom, 'Nom', {'label_attr': {'class': 'form-label'}}) }}
                                            {{ form_widget(form.nom, {'attr': {'class': 'form-control'}}) }}
                                            {{ form_errors(form.nom) }}
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            {{ form_label(form.prenom, 'Prénom', {'label_attr': {'class': 'form-label'}}) }}
                                            {{ form_widget(form.prenom, {'attr': {'class': 'form-control'}}) }}
                                            {{ form_errors(form.prenom) }}
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            {{ form_label(form.email, 'Email', {'label_attr': {'class': 'form-label'}}) }}
                                            {{ form_widget(form.email, {'attr': {'class': 'form-control'}}) }}
                                            {{ form_errors(form.email) }}
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            {{ form_label(form.password, 'Mot de passe', {'label_attr': {'class': 'form-label'}}) }}
                                            {{ form_widget(form.password, {'attr': {'class': 'form-control'}}) }}
                                            {{ form_errors(form.password) }}
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            {{ form_label(form.tel, 'Téléphone', {'label_attr': {'class': 'form-label'}}) }}
                                            {{ form_widget(form.tel, {'attr': {'class': 'form-control'}}) }}
                                            {{ form_errors(form.tel) }}
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            {{ form_label(form.roles, 'Rôle', {'label_attr': {'class': 'form-label'}}) }}
                                            {{ form_widget(form.roles, {'attr': {'class': 'form-select'}}) }}
                                            {{ form_errors(form.roles) }}
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    {{ form_label(form.adresse, 'Adresse', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.adresse, {'attr': {'class': 'form-control'}}) }}
                                    {{ form_errors(form.adresse) }}
                                </div>

                                <div class="mb-3">
                                    {{ form_label(form.imageUrl, 'URL Image de profil', {'label_attr': {'class': 'form-label'}}) }}
                                    {{ form_widget(form.imageUrl, {'attr': {'class': 'form-control', 'placeholder': 'https://...'}}) }}
                                    {{ form_errors(form.imageUrl) }}
                                </div>

                                <div class="mb-3">
                                    <div class="form-check form-switch">
                                        {{ form_widget(form.isActive, {'attr': {'class': 'form-check-input', 'role': 'switch'}}) }}
                                        {{ form_label(form.isActive, 'Compte actif', {'label_attr': {'class': 'form-check-label'}}) }}
                                    </div>
                                </div>

                                <div class="mt-4 d-flex gap-2">
                                    <button type="submit" class="btn btn-primary">
                                        <i class="bi bi-save"></i> Enregistrer
                                    </button>
                                    <a href="{{ path('app_user_index') }}" class="btn btn-secondary">
                                        <i class="bi bi-x-circle"></i> Annuler
                                    </a>
                                </div>
                            {{ form_end(form) }}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
{% endblock %}
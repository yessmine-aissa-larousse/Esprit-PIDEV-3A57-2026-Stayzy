{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Demandes en attente - Stayzy{% endblock %}

{% block admin_content %}
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0"><i class="bi bi-clock-history"></i> Demandes d'inscription Propriétaires</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('app_user_index') }}">Utilisateurs</a></li>
                        <li class="breadcrumb-item active">Demandes</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="app-content">
        <div class="container-fluid">
            <div class="mb-3">
                <a href="{{ path('app_user_index') }}" class="btn btn-secondary">
                    <i class="bi bi-arrow-left"></i> Retour à la liste
                </a>
            </div>

            {% if users|length == 0 %}
                <div class="card">
                    <div class="card-body text-center py-5">
                        <i class="bi bi-check-circle text-success" style="font-size: 5rem;"></i>
                        <h4 class="mt-3">Aucune demande en attente</h4>
                        <p class="text-muted">Toutes les demandes ont été traitées.</p>
                    </div>
                </div>
            {% else %}
                <div class="card">
                    <div class="card-header bg-warning">
                        <h3 class="card-title text-dark">
                            <i class="bi bi-exclamation-triangle"></i> 
                            {{ users|length }} demande(s) en attente de validation
                        </h3>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover mb-0">
                                <thead>
                                    <tr>
                                        <th style="width: 50px;">ID</th>
                                        <th>Nom complet</th>
                                        <th>Email</th>
                                        <th>Téléphone</th>
                                        <th>Adresse</th>
                                        <th>Date demande</th>
                                        <th style="width: 320px;">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    {% for user in users %}
                                        <tr>
                                            <td>{{ user.id }}</td>
                                            <td>
                                                <strong>{{ user.prenom }} {{ user.nom }}</strong>
                                            </td>
                                            <td>{{ user.email }}</td>
                                            <td>{{ user.tel ?? '-' }}</td>
                                            <td>{{ user.adresse ?? '-' }}</td>
                                            <td>
                                                {{ user.createdAt|date('d/m/Y') }}<br>
                                                <small class="text-muted">{{ user.createdAt|date('H:i') }}</small>
                                            </td>
                                            <td>
                                                <div class="d-flex gap-2">
                                                    <form action="{{ path('app_user_approve', {id: user.id}) }}" 
                                                          method="post" 
                                                          style="flex: 1;">
                                                        <input type="hidden" name="_token" 
                                                               value="{{ csrf_token('approve' ~ user.id) }}">
                                                        <button type="submit" 
                                                                class="btn btn-success btn-sm w-100"
                                                                onclick="return confirm('Approuver cette demande ?');">
                                                            <i class="bi bi-check-circle"></i> Approuver
                                                        </button>
                                                    </form>
                                                    
                                                    <div style="flex: 1.5;">
                                                        <form action="{{ path('app_user_reject', {id: user.id}) }}" 
                                                              method="post"
                                                              onsubmit="return confirm('Rejeter cette demande ?');">
                                                            <input type="hidden" name="_token" 
                                                                   value="{{ csrf_token('reject' ~ user.id) }}">
                                                            <div class="input-group input-group-sm">
                                                                <input type="text" 
                                                                       name="rejection_reason" 
                                                                       class="form-control form-control-sm" 
                                                                       placeholder="Motif (optionnel)">
                                                                <button type="submit" class="btn btn-danger btn-sm">
                                                                    <i class="bi bi-x-circle"></i> Rejeter
                                                                </button>
                                                            </div>
                                                        </form>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
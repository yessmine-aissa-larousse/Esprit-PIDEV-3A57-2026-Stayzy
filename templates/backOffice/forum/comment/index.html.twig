{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Commentaires - Forum{% endblock %}

{% block admin_content %}
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Gestion des commentaires</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="#">Forum</a></li>
                        <li class="breadcrumb-item active">Commentaires</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="app-content">
        <div class="container-fluid">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="card-title mb-0">Liste des commentaires ({{ total }}){% if filter_post_id %} pour ce post{% endif %}</h5>
                    <form method="get" class="d-flex gap-1">
                        {% if filter_post_id %}
                            <input type="hidden" name="post_id" value="{{ filter_post_id }}">
                        {% endif %}
                        <input type="text" name="q" value="{{ search|default('') }}" class="form-control form-control-sm" placeholder="Rechercher..." style="width: 180px;">
                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search"></i></button>
                    </form>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Post</th>
                                    <th>Auteur</th>
                                    <th>Contenu</th>
                                    <th><i class="bi bi-hand-thumbs-up text-success"></i></th>
                                    <th><i class="bi bi-hand-thumbs-down text-danger"></i></th>
                                    <th>Date</th>
                                    <th width="120">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for comment in comments %}
                                    <tr>
                                        <td>{{ comment.id }}</td>
                                        <td>
                                            <a href="{{ path('admin_post_show', {id: comment.post.id}) }}">{{ comment.post.title|length > 30 ? comment.post.title|slice(0, 30) ~ '...' : comment.post.title }}</a>
                                        </td>
                                        <td>{{ comment.author }}</td>
                                        <td>{{ comment.content|length > 60 ? comment.content|slice(0, 60) ~ '...' : comment.content }}</td>
                                        <td>{{ comment.avisCount }}</td>
                                        <td>{{ comment.dislikeCount }}</td>
                                        <td>{{ comment.createdAt|date('d/m/Y H:i') }}</td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <a href="{{ path('admin_comment_show', {id: comment.id}) }}" class="btn btn-outline-info" title="Voir">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <form method="post" action="{{ path('admin_comment_delete', {id: comment.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce commentaire ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                                                    <button type="submit" class="btn btn-outline-danger" title="Supprimer">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="8" class="text-center py-4 text-muted">Aucun commentaire.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                {% if total_pages > 1 %}
                <div class="card-footer">
                    <nav>
                        <ul class="pagination pagination-sm mb-0 justify-content-center">
                            <li class="page-item {{ current_page <= 1 ? 'disabled' : '' }}">
                                {% set prev_params = {page: current_page - 1} %}
                                {% if filter_post_id %}{% set prev_params = prev_params|merge({post_id: filter_post_id}) %}{% endif %}
                                {% if search %}{% set prev_params = prev_params|merge({q: search}) %}{% endif %}
                                <a class="page-link" href="{{ path('admin_comment_index', prev_params) }}">«</a>
                            </li>
                            {% for p in 1..total_pages %}
                                <li class="page-item {{ p == current_page ? 'active' : '' }}">
                                    {% set pagination_params = {page: p} %}
                                    {% if filter_post_id %}{% set pagination_params = pagination_params|merge({post_id: filter_post_id}) %}{% endif %}
                                    {% if search %}{% set pagination_params = pagination_params|merge({q: search}) %}{% endif %}
                                    <a class="page-link" href="{{ path('admin_comment_index', pagination_params) }}">{{ p }}</a>
                                </li>
                            {% endfor %}
                            <li class="page-item {{ current_page >= total_pages ? 'disabled' : '' }}">
                                {% set pagination_params = {page: current_page + 1} %}
                                {% if filter_post_id %}{% set pagination_params = pagination_params|merge({post_id: filter_post_id}) %}{% endif %}
                                {% if search %}{% set pagination_params = pagination_params|merge({q: search}) %}{% endif %}
                                <a class="page-link" href="{{ path('admin_comment_index', pagination_params) }}">»</a>
                            </li>
                        </ul>
                    </nav>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Commentaires - Forum{% endblock %}

{% block admin_content %}
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Gestion des commentaires{% if filter_post %} – Post « {{ filter_post.title|length > 40 ? filter_post.title|slice(0, 40) ~ '...' : filter_post.title }} »{% endif %} ({{ total }})</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="#">Forum</a></li>
                        <li class="breadcrumb-item active">Commentaires</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="app-content">
        <div class="container-fluid">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            {% if filter_post %}
                <div class="alert alert-info mb-3">
                    <a href="{{ path('admin_comment_index') }}" class="alert-link">← Voir tous les commentaires</a>
                </div>
            {% endif %}

            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Liste des commentaires ({{ total }})</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Post</th>
                                    <th>Auteur</th>
                                    <th>Contenu</th>
                                    <th>Date</th>
                                    <th width="120">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for comment in comments %}
                                    <tr>
                                        <td>{{ comment.id }}</td>
                                        <td>
                                            <a href="{{ path('admin_post_show', {id: comment.post.id}) }}">{{ comment.post.title|length > 30 ? comment.post.title|slice(0, 30) ~ '...' : comment.post.title }}</a>
                                        </td>
                                        <td>{{ comment.author }}</td>
                                        <td>{{ comment.content|length > 60 ? comment.content|slice(0, 60) ~ '...' : comment.content }}</td>
                                        <td>{{ comment.createdAt|date('d/m/Y H:i') }}</td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <a href="{{ path('admin_comment_edit', {id: comment.id}) }}{% if filter_post %}?post={{ filter_post.id }}{% endif %}" class="btn btn-outline-warning" title="Modifier">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <form method="post" action="{{ path('admin_comment_delete', {id: comment.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce commentaire ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ comment.id) }}">
                                                    {% if filter_post %}<input type="hidden" name="filter_post" value="{{ filter_post.id }}">{% endif %}
                                                    <button type="submit" class="btn btn-outline-danger" title="Supprimer">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="6" class="text-center py-4 text-muted">Aucun commentaire.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                {% if total_pages > 1 %}
                <div class="card-footer">
                    <nav>
                        <ul class="pagination pagination-sm mb-0 justify-content-center">
                            {% set pagination_params = filter_post ? {post: filter_post.id} : {} %}
                            <li class="page-item {{ current_page <= 1 ? 'disabled' : '' }}">
                                <a class="page-link" href="{{ path('admin_comment_index', pagination_params|merge({page: current_page - 1})) }}">«</a>
                            </li>
                            {% for p in 1..total_pages %}
                                <li class="page-item {{ p == current_page ? 'active' : '' }}">
                                    <a class="page-link" href="{{ path('admin_comment_index', pagination_params|merge({page: p})) }}">{{ p }}</a>
                                </li>
                            {% endfor %}
                            <li class="page-item {{ current_page >= total_pages ? 'disabled' : '' }}">
                                <a class="page-link" href="{{ path('admin_comment_index', pagination_params|merge({page: current_page + 1})) }}">»</a>
                            </li>
                        </ul>
                    </nav>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

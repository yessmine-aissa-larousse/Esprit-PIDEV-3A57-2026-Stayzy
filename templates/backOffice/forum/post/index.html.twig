{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Posts - Forum{% endblock %}

{% block admin_content %}
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Gestion des posts</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="#">Forum</a></li>
                        <li class="breadcrumb-item active">Posts</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="app-content">
        <div class="container-fluid">
            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show" role="alert">
                    {{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                </div>
            {% endfor %}

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="card-title mb-0">Liste des posts ({{ total }})</h5>
                    <form method="get" class="d-flex gap-1">
                        <input type="text" name="q" value="{{ search }}" class="form-control form-control-sm" placeholder="Rechercher..." style="width: 180px;">
                        <button type="submit" class="btn btn-sm btn-outline-primary"><i class="bi bi-search"></i></button>
                    </form>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>#</th>
                                    <th>Titre</th>
                                    <th>Auteur</th>
                                    <th>Statut</th>
                                    <th>Commentaires</th>
                                    <th><i class="bi bi-hand-thumbs-up text-success"></i> Likes</th>
                                    <th><i class="bi bi-hand-thumbs-down text-danger"></i> Dislikes</th>
                                    <th>Date</th>
                                    <th width="180">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for post in posts %}
                                    <tr>
                                        <td>{{ post.id }}</td>
                                        <td>
                                            <strong>{{ post.title|length > 50 ? post.title|slice(0, 50) ~ '...' : post.title }}</strong>
                                        </td>
                                        <td>{{ post.author }}</td>
                                        <td>
                                            <span class="badge bg-success">Publié</span>
                                        </td>
                                        <td>
                                            <a href="{{ path('admin_comment_index', {post_id: post.id}) }}" class="text-primary">
                                                {{ post.commentsCount }} <i class="bi bi-chat-dots"></i>
                                            </a>
                                        </td>
                                        <td>{{ post.avisCount }}</td>
                                        <td>{{ post.dislikeCount }}</td>
                                        <td>{{ post.createdAt|date('d/m/Y H:i') }}</td>
                                        <td>
                                            <div class="btn-group btn-group-sm">
                                                <a href="{{ path('forum_post_show', {id: post.id}) }}" class="btn btn-outline-info" title="Voir">
                                                    <i class="bi bi-eye"></i>
                                                </a>
                                                <a href="{{ path('admin_post_edit', {id: post.id}) }}" class="btn btn-outline-warning" title="Modifier">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <form method="post" action="{{ path('admin_post_delete', {id: post.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce post ?');">
                                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ post.id) }}">
                                                    <button type="submit" class="btn btn-outline-danger" title="Supprimer">
                                                        <i class="bi bi-trash"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                {% else %}
                                    <tr>
                                        <td colspan="9" class="text-center py-4 text-muted">Aucun post.</td>
                                    </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
                {% if total_pages > 1 %}
                <div class="card-footer">
                    <nav>
                        <ul class="pagination pagination-sm mb-0 justify-content-center">
                            <li class="page-item {{ current_page <= 1 ? 'disabled' : '' }}">
                                <a class="page-link" href="{{ path('admin_post_index', search ? {page: current_page - 1, q: search} : {page: current_page - 1}) }}">«</a>
                            </li>
                            {% for p in 1..total_pages %}
                                <li class="page-item {{ p == current_page ? 'active' : '' }}">
                                    <a class="page-link" href="{{ path('admin_post_index', search ? {page: p, q: search} : {page: p}) }}">{{ p }}</a>
                                </li>
                            {% endfor %}
                            <li class="page-item {{ current_page >= total_pages ? 'disabled' : '' }}">
                                <a class="page-link" href="{{ path('admin_post_index', search ? {page: current_page + 1, q: search} : {page: current_page + 1}) }}">»</a>
                            </li>
                        </ul>
                    </nav>
                </div>
                {% endif %}
            </div>
        </div>
    </div>
{% endblock %}

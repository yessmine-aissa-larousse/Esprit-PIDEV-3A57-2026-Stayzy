{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}{{ post.title }} - Forum{% endblock %}

{% block admin_content %}
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">{{ post.title }}</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Dashboard</a></li>
                        <li class="breadcrumb-item"><a href="{{ path('admin_post_index') }}">Posts</a></li>
                        <li class="breadcrumb-item active">Détail</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    <div class="app-content">
        <div class="container-fluid">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span class="badge {{ post.isPublished ? 'bg-success' : 'bg-secondary' }}">
                        {{ post.isPublished ? 'Publié' : 'Brouillon' }}
                    </span>
                    <div>
                        <a href="{{ path('admin_post_edit', {id: post.id}) }}" class="btn btn-sm btn-warning">
                            <i class="bi bi-pencil"></i> Modifier
                        </a>
                        <a href="{{ path('forum_post_show', {id: post.id}) }}" class="btn btn-sm btn-info" target="_blank">
                            <i class="bi bi-eye"></i> Voir en public
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    <p><strong>Auteur:</strong> {{ post.author }}</p>
                    <p><strong>Créé le:</strong> {{ post.createdAt|date('d/m/Y H:i') }}</p>
                    {% if post.updatedAt %}
                        <p><strong>Modifié le:</strong> {{ post.updatedAt|date('d/m/Y H:i') }}</p>
                    {% endif %}
                    {% if post.excerpt %}
                        <p class="text-muted">{{ post.excerpt }}</p>
                    {% endif %}
                    <hr>
                    <div>{{ post.content|nl2br }}</div>
                </div>
                <div class="card-footer">
                    <h6>Commentaires ({{ post.commentsCount }})</h6>
                    <a href="{{ path('admin_comment_index') }}?post={{ post.id }}" class="btn btn-sm btn-outline-primary">
                        Gérer les commentaires
                    </a>
                </div>
            </div>
        </div>
    </div>
{% endblock %}

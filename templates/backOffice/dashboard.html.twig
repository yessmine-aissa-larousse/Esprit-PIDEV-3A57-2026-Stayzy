{% extends 'backOffice/base_admin.html.twig' %}

{% block title %}Dashboard Admin - Stayzy{% endblock %}

{% block admin_content %}

    {# App Content Header #}
    <div class="app-content-header">
        <div class="container-fluid">
            <div class="row">
                <div class="col-sm-6">
                    <h3 class="mb-0">Dashboard</h3>
                </div>
                <div class="col-sm-6">
                    <ol class="breadcrumb float-sm-end">
                        <li class="breadcrumb-item"><a href="{{ path('admin_dashboard') }}">Accueil</a></li>
                        <li class="breadcrumb-item active">Dashboard</li>
                    </ol>
                </div>
            </div>
        </div>
    </div>

    {# App Content #}
    <div class="app-content">
        <div class="container-fluid">

            {# ══════════════════════════════════════════ #}
            {# CARTES STATISTIQUES                       #}
            {# ══════════════════════════════════════════ #}
            <div class="row g-3 mb-4">

                {# Total Utilisateurs #}
                <div class="col-xl-3 col-md-6">
                    <div class="card border-0 shadow-sm" style="border-left: 4px solid #2e7d32; border-radius: 12px;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted mb-1" style="font-size: 12px; text-transform: uppercase;">Total Utilisateurs</h6>
                                    <h2 class="fw-bold mb-0" style="color: #2e7d32;">{{ total_users }}</h2>
                                </div>
                                <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; background: #e8f5e9;">
                                    <i class="bi bi-people-fill" style="font-size: 26px; color: #2e7d32;"></i>
                                </div>
                            </div>
                            <div class="mt-3">
                                <span class="badge" style="background: #e8f5e9; color: #2e7d32;">
                                    <i class="bi bi-graph-up me-1"></i> Actifs : {{ active_users }}
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                {# Clients #}
                <div class="col-xl-3 col-md-6">
                    <div class="card border-0 shadow-sm" style="border-left: 4px solid #1565c0; border-radius: 12px;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted mb-1" style="font-size: 12px; text-transform: uppercase;">Clients</h6>
                                    <h2 class="fw-bold mb-0" style="color: #1565c0;">{{ client_count }}</h2>
                                </div>
                                <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; background: #e3f2fd;">
                                    <i class="bi bi-person-circle" style="font-size: 26px; color: #1565c0;"></i>
                                </div>
                            </div>
                            <div class="mt-3">
                                <small class="text-muted">
                                    {% if total_users > 0 %}
                                        {{ ((client_count / total_users) * 100)|number_format(1) }}% du total
                                    {% else %}
                                        0% du total
                                    {% endif %}
                                </small>
                            </div>
                        </div>
                    </div>
                </div>

                {# Propriétaires #}
                <div class="col-xl-3 col-md-6">
                    <div class="card border-0 shadow-sm" style="border-left: 4px solid #f57f17; border-radius: 12px;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted mb-1" style="font-size: 12px; text-transform: uppercase;">Propriétaires</h6>
                                    <h2 class="fw-bold mb-0" style="color: #f57f17;">{{ proprietaire_count }}</h2>
                                </div>
                                <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; background: #fff8e1;">
                                    <i class="bi bi-building" style="font-size: 26px; color: #f57f17;"></i>
                                </div>
                            </div>
                            <div class="mt-3">
                                <span class="badge" style="background: #fff3e0; color: #f57f17;">
                                    <i class="bi bi-clock me-1"></i> En attente : {{ pending_count }}
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                {# Demandes en attente #}
                <div class="col-xl-3 col-md-6">
                    <div class="card border-0 shadow-sm" style="border-left: 4px solid #c62828; border-radius: 12px;">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <h6 class="text-muted mb-1" style="font-size: 12px; text-transform: uppercase;">En Attente</h6>
                                    <h2 class="fw-bold mb-0" style="color: #c62828;">{{ pending_count }}</h2>
                                </div>
                                <div class="rounded-3 d-flex align-items-center justify-content-center" style="width: 56px; height: 56px; background: #ffebee;">
                                    <i class="bi bi-hourglass-split" style="font-size: 26px; color: #c62828;"></i>
                                </div>
                            </div>
                            <div class="mt-3">
                                <a href="{{ path('app_user_pending') }}" class="btn btn-sm btn-outline-danger" style="border-radius: 8px;">
                                    <i class="bi bi-eye me-1"></i> Voir les demandes
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            {# ══════════════════════════════════════════ #}
            {# GRAPHIQUES                                #}
            {# ══════════════════════════════════════════ #}
            <div class="row g-3 mb-4">

                {# Graphique inscriptions par mois #}
                <div class="col-lg-8">
                    <div class="card card-outline card-success">
                        <div class="card-header">
                            <div class="card-title fw-bold">
                                <i class="bi bi-graph-up me-2 text-success"></i>Inscriptions par mois
                            </div>
                        </div>
                        <div class="card-body">
                            <canvas id="monthlyChart" height="100"></canvas>
                        </div>
                    </div>
                </div>

                {# Répartition par rôle #}
                <div class="col-lg-4">
                    <div class="card card-outline card-primary">
                        <div class="card-header">
                            <div class="card-title fw-bold">
                                <i class="bi bi-pie-chart me-2 text-primary"></i>Répartition par rôle
                            </div>
                        </div>
                        <div class="card-body">
                            <canvas id="roleChart"></canvas>
                            <div class="mt-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span><i class="bi bi-circle-fill me-2" style="color: #2e7d32; font-size: 10px;"></i>Clients</span>
                                    <strong>{{ client_count }}</strong>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span><i class="bi bi-circle-fill me-2" style="color: #f57f17; font-size: 10px;"></i>Propriétaires</span>
                                    <strong>{{ proprietaire_count }}</strong>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span><i class="bi bi-circle-fill me-2" style="color: #1565c0; font-size: 10px;"></i>Admins</span>
                                    <strong>{{ admin_count }}</strong>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            {# ══════════════════════════════════════════ #}
            {# TABLEAUX                                  #}
            {# ══════════════════════════════════════════ #}
            <div class="row g-3">

                {# Utilisateurs récents #}
                <div class="col-lg-7">
                    <div class="card card-outline card-success">
                        <div class="card-header">
                            <div class="card-title fw-bold">
                                <i class="bi bi-person-plus me-2 text-success"></i>Utilisateurs récents
                            </div>
                            <div class="card-tools">
                                <a href="{{ path('app_user_index') }}" class="btn btn-sm btn-outline-success">Voir tout</a>
                            </div>
                        </div>
                        <div class="card-body p-0">
                            <div class="table-responsive">
                                <table class="table table-hover align-middle mb-0">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="ps-3">Utilisateur</th>
                                            <th>Rôle</th>
                                            <th>Date</th>
                                            <th>Statut</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {% for user in recent_users %}
                                        <tr>
                                            <td class="ps-3">
                                                <div class="d-flex align-items-center gap-2">
                                                    {% if user.profilePicture %}
                                                        <img src="{{ asset('uploads/profiles/' ~ user.profilePicture) }}"
                                                             class="rounded-circle"
                                                             style="width: 36px; height: 36px; object-fit: cover;">
                                                    {% else %}
                                                        <div class="rounded-circle d-flex align-items-center justify-content-center text-white fw-bold"
                                                             style="width: 36px; height: 36px; background: #2e7d32; font-size: 13px;">
                                                            {{ user.prenom|slice(0,1)|upper }}{{ user.nom|slice(0,1)|upper }}
                                                        </div>
                                                    {% endif %}
                                                    <div>
                                                        <strong>{{ user.prenom }} {{ user.nom }}</strong>
                                                        <br><small class="text-muted">{{ user.email }}</small>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                {% if user.isProprietaire() %}
                                                    <span class="badge" style="background: #fff8e1; color: #f57f17;">Propriétaire</span>
                                                {% elseif user.isClient() %}
                                                    <span class="badge" style="background: #e8f5e9; color: #2e7d32;">Client</span>
                                                {% else %}
                                                    <span class="badge" style="background: #e3f2fd; color: #1565c0;">Admin</span>
                                                {% endif %}
                                            </td>
                                            <td><small class="text-muted">{{ user.createdAt|date('d/m/Y') }}</small></td>
                                            <td>
                                                {% if user.isActive %}
                                                    <span class="badge bg-success">Actif</span>
                                                {% else %}
                                                    <span class="badge bg-secondary">Inactif</span>
                                                {% endif %}
                                            </td>
                                        </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>

                {# Demandes en attente #}
                <div class="col-lg-5">
                    <div class="card card-outline card-warning">
                        <div class="card-header">
                            <div class="card-title fw-bold">
                                <i class="bi bi-clock-history me-2 text-warning"></i>Demandes en attente
                            </div>
                            <div class="card-tools">
                                <a href="{{ path('app_user_pending') }}" class="btn btn-sm btn-outline-warning">Voir tout</a>
                            </div>
                        </div>
                        <div class="card-body">
                            {% if pending_proprietaires|length > 0 %}
                                {% for user in pending_proprietaires %}
                                <div class="d-flex justify-content-between align-items-center mb-3 pb-3 border-bottom">
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold"
                                             style="width: 36px; height: 36px; background: #fff8e1; color: #f57f17; font-size: 13px;">
                                            {{ user.prenom|slice(0,1)|upper }}{{ user.nom|slice(0,1)|upper }}
                                        </div>
                                        <div>
                                            <strong style="font-size: 14px;">{{ user.prenom }} {{ user.nom }}</strong>
                                            <br><small class="text-muted">{{ user.email }}</small>
                                        </div>
                                    </div>
                                    <a href="{{ path('app_user_show', {id: user.id}) }}" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </div>
                                {% endfor %}
                            {% else %}
                                <div class="text-center py-4">
                                    <i class="bi bi-check-circle text-success" style="font-size: 48px;"></i>
                                    <p class="text-muted mt-3 mb-0">Aucune demande en attente</p>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>

    {# Chart.js #}
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    <script>
    new Chart(document.getElementById('monthlyChart'), {
        type: 'line',
        data: {
            labels: {{ monthly_stats.labels|json_encode|raw }},
            datasets: [{
                label: 'Inscriptions',
                data: {{ monthly_stats.data|json_encode|raw }},
                backgroundColor: 'rgba(46, 125, 50, 0.1)',
                borderColor: '#2e7d32',
                borderWidth: 3,
                fill: true,
                tension: 0.4,
                pointBackgroundColor: '#2e7d32',
                pointRadius: 5,
                pointHoverRadius: 7
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } },
            scales: { y: { beginAtZero: true, ticks: { precision: 0 } } }
        }
    });

    new Chart(document.getElementById('roleChart'), {
        type: 'doughnut',
        data: {
            labels: ['Clients', 'Propriétaires', 'Admins'],
            datasets: [{
                data: [{{ client_count }}, {{ proprietaire_count }}, {{ admin_count }}],
                backgroundColor: ['#2e7d32', '#f57f17', '#1565c0'],
                borderWidth: 0
            }]
        },
        options: {
            responsive: true,
            plugins: { legend: { display: false } }
        }
    });
    </script>

{% endblock %}

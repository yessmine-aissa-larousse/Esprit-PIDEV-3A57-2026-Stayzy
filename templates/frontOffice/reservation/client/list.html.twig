{% extends 'frontOffice/base.html.twig' %}

{% block title %}Mes Réservations{% endblock %}

{% block body %}

<div class="container-fluid">

   <div class="mb-4 mt-5 text-center">
    <h2 class="fw-semibold text-secondary">
        Mes Réservations
    </h2>
</div>



    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show small" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">

            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-muted small">
                    <tr>
                        <th>#</th>
                        <th>Logement</th>
                        <th>Date Début</th>
                        <th>Date Fin</th>
                        <th>Personnes</th>
                        <th>Prix</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>

                <tbody class="small">
                {% for reservation in reservations %}
                    <tr>
                        <td class="fw-medium">#{{ reservation.id }}</td>
                        <td>{{ reservation.logement.titre }}</td>
                        <td>{{ reservation.dateDebut|date('d/m/Y') }}</td>
                        <td>{{ reservation.dateFin|date('d/m/Y') }}</td>
                        <td>{{ reservation.nombrePersonnes }}</td>
                        <td>{{ reservation.prixTotal }} DT</td>

                        <td>
                            {% if reservation.status == 'EN_ATTENTE' %}
                                <span class="badge bg-warning bg-opacity-25 text-warning-emphasis fw-normal">
    En attente
</span>


                            {% elseif reservation.status == 'CONFIRMÉE' %}
                                <span class="badge bg-success bg-opacity-25 text-success fw-normal">
                                    Confirmée
                                </span>
                            {% else %}
                                <span class="badge bg-danger bg-opacity-25 text-danger fw-normal">
                                    Annulée
                                </span>
                            {% endif %}
                        </td>

                        <td class="text-end">
                            {% if reservation.status == 'EN_ATTENTE' %}
                                <a href="{{ path('front_reservation_edit', {'id': reservation.id}) }}"
                                   class="btn btn-sm btn-outline-primary">
                                    Modifier
                                </a>
                            {% endif %}
                            <a href="{{ path('front_reservation_cancel', {'id': reservation.id}) }}"
                               class="btn btn-sm btn-outline-danger ms-1">
                                Annuler
                            </a>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            Aucune réservation trouvée
                        </td>
                    </tr>
                {% endfor %}
                </tbody>

            </table>

        </div>
    </div>

</div>

{% endblock %}
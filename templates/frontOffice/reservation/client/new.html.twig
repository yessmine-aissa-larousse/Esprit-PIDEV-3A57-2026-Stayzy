{% extends 'frontOffice/base.html.twig' %}
{% block title %}Nouvelle réservation{% endblock %}

{% block stylesheets %}{{ parent() }}
<style>
.leg-dot { display:inline-block;width:13px;height:13px;border-radius:3px;vertical-align:middle;margin-right:4px; }
#calBox { border:1px solid #e0e0e0; border-radius:12px; overflow:hidden; }
#calBox .cal-header { display:flex; align-items:center; justify-content:space-between; padding:10px 16px; background:#f8f9fa; border-bottom:1px solid #eee; }
#calBox .cal-nav { background:none; border:1px solid #ddd; border-radius:50%; width:30px; height:30px; cursor:pointer; font-size:18px; line-height:1; display:flex; align-items:center; justify-content:center; }
#calBox .cal-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:2px; padding:10px; }
#calBox .cal-wday { text-align:center; font-size:11px; color:#888; padding:4px; font-weight:600; }
#calBox .cal-day { text-align:center; font-size:13px; height:34px; display:flex; align-items:center; justify-content:center; border-radius:50%; }
#calBox .cal-day.available { cursor:pointer; color:#333; }
#calBox .cal-day.available:hover { background:#f0f0f0; }
#calBox .cal-day.past { color:#ccc; cursor:not-allowed; }
#calBox .cal-day.reserved { background:#ffecec; color:#e53935; cursor:not-allowed; text-decoration:line-through; }
#calBox .cal-day.sel-start { background:#2e7d32; color:#fff; cursor:pointer; border-radius:50% 0 0 50%; }
#calBox .cal-day.sel-start.alone { border-radius:50%; }
#calBox .cal-day.sel-end   { background:#2e7d32; color:#fff; cursor:pointer; border-radius:0 50% 50% 0; }
#calBox .cal-day.in-range  { background:#e8f5e9; color:#2e7d32; cursor:pointer; border-radius:0; }
#calBox .cal-day.is-today:not(.sel-start):not(.sel-end) { box-shadow:inset 0 0 0 2px #2e7d32; color:#2e7d32; }
</style>
{% endblock %}

{% block body %}
<div class="page-title light-background py-5">
    <div class="container text-center">
        <h1 class="fw-bold">Nouvelle réservation</h1>
    </div>
</div>

<div class="container my-5">
    {% for m in app.flashes('success') %}<div class="alert alert-success">{{ m }}</div>{% endfor %}
    {% for m in app.flashes('error') %}<div class="alert alert-danger">{{ m }}</div>{% endfor %}

    <div class="card shadow-sm p-4 mx-auto" style="max-width:680px;">

        {{ form_start(form, {attr: {id:'resForm', novalidate:'novalidate'}}) }}

        {# Render date widgets hidden so form_end won't re-emit them as visible native pickers.
           Do NOT override the id attribute — Symfony renders id first, attr.id second, and browsers
           take the first occurrence, so getElementById('sf_debut') would return null.
           We read the real id via form.dateDebut.vars.id in the JS below. #}
        <div style="display:none">
            {{ form_widget(form.dateDebut) }}
            {{ form_widget(form.dateFin) }}
        </div>
        {{ form_errors(form.dateDebut) }}
        {{ form_errors(form.dateFin) }}

        {# Date display boxes #}
        <div class="row g-2 mb-3">
            <div class="col-6">
                <div style="border:1.5px solid #ddd;border-radius:10px;padding:10px 14px;">
                    <div style="font-size:10px;font-weight:700;text-transform:uppercase;color:#888;margin-bottom:3px;">Arrivée</div>
                    <div id="dispDebut" style="font-size:14px;color:#aaa;">Sélectionner</div>
                </div>
            </div>
            <div class="col-6">
                <div style="border:1.5px solid #ddd;border-radius:10px;padding:10px 14px;">
                    <div style="font-size:10px;font-weight:700;text-transform:uppercase;color:#888;margin-bottom:3px;">Départ</div>
                    <div id="dispFin" style="font-size:14px;color:#aaa;">Sélectionner</div>
                </div>
            </div>
        </div>
        <div id="calErr" class="text-danger small mb-2"></div>

        {# Calendar rendered by JS #}
        <div id="calBox" class="mb-3"></div>

        {# Legend #}
        <div class="d-flex flex-wrap gap-3 mb-3" style="font-size:12px;color:#555;">
            <span><span class="leg-dot" style="background:#ffecec;border:1px solid #fbb;"></span>Déjà réservé</span>
            <span><span class="leg-dot" style="background:#e8f5e9;"></span>Votre séjour</span>
            <span><span class="leg-dot" style="background:#2e7d32;border-radius:50%;"></span>Date choisie</span>
            <span><span class="leg-dot" style="background:#eee;"></span>Passé</span>
        </div>
        <hr>

        {# Persons #}
        <div class="mb-3">
            {{ form_label(form.nombrePersonnes) }}
            {{ form_widget(form.nombrePersonnes, {attr:{class:'form-control',min:1}}) }}
            {{ form_errors(form.nombrePersonnes) }}
        </div>

        {# Message #}
        <div class="mb-3">
            {{ form_label(form.messageDemande) }}
            {{ form_widget(form.messageDemande, {attr:{class:'form-control',rows:4}}) }}
        </div>

        {# Price recap #}
        <div id="priceRecap" style="display:none;background:#f1f8f1;border-radius:10px;padding:12px 16px;margin-bottom:14px;">
            <div class="d-flex justify-content-between">
                <span id="recapLbl" style="font-size:14px;"></span>
                <strong id="recapTot" style="font-size:14px;color:#2e7d32;"></strong>
            </div>
        </div>

        <button type="submit" class="btn btn-success w-100">Réserver</button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}

{% block javascripts %}{{ parent() }}
<script>
(function () {
    var LID      = {{ logement is defined ? logement.id : 0 }};
    var PRIX     = {{ logement is defined ? (logement.prix ?? 0) : 0 }};
    /* Real ids generated by Symfony — do not hard-code 'sf_debut' */
    var ID_DEBUT = '{{ form.dateDebut.vars.id }}';
    var ID_FIN   = '{{ form.dateFin.vars.id }}';

    var now    = new Date();
    var todayY = now.getFullYear(), todayM = now.getMonth(), todayD = now.getDate();
    var TODAY  = todayY + '-' + ('0'+(todayM+1)).slice(-2) + '-' + ('0'+todayD).slice(-2);

    var MONTHS = ['Janvier','Février','Mars','Avril','Mai','Juin','Juillet','Août','Septembre','Octobre','Novembre','Décembre'];
    var WDAYS  = ['Lun','Mar','Mer','Jeu','Ven','Sam','Dim'];
    var MSHORT = ['jan','fév','mar','avr','mai','juin','juil','août','sep','oct','nov','déc'];

    var reserved  = [];
    var startDate = null, endDate = null;
    var viewY = todayY, viewM = todayM;

    /* ── helpers ── */
    function ymd(y, m, d) { return y + '-' + ('0'+(m+1)).slice(-2) + '-' + ('0'+d).slice(-2); }
    function dateToYmd(d) { return d.getFullYear() + '-' + ('0'+(d.getMonth()+1)).slice(-2) + '-' + ('0'+d.getDate()).slice(-2); }
    function fmtDisp(s)   { var p = s.split('-'); return parseInt(p[2]) + ' ' + MSHORT[parseInt(p[1])-1] + ' ' + p[0]; }
    function isRes(s)     { return reserved.some(function(r){ return s >= r.from && s <= r.to; }); }
    function isPast(s)    { return s < TODAY; }
    function inRange(s)   { return !!(startDate && endDate && s > startDate && s < endDate); }

    function rangeHasRes(from, to) {
        var cur = new Date(from + 'T00:00:00'), end = new Date(to + 'T00:00:00');
        while (cur <= end) { if (isRes(dateToYmd(cur))) return true; cur.setDate(cur.getDate()+1); }
        return false;
    }

    /* ── sync hidden inputs + display boxes ── */
    function sync() {
        var inDebut = document.getElementById(ID_DEBUT);
        var inFin   = document.getElementById(ID_FIN);
        if (inDebut) inDebut.value = startDate || '';
        if (inFin)   inFin.value   = endDate   || '';

        var eD = document.getElementById('dispDebut'), eF = document.getElementById('dispFin');
        if (eD) { eD.textContent = startDate ? fmtDisp(startDate) : 'Sélectionner'; eD.style.color = startDate ? '#222' : '#aaa'; }
        if (eF) { eF.textContent = endDate   ? fmtDisp(endDate)   : 'Sélectionner'; eF.style.color = endDate   ? '#222' : '#aaa'; }

        var rc = document.getElementById('priceRecap');
        if (rc) {
            if (startDate && endDate) {
                var n = Math.round((new Date(endDate+'T00:00:00') - new Date(startDate+'T00:00:00')) / 86400000);
                document.getElementById('recapLbl').textContent = n + ' nuit' + (n > 1 ? 's' : '') + ' × ' + PRIX + '€';
                document.getElementById('recapTot').textContent = (n * PRIX).toFixed(0) + '€';
                rc.style.display = 'block';
            } else {
                rc.style.display = 'none';
            }
        }
    }

    /* ── day click ── */
    function onDayClick(s) {
        document.getElementById('calErr').textContent = '';
        if (!startDate || endDate) {
            startDate = s; endDate = null;
        } else if (s <= startDate) {
            startDate = s; endDate = null;
        } else if (rangeHasRes(startDate, s)) {
            document.getElementById('calErr').textContent = '⚠ La période contient des dates déjà réservées.';
            startDate = null; endDate = null;
        } else {
            endDate = s;
        }
        sync();
        render();
    }

    /* ── render calendar HTML (no event binding here) ── */
    function render() {
        var box = document.getElementById('calBox');
        if (!box) return;

        var dim      = new Date(viewY, viewM + 1, 0).getDate();
        var firstDOW = (new Date(viewY, viewM, 1).getDay() + 6) % 7; // Mon=0

        var html = '<div class="cal-header">'
            + '<button type="button" class="cal-nav" data-cal-nav="prev">&#8249;</button>'
            + '<strong style="font-size:14px;">' + MONTHS[viewM] + ' ' + viewY + '</strong>'
            + '<button type="button" class="cal-nav" data-cal-nav="next">&#8250;</button>'
            + '</div><div class="cal-grid">';

        WDAYS.forEach(function(d) { html += '<div class="cal-wday">' + d + '</div>'; });

        for (var i = 0; i < firstDOW; i++) html += '<div></div>';

        for (var d = 1; d <= dim; d++) {
            var s    = ymd(viewY, viewM, d);
            var past = isPast(s), res = isRes(s);
            var cls  = 'cal-day';

            if      (past) cls += ' past';
            else if (res)  cls += ' reserved';
            else if (s === startDate) { cls += ' sel-start'; if (!endDate) cls += ' alone'; }
            else if (s === endDate)   cls += ' sel-end';
            else if (inRange(s))      cls += ' in-range';
            else                      cls += ' available';

            if (s === TODAY) cls += ' is-today';

            var da = (!past && !res) ? ' data-date="' + s + '"' : '';
            html += '<div class="' + cls + '"' + da + '>' + d + '</div>';
        }

        html += '</div>';
        box.innerHTML = html;
    }

    /* ── attach ONE delegated listener on #calBox (called once) ── */
    function initEvents() {
        var box = document.getElementById('calBox');
        if (!box) return;
        box.addEventListener('click', function(e) {
            /* Day click */
            var day = e.target.closest('[data-date]');
            if (day) { onDayClick(day.dataset.date); return; }
            /* Nav buttons */
            var nav = e.target.closest('[data-cal-nav]');
            if (!nav) return;
            if (nav.dataset.calNav === 'prev') { if (--viewM < 0)  { viewM = 11; viewY--; } }
            else                               { if (++viewM > 11) { viewM = 0;  viewY++; } }
            render();
        });
    }

    /* ── boot ── */
    document.addEventListener('DOMContentLoaded', function() {
        initEvents(); /* attach once before first render */

        var go = function() { render(); sync(); };
        if (LID) {
            fetch('/reservation/api/blocked/' + LID)
                .then(function(r) { return r.json(); })
                .then(function(data) { reserved = data; go(); })
                .catch(go);
        } else {
            go();
        }

        document.getElementById('resForm').addEventListener('submit', function(e) {
            if (!startDate || !endDate) {
                e.preventDefault();
                document.getElementById('calErr').textContent = '⚠ Sélectionnez les dates d\'arrivée et de départ.';
                document.getElementById('calBox').scrollIntoView({ behavior: 'smooth' });
            }
        });
    });
}());
</script>
{% endblock %}

{% extends 'frontOffice/base.html.twig' %}

{% block title %}Mon Profil - Stayzy{% endblock %}

{% block body %}

    <section style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); padding: 60px 0 40px;">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <h2 class="fw-bold mb-1">
                        <i class="bi bi-person-circle me-2 text-warning"></i>Mon Profil
                    </h2>
                    <p class="text-muted mb-0">Gérez vos informations personnelles et vos logements</p>
                </div>
                <div class="col-md-6 text-md-end">
                    <nav aria-label="breadcrumb">
                        <ol class="breadcrumb justify-content-md-end mb-0">
                            <li class="breadcrumb-item"><a href="{{ path('app_home') }}">Accueil</a></li>
                            <li class="breadcrumb-item active">Mon Profil</li>
                        </ol>
                    </nav>
                </div>
            </div>
        </div>
    </section>


    {# ── Contenu principal ── #}
    <section style="padding: 50px 0 80px;">
        <div class="container">

            {# Messages Flash #}

    <section style="padding: 50px 0 80px;">
        <div class="container">

            {% for message in app.flashes('success') %}
                <div class="alert alert-success alert-dismissible fade show rounded-3 mb-4" role="alert">
                    <i class="bi bi-check-circle-fill me-2"></i>{{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger alert-dismissible fade show rounded-3 mb-4" role="alert">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>{{ message }}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            {% endfor %}

            <div class="row g-4">

                {# ══════════════════════════════ #}
                {# COLONNE GAUCHE — Carte identité #}
                {# ══════════════════════════════ #}

                <div class="col-lg-3">
                    <div class="card border-0 shadow-sm" style="border-radius: 16px; position: sticky; top: 90px;">
                        <div class="card-body text-center p-4">

                            {# Photo + badge statut #}
                            {% set initials = user.prenom|slice(0,1)|upper ~ user.nom|slice(0,1)|upper %}
                            {% set avatarFallback = 'https://ui-avatars.com/api/?name=' ~ initials ~ '&background=f59e0b&color=fff&size=110' %}

                            <div class="position-relative d-inline-block mb-3">
                                {% if user.profilePicture %}
                                    <img src="{{ asset('uploads/profiles/' ~ user.profilePicture) }}"
                                         alt="Photo de profil"
                                         class="rounded-circle"
                                         style="width: 110px; height: 110px; object-fit: cover; border: 4px solid #f59e0b;"
                                         onerror="this.src='{{ avatarFallback }}'">
                                {% else %}
                                    <img src="{{ avatarFallback }}"
                                         alt="{{ initials }}"
                                         class="rounded-circle"
                                         style="width: 110px; height: 110px; object-fit: cover; border: 4px solid #f59e0b;">
                                {% endif %}

                                {% if user.approvalStatus == 'approved' %}
                                    <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-success" style="font-size: 10px;">✅ Vérifié</span>
                                {% elseif user.approvalStatus == 'pending' %}
                                    <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-warning text-dark" style="font-size: 10px;">⏳ En attente</span>
                                {% else %}
                                    <span class="position-absolute bottom-0 end-0 badge rounded-pill bg-danger" style="font-size: 10px;">❌ Rejeté</span>
                                {% endif %}
                            </div>

                            <h5 class="fw-bold mb-1">{{ user.prenom }} {{ user.nom }}</h5>
                            <p class="text-muted small mb-1">
                                <i class="bi bi-envelope me-1"></i>{{ user.email }}
                            </p>
                            {% if user.tel %}
                                <p class="text-muted small mb-2">
                                    <i class="bi bi-telephone me-1"></i>{{ user.tel }}
                                </p>
                            {% endif %}
                            <span class="badge rounded-pill px-3 py-2"
                                  style="background: #fff8e1; color: #d97706; font-size: 12px; border: 1px solid #fde68a;">
                                <i class="bi bi-building me-1"></i> Propriétaire
                            </span>

                            <hr class="my-3">


                            {# Stats rapides #}

                            <div class="row g-2 text-center">
                                <div class="col-6">
                                    <div class="rounded-3 p-2" style="background: #f0fdf4;">
                                        <div class="fw-bold fs-5 text-success">{{ user.logements|length }}</div>
                                        <small class="text-muted" style="font-size: 11px;">Propriétés</small>
                                    </div>
                                </div>
                                <div class="col-6">
                                    <div class="rounded-3 p-2" style="background: #eff6ff;">
                                        <div class="fw-bold fs-5 text-primary">0</div>
                                        <small class="text-muted" style="font-size: 11px;">Réservations</small>
                                    </div>
                                </div>
                            </div>

                            <hr class="my-3">

                            {# Score de confiance #}

                            {% include 'components/trust_score.html.twig' %}

                            <p class="text-muted small mt-3 mb-0">
                                <i class="bi bi-calendar3 me-1"></i>
                                Membre depuis {{ user.createdAt|date('M Y') }}
                            </p>

                            {# ===== FACE ID ===== #}
                            <hr style="margin: 15px 0;">
                            <button type="button" onclick="startFaceSave()"
                                    class="btn w-100"
                                    style="background: #1565c0; color: white; border-radius: 10px; padding: 12px; border: none;">
                                <i class="bi bi-camera me-2"></i> Enregistrer mon visage
                            </button>

                            {% if user.faceDescriptor %}
                                <div class="mt-2 text-center">
                                    <small style="color: #2e7d32;"><i class="bi bi-check-circle-fill me-1"></i>Visage enregistré ✅</small>
                                </div>
                            {% else %}
                                <div class="mt-2 text-center">
                                    <small class="text-muted"><i class="bi bi-x-circle me-1"></i>Aucun visage enregistré</small>
                                </div>
                            {% endif %}
                            {# ===== FIN FACE ID ===== #}


                        </div>
                    </div>
                </div>

                {# ════════════════════════════════════ #}
                {# COLONNE DROITE — Formulaire + Logements #}
                {# ════════════════════════════════════ #}

                <div class="col-lg-9">

                    {{ form_start(form, {'attr': {'enctype': 'multipart/form-data', 'novalidate': 'novalidate'}}) }}

                    {# CARD 1 : Photo de profil #}

                    <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
                        <div class="card-header bg-white border-bottom px-4 py-3" style="border-radius: 16px 16px 0 0;">
                            <h6 class="mb-0 fw-semibold">
                                <i class="bi bi-camera text-warning me-2"></i>Photo de profil
                            </h6>
                        </div>
                        <div class="card-body px-4 py-3">
                            <div class="d-flex align-items-center gap-3">
                                <div id="preview">
                                    <img src="{{ user.profilePicture ? asset('uploads/profiles/' ~ user.profilePicture) : avatarFallback }}"
                                         id="profilePreviewImg"
                                         class="rounded-circle"
                                         style="width: 72px; height: 72px; object-fit: cover; border: 3px solid #f59e0b;"
                                         onerror="this.src='{{ avatarFallback }}'">
                                </div>
                                <div class="flex-grow-1">
                                    <input type="file" name="profile_picture" class="form-control"
                                           accept="image/*" onchange="previewImage(event)"
                                           style="border-radius: 10px;">
                                    <small class="text-muted">JPG, PNG — Max 2MB</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    {# CARD 2 : Informations personnelles #}

                    <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
                        <div class="card-header bg-white border-bottom px-4 py-3" style="border-radius: 16px 16px 0 0;">
                            <h6 class="mb-0 fw-semibold">
                                <i class="bi bi-person-badge text-primary me-2"></i>Informations personnelles
                            </h6>
                        </div>
                        <div class="card-body px-4 py-3">
                            <div class="row">
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.prenom, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}
                                    {{ form_widget(form.prenom, {'attr': {'class': 'form-control', 'style': 'border-radius: 10px;'}}) }}
                                    {% if form.prenom.vars.errors|length > 0 %}
                                        <div class="text-danger mt-1 small">{{ form_errors(form.prenom) }}</div>
                                    {% endif %}
                                </div>
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.nom, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}
                                    {{ form_widget(form.nom, {'attr': {'class': 'form-control', 'style': 'border-radius: 10px;'}}) }}
                                    {% if form.nom.vars.errors|length > 0 %}
                                        <div class="text-danger mt-1 small">{{ form_errors(form.nom) }}</div>
                                    {% endif %}
                                </div>
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.email, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}
                                    {{ form_widget(form.email, {'attr': {'class': 'form-control', 'style': 'border-radius: 10px;'}}) }}
                                    {% if form.email.vars.errors|length > 0 %}
                                        <div class="text-danger mt-1 small">{{ form_errors(form.email) }}</div>
                                    {% endif %}
                                </div>
                                <div class="col-md-6 mb-3">
                                    {{ form_label(form.tel, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}
                                    {{ form_widget(form.tel, {'attr': {'class': 'form-control', 'placeholder': '+216 XX XXX XXX', 'style': 'border-radius: 10px;'}}) }}
                                    {% if form.tel.vars.errors|length > 0 %}
                                        <div class="text-danger mt-1 small">{{ form_errors(form.tel) }}</div>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>

                    {# CARD 3 : Mot de passe #}

                    <div class="card border-0 shadow-sm mb-4" style="border-radius: 16px;">
                        <div class="card-header bg-white border-bottom px-4 py-3" style="border-radius: 16px 16px 0 0;">
                            <h6 class="mb-0 fw-semibold">
                                <i class="bi bi-key text-info me-2"></i>Changer le mot de passe
                            </h6>
                        </div>
                        <div class="card-body px-4 py-3">
                            <div class="col-md-8">
                                {{ form_label(form.password, null, {'label_attr': {'class': 'form-label fw-medium'}}) }}
                                {{ form_widget(form.password, {'attr': {'class': 'form-control', 'placeholder': 'Laisser vide pour ne pas changer', 'style': 'border-radius: 10px;'}}) }}
                                <small class="text-muted">Laisser vide si vous ne souhaitez pas changer votre mot de passe</small>
                            </div>
                        </div>
                    </div>

                    {# Boutons d'action #}

                    <div class="d-flex gap-3 mb-5">
                        <button type="submit" class="btn btn-warning fw-semibold px-4"
                                style="border-radius: 10px;">
                            <i class="bi bi-check-circle me-2"></i>Enregistrer les modifications
                        </button>
                        <a href="{{ path('app_home') }}" class="btn btn-outline-secondary px-4"
                           style="border-radius: 10px;">
                            <i class="bi bi-x-circle me-1"></i>Annuler
                        </a>
                    </div>

                    {{ form_end(form) }}

                    {# Suggestions Trust Score #}
                    {% include 'components/trust_suggestions.html.twig' %}

                    {# CARD 4 : Mes propriétés #}

                    {% include 'components/trust_suggestions.html.twig' %}

                    <div class="card border-0 shadow-sm mt-4" style="border-radius: 16px; overflow: hidden;">
                        <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center px-4 py-3">
                            <h6 class="mb-0 fw-semibold">
                                <i class="bi bi-house-door text-success me-2"></i>Mes propriétés
                                <span class="badge bg-success ms-1">{{ user.logements|length }}</span>
                            </h6>
                            <a href="{{ path('proprietaire_logement_add') }}" class="btn btn-success btn-sm"
                               style="border-radius: 8px;">
                                <i class="bi bi-plus-circle me-1"></i>Ajouter un logement
                            </a>
                        </div>
                        <div class="card-body p-0">
                            {% if user.logements|length > 0 %}
                                <div class="table-responsive">
                                    <table class="table table-hover align-middle mb-0">
                                        <thead style="background: #f8f9fa;">
                                            <tr>
                                                <th class="ps-4">Logement</th>
                                                <th>Prix / nuit</th>
                                                <th>Disponibilité</th>
                                                <th class="pe-4">Actions</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for logement in user.logements %}
                                            <tr>
                                                <td class="ps-4 fw-semibold">{{ logement.titre }}</td>
                                                <td>
                                                    <span class="badge bg-success" style="border-radius: 8px;">
                                                        {{ logement.prix }} €
                                                    </span>
                                                </td>
                                                <td>
                                                    {% if logement.disponible %}
                                                        <span class="badge bg-success" style="border-radius: 8px;">Disponible</span>
                                                    {% else %}
                                                        <span class="badge bg-secondary" style="border-radius: 8px;">Indisponible</span>
                                                    {% endif %}
                                                </td>
                                                <td class="pe-4">
                                                    <a href="{{ path('admin_logement_edit', {id: logement.id}) }}"
                                                       class="btn btn-sm btn-outline-warning" style="border-radius: 8px;">
                                                        <i class="bi bi-pencil"></i>
                                                    </a>
                                                </td>
                                            </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                                <div class="px-4 py-3 text-end border-top">
                                    <a href="{{ path('proprietaire_logement_list') }}"
                                       class="btn btn-outline-success btn-sm" style="border-radius: 8px;">
                                        Voir tous mes logements <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            {% else %}
                                <div class="text-center py-5">
                                    <i class="bi bi-house-add" style="font-size: 60px; color: #dee2e6;"></i>
                                    <h6 class="mt-4 text-muted">Aucune propriété pour l'instant</h6>
                                    <p class="text-muted small mb-4">Ajoutez votre première propriété pour recevoir des réservations.</p>
                                    <a href="{{ path('proprietaire_logement_add') }}" class="btn btn-success px-4"
                                       style="border-radius: 10px;">
                                        <i class="bi bi-plus-circle me-2"></i>Ajouter une propriété
                                    </a>
                                </div>
                            {% endif %}
                        </div>
                    </div>

                </div>
                {# fin col droite #}


            </div>
        </div>
    </section>

    {# ===== OVERLAY CAMÉRA — fixe, indépendant de Bootstrap ===== #}
    <div id="faceBackdrop" onclick="stopFaceCamera()"
         style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.65);
                z-index:9998; cursor:pointer;"></div>

    <div id="faceWindow"
         style="display:none; position:fixed; top:50%; left:50%;
                transform:translate(-50%,-50%); z-index:9999;
                background:#fff; border-radius:18px;
                box-shadow:0 24px 64px rgba(0,0,0,0.45);
                width:420px; max-width:95vw; overflow:hidden;">
        <div style="background:#1565c0; padding:16px 20px;
                    display:flex; align-items:center; justify-content:space-between;">
            <span style="color:#fff; font-weight:600; font-size:15px;">
                <i class="bi bi-camera me-2"></i>Enregistrer mon visage
            </span>
            <button onclick="stopFaceCamera()" type="button"
                    style="background:none; border:none; color:#fff; font-size:22px;
                           line-height:1; cursor:pointer;" aria-label="Fermer">&times;</button>
        </div>
        <div style="padding:20px; text-align:center;">
            <div id="saveStatus"
                 style="background:#e3f2fd; border:1px solid #90caf9; border-radius:10px;
                        padding:10px 14px; font-size:14px; margin-bottom:16px; color:#0d47a1;">
                <i class="bi bi-info-circle me-2"></i>Positionnez votre visage et cliquez Capturer
            </div>
            <div style="position:relative; display:inline-block;">
                <video id="saveVideo" autoplay muted playsinline width="360" height="270"
                       style="border-radius:12px; border:3px solid #1565c0;
                              display:block; background:#000;"></video>
                <canvas id="saveCanvas" width="360" height="270"
                        style="position:absolute; top:0; left:0;
                               border-radius:12px; pointer-events:none;"></canvas>
            </div>
            <div style="margin-top:14px; display:flex; gap:10px; justify-content:center;">
                <button onclick="captureFace()" type="button"
                        style="background:#1565c0; color:#fff; border:none; border-radius:8px;
                               padding:10px 24px; cursor:pointer; font-size:14px; font-weight:600;">
                    <i class="bi bi-camera me-1"></i> Capturer
                </button>
                <button onclick="stopFaceCamera()" type="button"
                        style="background:#f5f5f5; border:1px solid #ccc; border-radius:8px;
                               padding:10px 20px; cursor:pointer; font-size:14px; color:#555;">
                    <i class="bi bi-x-circle me-1"></i> Fermer
                </button>
            </div>
            <div id="loadingSave" style="display:none; margin-top:12px;">
                <div class="spinner-border text-primary" role="status"></div>
            </div>
        </div>
    </div>
    {# ===== FIN OVERLAY CAMÉRA ===== #}
{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function previewImage(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (e) => {
        const img = document.getElementById('profilePreviewImg');
        if (img) img.src = e.target.result;
    };
    reader.readAsDataURL(file);
}

// ===== FACE SAVE — overlay fixe (sans Bootstrap modal) =====
let saveStream = null;

async function startFaceSave() {
    document.getElementById('faceBackdrop').style.display = 'block';
    document.getElementById('faceWindow').style.display   = 'block';
    setSaveStatus('info', '<i class="bi bi-camera me-2"></i>Activation de la caméra…');

    try {
        saveStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
        document.getElementById('saveVideo').srcObject = saveStream;
        setSaveStatus('info', '<i class="bi bi-info-circle me-2"></i>Positionnez votre visage et cliquez Capturer');
    } catch (err) {
        setSaveStatus('danger', '<i class="bi bi-x-circle me-2"></i>Caméra inaccessible : ' + err.message);
    }
}

function stopFaceCamera() {
    if (saveStream) {
        saveStream.getTracks().forEach(t => t.stop());
        saveStream = null;
    }
    document.getElementById('saveVideo').srcObject = null;
    document.getElementById('faceBackdrop').style.display = 'none';
    document.getElementById('faceWindow').style.display   = 'none';
    document.getElementById('loadingSave').style.display  = 'none';
}

function setSaveStatus(type, html) {
    const el = document.getElementById('saveStatus');
    const colours = { info:'#e3f2fd', success:'#e8f5e9', danger:'#ffebee', warning:'#fff8e1' };
    const borders  = { info:'#90caf9', success:'#a5d6a7', danger:'#ef9a9a', warning:'#ffe082' };
    const texts    = { info:'#0d47a1', success:'#1b5e20', danger:'#b71c1c', warning:'#e65100' };
    el.style.background  = colours[type] || colours.info;
    el.style.borderColor = borders[type] || borders.info;
    el.style.color       = texts[type]   || texts.info;
    el.innerHTML = html;
}

async function captureFace() {
    const video = document.getElementById('saveVideo');
    if (!video.videoWidth) {
        setSaveStatus('warning', '<i class="bi bi-hourglass me-2"></i>Caméra pas encore prête, réessayez.');
        return;
    }
    document.getElementById('loadingSave').style.display = 'block';
    setSaveStatus('info', '<i class="bi bi-hourglass me-2"></i>Envoi à l\'API…');

    const snap = document.createElement('canvas');
    snap.width  = video.videoWidth;
    snap.height = video.videoHeight;
    snap.getContext('2d').drawImage(video, 0, 0);
    const imageBase64 = snap.toDataURL('image/jpeg').split(',')[1];

    try {
        const response = await fetch('/face/save', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ image: imageBase64 })
        });
        const result = await response.json();
        document.getElementById('loadingSave').style.display = 'none';

        if (result.success) {
            setSaveStatus('success', '<i class="bi bi-check-circle-fill me-2"></i>Visage enregistré avec succès !');
            stopFaceCamera();
            setTimeout(() => location.reload(), 1500);
        } else {
            setSaveStatus('danger', '<i class="bi bi-x-circle me-2"></i>Erreur : ' + result.error);
        }
    } catch {
        document.getElementById('loadingSave').style.display = 'none';
        setSaveStatus('danger', '<i class="bi bi-wifi-off me-2"></i>Erreur réseau. Réessayez.');
    }
}
// ===== FIN FACE SAVE =====
</script>
{% endblock %}
<script>
function previewImage(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (e) => {
        document.getElementById('preview').innerHTML =
            `<img src="${e.target.result}" class="rounded-circle"
                  style="width:72px;height:72px;object-fit:cover;border:3px solid #f59e0b;">`;
    };
    reader.readAsDataURL(file);
}

// ===== FACE SAVE =====
let saveStream = null;

async function startFaceSave() {
    const modal = new bootstrap.Modal(document.getElementById('faceRegisterModal'));
    modal.show();

    document.getElementById('saveStatus').innerHTML =
        '<i class="bi bi-camera me-2"></i>Positionnez votre visage et cliquez Capturer';

    saveStream = await navigator.mediaDevices.getUserMedia({ video: true });
    document.getElementById('saveVideo').srcObject = saveStream;
}

async function captureFace() {
    const video = document.getElementById('saveVideo');
    document.getElementById('loadingSave').classList.remove('d-none');
    document.getElementById('saveStatus').className = 'alert alert-info mb-3';
    document.getElementById('saveStatus').innerHTML =
        '<i class="bi bi-hourglass me-2"></i>Envoi à l\'API...';

    const canvas = document.createElement('canvas');
    canvas.width  = video.videoWidth;
    canvas.height = video.videoHeight;
    canvas.getContext('2d').drawImage(video, 0, 0);
    const imageBase64 = canvas.toDataURL('image/jpeg').split(',')[1];

    const response = await fetch('/face/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ image: imageBase64 })
    });

    const result = await response.json();
    document.getElementById('loadingSave').classList.add('d-none');

    if (result.success) {
        document.getElementById('saveStatus').className = 'alert alert-success mb-3';
        document.getElementById('saveStatus').innerHTML =
            '<i class="bi bi-check-circle-fill me-2"></i>Visage enregistré avec succès!';
        stopFaceCamera();
        setTimeout(() => {
            bootstrap.Modal.getInstance(document.getElementById('faceRegisterModal')).hide();
            location.reload();
        }, 1500);
    } else {
        document.getElementById('saveStatus').className = 'alert alert-danger mb-3';
        document.getElementById('saveStatus').innerHTML =
            '<i class="bi bi-x-circle me-2"></i>Erreur: ' + result.error;
    }
}

function stopFaceCamera() {
    if (saveStream) {
        saveStream.getTracks().forEach(t => t.stop());
        saveStream = null;
    }
}

document.getElementById('faceRegisterModal')?.addEventListener('hidden.bs.modal', stopFaceCamera);
// ===== FIN FACE SAVE =====
</script>

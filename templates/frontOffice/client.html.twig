{% extends 'frontOffice/base.html.twig' %}

{% block title %}Espace Client - StayZy{% endblock %}

{% block body %}
<div class="min-vh-100 d-flex align-items-center" style="background: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);">
    <div class="container">
        <!-- Bouton retour -->
        <div class="mb-4">
            <a href="{{ path('app_home') }}" class="btn btn-light">
                <i class="bi bi-arrow-left"></i> Retour à l'accueil
            </a>
        </div>

        <!-- En-tête -->
        <div class="text-center text-white mb-5">
            <div class="mb-4">
                <i class="bi bi-person-circle" style="font-size: 5rem;"></i>
            </div>
            <h1 class="display-4 fw-bold mb-3">Espace Client</h1>
            <p class="lead">Trouvez et réservez votre logement idéal</p>
        </div>

        <!-- Options -->
        <div class="row g-4 justify-content-center">
            <!-- Se connecter -->
            <div class="col-lg-5 col-md-6">
                <div class="card shadow-lg border-0 h-100">
                    <div class="card-body text-center p-5">
                        <div class="mb-4">
                            <i class="bi bi-box-arrow-in-right text-success" style="font-size: 4rem;"></i>
                        </div>
                        <h3 class="h4 mb-3 fw-bold">Déjà client ?</h3>
                        <p class="text-muted mb-4">
                            Connectez-vous pour accéder à votre espace personnel, consulter vos réservations et gérer votre profil.
                        </p>
                        <a href="{{ path('app_login') }}" class="btn btn-success btn-lg w-100">
                            <i class="bi bi-box-arrow-in-right"></i> Se connecter
                        </a>
                        <div class="mt-3">
                            <small class="text-muted">
                                <i class="bi bi-shield-check"></i> Connexion sécurisée
                            </small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Créer un compte -->
            <div class="col-lg-5 col-md-6">
                <div class="card shadow-lg border-0 h-100">
                    <div class="card-body text-center p-5">
                        <div class="mb-4">
                            <i class="bi bi-person-plus text-primary" style="font-size: 4rem;"></i>
                        </div>
                        <h3 class="h4 mb-3 fw-bold">Nouveau client ?</h3>
                        <p class="text-muted mb-4">
                            Créez votre compte gratuitement et commencez à rechercher parmi des milliers de propriétés disponibles.
                        </p>
                        <a href="{{ path('app_register', {role: 'client'}) }}" class="btn btn-primary btn-lg w-100">
                            <i class="bi bi-person-plus"></i> Créer un compte
                        </a>
                        <div class="mt-3">
                            <small class="text-muted">
                                <i class="bi bi-clock"></i> Inscription en 2 minutes
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Avantages -->
        <div class="row mt-5">
            <div class="col-12">
                <div class="card bg-white bg-opacity-10 border-0 text-white">
                    <div class="card-body p-4">
                        <h5 class="mb-4 text-center fw-bold">
                            <i class="bi bi-star-fill"></i> Pourquoi choisir StayZy ?
                        </h5>
                        <div class="row text-center">
                            <div class="col-md-3">
                                <i class="bi bi-search" style="font-size: 2rem;"></i>
                                <p class="mt-2 mb-0"><small>Recherche facile</small></p>
                            </div>
                            <div class="col-md-3">
                                <i class="bi bi-shield-check" style="font-size: 2rem;"></i>
                                <p class="mt-2 mb-0"><small>Paiement sécurisé</small></p>
                            </div>
                            <div class="col-md-3">
                                <i class="bi bi-chat-dots" style="font-size: 2rem;"></i>
                                <p class="mt-2 mb-0"><small>Support 24/7</small></p>
                            </div>
                            <div class="col-md-3">
                                <i class="bi bi-hand-thumbs-up" style="font-size: 2rem;"></i>
                                <p class="mt-2 mb-0"><small>Avis vérifiés</small></p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
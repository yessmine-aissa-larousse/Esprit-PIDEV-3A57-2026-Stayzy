{% extends 'frontOffice/base.html.twig' %}
{% block title %}Appliquer une promotion à tous — Stayzy{% endblock %}

{% block stylesheets %}{{ parent() }}
<style>
:root {
    --green:      #077f46;
    --green-dark: #055c32;
    --green-soft: #e8f5ee;
    --gold:       #f59e0b;
    --gold-dark:  #d97706;
    --gold-soft:  #fffbeb;
    --red:        #e53935;
    --red-soft:   #fff0f0;
    --border:     #e5e7eb;
    --bg:         #f7f8fa;
    --white:      #ffffff;
    --radius:     16px;
    --shadow:     0 8px 40px rgba(0,0,0,.10);
}
.page-title { display: none !important; }

/* ── Header dégradé gold ── */
.form-header {
    background: linear-gradient(135deg, #d97706 0%, #92400e 100%);
    color: #fff; padding: 36px 0 80px;
    position: relative; overflow: hidden;
}
.form-header::before {
    content: ''; position: absolute; top: -60px; right: -60px;
    width: 260px; height: 260px; border-radius: 50%;
    background: rgba(255,255,255,.06);
}
.form-header::after {
    content: ''; position: absolute; bottom: -80px; left: -40px;
    width: 300px; height: 300px; border-radius: 50%;
    background: rgba(255,255,255,.04);
}
.form-header .breadcrumb-bar {
    font-size: .82rem; opacity: .75; margin-bottom: 10px;
    display: flex; align-items: center; gap: 6px; position: relative; z-index: 1;
}
.form-header .breadcrumb-bar a { color: #fff; text-decoration: none; }
.form-header h1 { font-size: 1.7rem; font-weight: 700; margin: 0 0 6px; position: relative; z-index: 1; }
.form-header p  { opacity: .75; margin: 0; font-size: .9rem; position: relative; z-index: 1; }

/* ── Outer ── */
.form-outer {
    margin-top: -56px; padding-bottom: 60px;
    background: var(--bg); min-height: 60vh;
}

/* ── Layout 2 colonnes ── */
.form-layout { display: grid; grid-template-columns: 1fr 340px; gap: 24px; align-items: start; }
@media (max-width: 900px) { .form-layout { grid-template-columns: 1fr; } }

/* ── Carte principale ── */
.form-card {
    background: var(--white); border-radius: var(--radius);
    border: 1px solid var(--border); box-shadow: var(--shadow);
    padding: 36px 40px; position: relative; z-index: 2;
}
@media (max-width: 575px) { .form-card { padding: 24px 18px; } }

/* ── Section title ── */
.form-section-title {
    font-size: .75rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: .08em;
    color: var(--gold-dark); margin: 24px 0 14px;
    display: flex; align-items: center; gap: 8px;
}
.form-section-title::after { content: ''; flex: 1; height: 1px; background: var(--gold-soft); }

/* ── Inputs ── */
.form-label { font-weight: 600; font-size: .88rem; margin-bottom: 5px; color: #374151; }
.form-control, .form-select {
    border-radius: 10px; border: 1.5px solid var(--border);
    padding: 11px 14px; font-size: .9rem; background: #fafafa;
    transition: border-color .15s, box-shadow .15s;
}
.form-control:focus, .form-select:focus {
    border-color: var(--gold); box-shadow: 0 0 0 4px rgba(245,158,11,.1);
    background: var(--white); outline: none;
}
.form-text { font-size: .78rem; color: #6b7280; margin-top: 4px; }

/* ── Pct wrapper ── */
.pct-wrapper { position: relative; }
.pct-display {
    position: absolute; right: 14px; top: 50%; transform: translateY(-50%);
    font-weight: 800; font-size: 1.15rem; color: var(--red); pointer-events: none;
}

/* ── Preview ── */
.promo-preview {
    background: linear-gradient(135deg, #fff7ed 0%, #fffbeb 100%);
    border: 2px solid var(--gold); border-radius: 12px;
    padding: 20px 24px; margin-bottom: 28px;
    display: flex; align-items: center; gap: 20px; flex-wrap: wrap;
}
.preview-label {
    font-size: .72rem; font-weight: 700; text-transform: uppercase;
    letter-spacing: .06em; color: #92400e; margin-bottom: 8px;
}
.preview-prix-row { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.preview-original { text-decoration: line-through; color: #9ca3af; font-size: .9rem; }
.preview-reduit { font-size: 1.7rem; font-weight: 800; color: var(--green); line-height: 1; }
.preview-economie {
    background: var(--red-soft); color: var(--red);
    font-size: .75rem; font-weight: 700; padding: 3px 10px; border-radius: 50px;
}
.preview-badge-big {
    width: 72px; height: 72px; border-radius: 50%;
    background: var(--red); color: #fff;
    display: flex; align-items: center; justify-content: center;
    font-size: 1.1rem; font-weight: 800; line-height: 1.1;
    box-shadow: 0 4px 14px rgba(229,57,53,.35);
    flex-shrink: 0; margin-left: auto;
}
.preview-note {
    font-size: .75rem; color: #92400e; margin-top: 6px;
}

/* ── Toggle checkbox ── */
.toggle-check { display: flex; align-items: center; gap: 12px; cursor: pointer; }
.toggle-check input[type=checkbox] {
    width: 44px; height: 24px; appearance: none;
    border-radius: 50px; background: #d1d5db; border: none;
    cursor: pointer; position: relative; transition: background .2s; flex-shrink: 0;
}
.toggle-check input[type=checkbox]:checked { background: var(--green); }
.toggle-check input[type=checkbox]::after {
    content: ''; position: absolute;
    width: 18px; height: 18px; border-radius: 50%;
    background: #fff; top: 3px; left: 3px;
    transition: transform .2s; box-shadow: 0 1px 4px rgba(0,0,0,.2);
}
.toggle-check input[type=checkbox]:checked::after { transform: translateX(20px); }
.toggle-label { font-weight: 600; font-size: .9rem; color: #374151; }

/* ── Boutons ── */
.form-actions { display: flex; gap: 12px; align-items: center; padding-top: 8px; flex-wrap: wrap; }
.btn-submit {
    background: linear-gradient(135deg, var(--gold), var(--gold-dark));
    color: #fff; border: none; border-radius: 11px;
    padding: 13px 32px; font-weight: 700; font-size: .95rem;
    cursor: pointer; transition: transform .15s, box-shadow .15s;
    display: inline-flex; align-items: center; gap: 8px;
    box-shadow: 0 4px 14px rgba(245,158,11,.4);
}
.btn-submit:hover { transform: translateY(-2px); box-shadow: 0 6px 20px rgba(245,158,11,.5); }
.btn-cancel {
    background: var(--white); color: #374151;
    border: 1.5px solid var(--border); border-radius: 11px;
    padding: 13px 24px; font-weight: 600; font-size: .95rem;
    text-decoration: none; display: inline-flex; align-items: center; gap: 8px;
    transition: all .15s;
}
.btn-cancel:hover { border-color: #374151; color: #111; }

/* ── Sidebar : liste logements ── */
.sidebar-card {
    background: var(--white); border-radius: var(--radius);
    border: 1px solid var(--border); box-shadow: var(--shadow);
    overflow: hidden; position: relative; z-index: 2;
    position: sticky; top: 90px;
}
.sidebar-card .sc-header {
    padding: 16px 20px; border-bottom: 1px solid var(--border);
    display: flex; align-items: center; justify-content: space-between;
}
.sidebar-card .sc-header h4 {
    font-size: .9rem; font-weight: 700; margin: 0;
    display: flex; align-items: center; gap: 7px;
}
.sidebar-card .sc-header .cnt {
    background: #1e293b; color: #fff;
    border-radius: 50px; padding: 2px 10px; font-size: .72rem; font-weight: 700;
}
.log-item {
    display: flex; align-items: center; gap: 10px;
    padding: 12px 20px; border-bottom: 1px solid #f1f5f9;
    transition: background .12s;
}
.log-item:last-child { border-bottom: none; }
.log-item:hover { background: #fafafa; }
.log-item img {
    width: 38px; height: 38px; border-radius: 8px; object-fit: cover; flex-shrink: 0;
}
.log-item .log-placeholder {
    width: 38px; height: 38px; border-radius: 8px;
    background: var(--green-soft); color: var(--green);
    display: flex; align-items: center; justify-content: center; flex-shrink: 0;
}
.log-item .log-info { flex: 1; min-width: 0; }
.log-item .log-titre { font-weight: 600; font-size: .85rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.log-item .log-prix  { font-size: .75rem; color: var(--gray); }
.log-item .log-status {
    width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0;
}
.log-item .log-status.has-promo { background: var(--red); }
.log-item .log-status.free      { background: #d1d5db; }

.warning-box {
    background: #fff7ed; border: 1.5px solid var(--gold);
    border-radius: 10px; padding: 12px 16px; margin: 12px 20px;
    font-size: .8rem; color: #92400e;
    display: flex; align-items: flex-start; gap: 8px;
}
.warning-box i { flex-shrink: 0; margin-top: 1px; }
</style>
{% endblock %}

{% block body %}

{# ── Header ── #}
<div class="form-header">
    <div class="container">
        <div class="breadcrumb-bar">
            <a href="{{ path('promotion_globale_list') }}">Toutes mes promotions</a>
            <i class="bi bi-chevron-right"></i>
            <span>Appliquer à tous</span>
        </div>
        <h1><i class="bi bi-lightning-fill me-2"></i>Appliquer une promotion à tous vos logements</h1>
        <p>Saisissez les détails une seule fois — la promotion sera créée sur chaque logement éligible.</p>
    </div>
</div>

<div class="form-outer">
    <div class="container">
        <div class="form-layout">

            {# ── Colonne gauche : formulaire ── #}
            <div class="form-card">

                <div class="promo-preview">
                    <div style="flex:1">
                        <div class="preview-label">👁 Aperçu (prix moyen : {{ prixMoyen }}€)</div>
                        <div class="preview-prix-row">
                            <span class="preview-original">{{ prixMoyen }}€/nuit</span>
                            <span class="preview-reduit" id="preview-reduit">{{ prixMoyen }}€</span>
                            <span class="preview-economie" id="preview-economie">-0€</span>
                        </div>
                        <div class="preview-note">* Appliqué à {{ logements|length }} logement{{ logements|length > 1 ? 's' : '' }}</div>
                    </div>
                    <div class="preview-badge-big" id="preview-badge">0%</div>
                </div>

                {{ form_start(form, {attr: {novalidate: 'novalidate'}}) }}

                <div class="form-section-title"><i class="bi bi-info-circle"></i> Informations</div>

                <div class="mb-3">
                    {{ form_label(form.titre, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.titre, {attr: {placeholder: 'Ex: Offre Flash Été, Promo -30%...'}}) }}
                    {{ form_errors(form.titre) }}
                </div>

                <div class="mb-3">
                    {{ form_label(form.pourcentage, null, {label_attr: {class: 'form-label'}}) }}
                    <div class="pct-wrapper">
                        {{ form_widget(form.pourcentage, {attr: {
                            id: 'pourcentage-input', min: 1, max: 99,
                            placeholder: 'Ex: 25', style: 'padding-right:56px;'
                        }}) }}
                        <span class="pct-display" id="pct-display">0%</span>
                    </div>
                    {{ form_errors(form.pourcentage) }}
                </div>

                <div class="form-section-title"><i class="bi bi-calendar-range"></i> Période</div>

                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        {{ form_label(form.dateDebut, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.dateDebut) }}
                        {{ form_errors(form.dateDebut) }}
                    </div>
                    <div class="col-md-6">
                        {{ form_label(form.dateFin, null, {label_attr: {class: 'form-label'}}) }}
                        {{ form_widget(form.dateFin) }}
                        {{ form_errors(form.dateFin) }}
                    </div>
                </div>

                <div class="form-section-title"><i class="bi bi-sliders"></i> Options</div>

                <div class="mb-3">
                    {{ form_label(form.codePromo, null, {label_attr: {class: 'form-label'}}) }}
                    {{ form_widget(form.codePromo, {attr: {
                        placeholder: 'Ex: STAYZY30',
                        style: 'text-transform:uppercase; font-family:monospace; font-weight:700; letter-spacing:.05em;'
                    }}) }}
                    <div class="form-text"><i class="bi bi-info-circle me-1"></i>Le même code sera appliqué sur tous les logements</div>
                    {{ form_errors(form.codePromo) }}
                </div>

                <div class="mb-4">
                    <label class="toggle-check">
                        {{ form_widget(form.active) }}
                        <span class="toggle-label">Activer immédiatement sur tous les logements</span>
                    </label>
                </div>

                <div class="form-actions">
                    <button type="submit" class="btn-submit">
                        <i class="bi bi-lightning-fill"></i>
                        Appliquer sur {{ logements|length }} logement{{ logements|length > 1 ? 's' : '' }}
                    </button>
                    <a href="{{ path('promotion_globale_list') }}" class="btn-cancel">
                        <i class="bi bi-x-lg"></i> Annuler
                    </a>
                </div>

                {{ form_end(form) }}
            </div>

            {# ── Colonne droite : liste des logements ciblés ── #}
            <div>
                <div class="sidebar-card">
                    <div class="sc-header">
                        <h4><i class="bi bi-house-door-fill" style="color:var(--green)"></i> Logements ciblés</h4>
                        <span class="cnt">{{ logements|length }}</span>
                    </div>

                    {% set nbAvecPromo = 0 %}
                    {% for l in logements %}
                        {% if l.promoActive is not null %}{% set nbAvecPromo = nbAvecPromo + 1 %}{% endif %}
                    {% endfor %}

                    {% if nbAvecPromo > 0 %}
                        <div class="warning-box">
                            <i class="bi bi-exclamation-triangle-fill"></i>
                            <span>
                                <strong>{{ nbAvecPromo }} logement{{ nbAvecPromo > 1 ? 's' : '' }}</strong>
                                {{ nbAvecPromo > 1 ? 'ont déjà' : 'a déjà' }} une promo en cours et
                                {{ nbAvecPromo > 1 ? 'seront ignorés' : 'sera ignoré' }}.
                            </span>
                        </div>
                    {% endif %}

                    {% for l in logements %}
                        {% set aPromo = l.promoActive is not null %}
                        <div class="log-item">
                            {% if l.photoPrincipale %}
                                <img src="{{ asset('uploads/logements/' ~ l.photoPrincipale) }}" alt="{{ l.titre }}">
                            {% else %}
                                <div class="log-placeholder"><i class="bi bi-house"></i></div>
                            {% endif %}
                            <div class="log-info">
                                <div class="log-titre">{{ l.titre }}</div>
                                <div class="log-prix">
                                    {{ l.prix }}€/nuit
                                    {% if aPromo %}
                                        · <span style="color:var(--red); font-weight:600; font-size:.72rem;">⚡ Promo active</span>
                                    {% endif %}
                                </div>
                            </div>
                            <div class="log-status {{ aPromo ? 'has-promo' : 'free' }}"
                                 title="{{ aPromo ? 'Déjà en promotion' : 'Éligible' }}"></div>
                        </div>
                    {% endfor %}
                </div>
            </div>

        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}{{ parent() }}
<script>
const prixMoyen       = {{ prixMoyen }};
const pctInput        = document.getElementById('pourcentage-input');
const pctDisplay      = document.getElementById('pct-display');
const previewReduit   = document.getElementById('preview-reduit');
const previewEconomie = document.getElementById('preview-economie');
const previewBadge    = document.getElementById('preview-badge');

function updatePreview() {
    const pct      = parseInt(pctInput.value) || 0;
    const reduit   = (prixMoyen * (1 - pct / 100)).toFixed(2);
    const economie = (prixMoyen * pct / 100).toFixed(2);

    pctDisplay.textContent      = pct + '%';
    previewReduit.textContent   = reduit + '€';
    previewEconomie.textContent = '-' + economie + '€';
    previewBadge.textContent    = '-' + pct + '%';

    if (pct >= 40)      previewBadge.style.background = '#c62828';
    else if (pct >= 20) previewBadge.style.background = '#e53935';
    else                previewBadge.style.background = '#ef5350';
}

pctInput?.addEventListener('input', updatePreview);
updatePreview();

// Uppercase code promo
const codeInput = document.querySelector('input[name*="codePromo"]');
codeInput?.addEventListener('input', function() { this.value = this.value.toUpperCase(); });
</script>
{% endblock %}

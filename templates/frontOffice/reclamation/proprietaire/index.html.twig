{% extends 'frontOffice/base.html.twig' %}
{% block title %}Réclamations reçues{% endblock %}

{% block body %}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">📩 Réclamations reçues</h2>

        <div>
            <span class="badge bg-danger">
                {{ reclamations|filter(r => r.riskScore > 70)|length }} Critiques
            </span>

            <span class="badge bg-warning text-dark ms-2">
                {{ reclamations|filter(r => r.riskScore > 30 and r.riskScore <= 70)|length }} Moyennes
            </span>

            <span class="badge bg-secondary ms-2">
                {{ reclamations|filter(r => r.riskScore <= 30)|length }} Normales
            </span>
        </div>
    </div>

    <div class="card shadow border-0">
        <div class="card-body table-responsive">

            <table class="table align-middle table-hover">
                <thead class="bg-dark text-white">
                <tr>
                    <th>#</th>
                    <th>Sujet</th>
                    <th>Description</th>
                    <th>Risk</th>
                    <th>Orientation</th>
                    <th>Date</th>
                    <th>Statut</th>
                    <th>Réponse</th>
                    <th width="220">Action</th>
                </tr>
                </thead>

                <tbody>
                {% for rec in pagination %}
                    {% set target = intelligenceService.detectTargetRole(rec) %}

                    <tr>
                        <td class="fw-bold">{{ rec.id }}</td>
                        <td>{{ rec.sujet }}</td>

                        <td>
                            {% if rec.description|length > 60 %}
                                {{ rec.description|slice(0,60) }}...
                                <button class="btn btn-sm btn-link p-0"
                                        onclick="showFullDescription(`{{ rec.description|e('js') }}`)">
                                    Voir
                                </button>
                            {% else %}
                                {{ rec.description }}
                            {% endif %}

                            <div class="mt-2 d-flex gap-2">
                                <select class="form-select form-select-sm"
                                        id="lang-{{ rec.id }}"
                                        style="width:120px;">
                                    <option value="en">English</option>
                                    <option value="fr">Français</option>
                                    <option value="ar">العربية</option>
                                    <option value="de">Deutsch</option>
                                    <option value="es">Español</option>
                                </select>

                                <button class="btn btn-sm btn-outline-info"
                                        onclick="translateDescription({{ rec.id }})">
                                    🌍 Traduire
                                </button>
                            </div>
                        </td>

                        <td>
                            {% if rec.riskScore > 70 %}
                                <span class="badge bg-danger">🔥 {{ rec.riskScore }}</span>
                            {% elseif rec.riskScore > 30 %}
                                <span class="badge bg-warning text-dark">⚠ {{ rec.riskScore }}</span>
                            {% else %}
                                <span class="badge bg-success">✔ {{ rec.riskScore }}</span>
                            {% endif %}
                        </td>

                        <td>
                            {% if target == 'ADMIN' %}
                                <span class="badge bg-primary">Admin</span>
                            {% else %}
                                <span class="badge bg-info text-dark">Propriétaire</span>
                            {% endif %}
                        </td>

                        <td>{{ rec.dateReclamation|date('d/m/Y H:i') }}</td>

                        <td>
                            {% if rec.statut == 'EN_ATTENTE' %}
                                <span class="badge bg-warning text-dark">En attente</span>
                            {% else %}
                                <span class="badge bg-success">Traitée</span>
                            {% endif %}
                        </td>

                        <td>
                            {% if rec.reponses|length > 0 %}
                                {{ rec.reponses[0].contenu|slice(0,40) }}...
                            {% else %}
                                <span class="text-muted">Aucune réponse</span>
                            {% endif %}
                        </td>

                        <td>
                            {% if rec.reponses|length == 0 %}
                                <a href="{{ path('prop_reponse_new', {'id': rec.id}) }}"
                                   class="btn btn-sm btn-success">
                                   Répondre
                                </a>
                            {% else %}
                                <a href="{{ path('prop_reponse_edit', {'id': rec.reponses[0].id}) }}"
                                   class="btn btn-sm btn-primary">
                                   Modifier
                                </a>

                                <a href="{{ path('prop_reponse_delete', {'id': rec.reponses[0].id}) }}"
                                   class="btn btn-sm btn-danger"
                                   onclick="return confirm('Supprimer la réponse ?')">
                                   Supprimer
                                </a>
                            {% endif %}
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            Aucune réclamation trouvée
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>

            <!-- Pagination ajoutée seulement -->
            <div class="mt-3 d-flex justify-content-center">
                {{ knp_pagination_render(pagination) }}
            </div>

        </div>
    </div>

</div>

<!-- MODAL -->
<div class="modal fade" id="translationModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-info text-white">
                <h5 class="modal-title">🌍 Traduction</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body text-center">
                <div id="loadingSpinner" class="spinner-border text-info d-none"></div>
                <p id="translatedText" class="mt-3"></p>
            </div>
        </div>
    </div>
</div>

<script>
function showFullDescription(text) {
    alert(text);
}

function translateDescription(id) {
    let selectedLang = document.getElementById('lang-' + id).value;

    document.getElementById('translatedText').innerText = '';
    document.getElementById('loadingSpinner').classList.remove('d-none');

    var modal = new bootstrap.Modal(
        document.getElementById('translationModal')
    );

    modal.show();

    fetch('/reclamation/api/' + id + '/translate?lang=' + selectedLang)
        .then(response => response.json())
        .then(data => {
            document.getElementById('loadingSpinner').classList.add('d-none');
            document.getElementById('translatedText').innerText = data.translated;
        })
        .catch(error => {
            document.getElementById('loadingSpinner').classList.add('d-none');
            document.getElementById('translatedText').innerText = "Erreur de traduction.";
            console.error(error);
        });
}
</script>

{% endblock %}
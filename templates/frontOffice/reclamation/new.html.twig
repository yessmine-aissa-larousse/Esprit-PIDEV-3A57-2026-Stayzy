{% extends 'frontOffice/base.html.twig' %}

{% block title %}Ajouter Réclamation - Stayzy{% endblock %}

{% block body %}

<!-- Page Title -->
<div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
        <h1 class="mb-2 mb-lg-0">Ajouter une Réclamation</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="current">Réclamation</li>
            </ol>
        </nav>
    </div>
</div>
<!-- End Page Title -->

<!-- Reclamation Section -->
<section class="section">
    <div class="container" data-aos="fade-up" data-aos-delay="100">

        <div class="row justify-content-center">
            <div class="col-lg-8">

                <div class="card shadow-sm p-4">

                    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

                    <div class="mb-4">
                        {{ form_label(form.sujet, "Sujet", {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.sujet, {'attr': {'class': 'form-control'}}) }}
                        <div class="text-danger small">
                            {{ form_errors(form.sujet) }}
                        </div>
                    </div>

                    <div class="mb-4">
                        {{ form_label(form.description, "Description", {'label_attr': {'class': 'form-label'}}) }}
                        {{ form_widget(form.description, {'attr': {'class': 'form-control', 'rows': 5}}) }}
                        <div class="text-danger small">
                            {{ form_errors(form.description) }}
                        </div>
                    </div>

                    <div class="text-center">
                         <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-send"></i> Envoyer
                         </button>
                    </div>


                    {{ form_end(form) }}

                </div>

            </div>
        </div>

    </div>
</section>

{% endblock %}

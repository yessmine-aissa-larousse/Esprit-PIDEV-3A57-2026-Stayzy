{% extends 'frontOffice/base.html.twig' %}

{% block title %}{{ logement.titre }} - Stayzy{% endblock %}

{% block stylesheets %}
    {{ parent() }}
    <style>
        /* Sidebar fixe sans décalage visuel au scroll */
        .sidebar-sticky {
            position: sticky;
            top: 80px;          /* hauteur de la navbar — ajuste si besoin */
            max-height: calc(100vh - 100px);
            overflow-y: auto;
        }
    </style>
{% endblock %}

{% block body %}

<div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
        <h1 class="mb-2 mb-lg-0">{{ logement.titre }}</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                <li><a href="{{ path('proprietaire_logement_list') }}">Mes Logements</a></li>
                <li class="current">Détails</li>
            </ol>
        </nav>
    </div>
</div>

<section class="section" style="padding: 60px 0;">
    <div class="container">
        <div class="row">
            
            {# Colonne principale #}
            <div class="col-lg-8">
                
                {# Image principale #}
                {% if logement.photoPrincipale %}
                    <img src="{{ asset('uploads/logements/' ~ logement.photoPrincipale) }}" 
                         class="img-fluid rounded mb-4" 
                         style="width: 100%; height: 400px; object-fit: cover;">
                {% endif %}

                {# Description #}
                <div class="card mb-4">
                    <div class="card-body">
                        <h3>Description</h3>
                        <p>{{ logement.description|default('Aucune description disponible') }}</p>
                    </div>
                </div>

                {# Caractéristiques #}
                <div class="card mb-4">
                    <div class="card-body">
                        <h3>Caractéristiques</h3>
                        <div class="row">
                            <div class="col-md-3 mb-3">
                                <div class="text-center p-3 border rounded">
                                    <i class="bi bi-house-door fs-1 text-primary"></i>
                                    <h5 class="mt-2">{{ logement.nombreChambres }}</h5>
                                    <small class="text-muted">Chambre(s)</small>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="text-center p-3 border rounded">
                                    <i class="bi bi-droplet fs-1 text-info"></i>
                                    <h5 class="mt-2">{{ logement.nombreSalleDeBain }}</h5>
                                    <small class="text-muted">Salle(s) de bain</small>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="text-center p-3 border rounded">
                                    <i class="bi bi-arrows-angle-expand fs-1 text-success"></i>
                                    <h5 class="mt-2">{{ logement.superficie }}</h5>
                                    <small class="text-muted">m²</small>
                                </div>
                            </div>
                            <div class="col-md-3 mb-3">
                                <div class="text-center p-3 border rounded">
                                    <i class="bi bi-tag fs-1 text-warning"></i>
                                    <h5 class="mt-2">{{ logement.prix }}€</h5>
                                    <small class="text-muted">/nuit</small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                {# Équipements #}
                {% if logement.amenites %}
                    <div class="card mb-4">
                        <div class="card-body">
                            <h3>Équipements</h3>
                            <div class="row">
                                {% for amenite in logement.amenites %}
                                    <div class="col-md-4 mb-2">
                                        <i class="bi bi-check-circle text-success"></i> {{ amenite|replace({'_': ' '})|title }}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endif %}

                {# Galerie photos #}
                {% if logement.photos %}
                    <div class="card mb-4">
                        <div class="card-body">
                            <h3>Galerie photos ({{ logement.photos|length }})</h3>
                            <div class="row g-2">
                                {% for photo in logement.photos %}
                                    <div class="col-md-4">
                                        <img src="{{ asset('uploads/logements/' ~ photo) }}" 
                                             class="img-fluid rounded" 
                                             style="height: 150px; width: 100%; object-fit: cover;">
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endif %}

            </div>

            {# Sidebar #}
            <div class="col-lg-4">
                
                {# ── CORRECTION : remplacé sticky-top (top:100px) par la classe
                   sidebar-sticky définie en CSS, qui garde la carte visible
                   sans qu'elle "remonte" au-dessus du viewport au scroll ── #}
                <div class="card mb-4 sidebar-sticky">
                    <div class="card-body">
                        <h4 class="mb-4">Gestion</h4>
                        
                        {# Statut #}
                        <div class="mb-4">
                            <label class="form-label">Statut</label>
                            <div>
                                {% if logement.disponible %}
                                    <span class="badge bg-success fs-6">✅ Disponible</span>
                                {% else %}
                                    <span class="badge bg-danger fs-6">❌ Indisponible</span>
                                {% endif %}
                            </div>
                        </div>

                        {# Localisation #}
                        {% if logement.adresse %}
                            <div class="mb-4">
                                <label class="form-label">Localisation</label>
                                <p class="mb-0">
                                    <i class="bi bi-geo-alt"></i>
                                    {{ logement.adresse.rue }}<br>
                                    {{ logement.adresse.ville }}, {{ logement.adresse.codePostal }}<br>
                                    {{ logement.adresse.pays }}
                                </p>
                            </div>
                        {% endif %}

                        {# Date de publication #}
                        <div class="mb-4">
                            <label class="form-label">Publié le</label>
                            <p>{{ logement.createdAt|date('d/m/Y à H:i') }}</p>
                        </div>

                        <hr>

                        {# Actions #}
                        <div class="d-grid gap-2">
                            <a href="{{ path('proprietaire_logement_edit', {id: logement.id}) }}" 
                               class="btn btn-warning">
                                <i class="bi bi-pencil"></i> Modifier
                            </a>
                            <a href="{{ path('app_property_details', {id: logement.id}) }}" 
                               class="btn btn-outline-primary"
                               target="_blank">
                                <i class="bi bi-eye"></i> Voir l'annonce publique
                            </a>
                            <a href="{{ path('proprietaire_logement_list') }}" 
                               class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left"></i> Retour à mes logements
                            </a>
                            <hr>
                            <a href="{{ path('proprietaire_logement_delete', {id: logement.id}) }}" 
                               class="btn btn-danger"
                               onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce logement ?')">
                                <i class="bi bi-trash"></i> Supprimer
                            </a>
                        </div>
                    </div>
                </div>

            </div>

        </div>
    </div>
</section>

{% endblock %}

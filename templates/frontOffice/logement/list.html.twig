}

function clearFilter(key) {
    const map = {
        search:       'f-search',
        disponible:   'f-dispo',
        avecPromo:    'f-promo',
        ville:        'f-ville',
        prixMin:      'f-prix-min',
        prixMax:      'f-prix-max',
        chambresMin:  'f-chambres',
        superficieMin:'f-sup-min',
        superficieMax:'f-sup-max'
    };
    const el = document.getElementById(map[key]);
    if (!el) return;
    el.tagName === 'SELECT' ? (el.selectedIndex = 0) : (el.value = '');
    doFilter();
}

const LABELS = {
    search:        v => `"${v}"`,
    disponible:    v => v === '1' ? 'Disponible' : 'Indisponible',
    avecPromo:     v => v === '1' ? 'Avec promo' : 'Sans promo',
    ville:         v => v,
    prixMin:       v => `Min ${v}€`,
    prixMax:       v => `Max ${v}€`,
    chambresMin:   v => `Min ${v} ch.`,
    superficieMin: v => `Min ${v} m²`,
    superficieMax: v => `Max ${v} m²`,
};

function updateTags() {
    const f         = getFilters();
    const container = document.getElementById('filter-tags');
    container.innerHTML = '';
    for (const [key, val] of Object.entries(f)) {
        if (key === 'sortBy' || !val || val === 'all' || val === '') continue;
        const tag = document.createElement('div');
        tag.className = 'ftag';
        tag.innerHTML = `${LABELS[key]?.(val) ?? val} <button onclick="clearFilter('${key}')">×</button>`;
        container.appendChild(tag);
    }
}

['f-search','f-ville','f-prix-min','f-prix-max','f-chambres','f-sup-min','f-sup-max']
    .forEach(id => document.getElementById(id).addEventListener('input', debounceFilter));
['f-dispo','f-promo']
    .forEach(id => document.getElementById(id).addEventListener('change', doFilter));

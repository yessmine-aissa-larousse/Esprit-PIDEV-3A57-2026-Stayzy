{% block javascripts %}{{ parent() }}
<script>
const FILTER_URL = '{{ path("proprietaire_logement_filter") }}';
const ASSET_PATH = '{{ asset("uploads/logements/") }}';
let timer = null;

function getFilters() {
    return {
        search:        document.getElementById('f-search').value.trim(),
        disponible:    document.getElementById('f-dispo').value,
        avecPromo:     document.getElementById('f-promo').value,
        ville:         document.getElementById('f-ville').value.trim(),
        prixMin:       document.getElementById('f-prix-min').value,
        prixMax:       document.getElementById('f-prix-max').value,
        chambresMin:   document.getElementById('f-chambres').value,
        superficieMin: document.getElementById('f-sup-min').value,
        superficieMax: document.getElementById('f-sup-max').value,
        sortBy:        document.getElementById('f-sort').value,
    };
}

function doFilter() {
    const grid   = document.getElementById('logements-grid');
    const loader = document.getElementById('ajax-loader');
    grid.classList.add('loading');
    loader.style.display = 'block';

    fetch(FILTER_URL, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(getFilters()),
    })
    .then(r => r.json())
    .then(data => {
        loader.style.display = 'none';
        grid.classList.remove('loading');
        renderCards(data);
        updateTags();
    })
    .catch(err => {
        console.error(err);
        loader.style.display = 'none';
        grid.classList.remove('loading');
    });
}

function renderCards(logements) {
    const grid = document.getElementById('logements-grid');

    if (logements.length === 0) {
        grid.innerHTML = `
            <div class="col-12 text-center py-5">
                <i class="bi bi-search" style="font-size:60px;color:#ddd;"></i>
                <h5 class="mt-3 text-muted">Aucun logement ne correspond à vos critères</h5>
            </div>`;
        document.getElementById('results-count').textContent = 0;
        document.getElementById('total-count').textContent   = 0;
        return;
    }

    grid.innerHTML = logements.map(l => `
        <div class="col-lg-4 col-md-6">
            <div class="card h-100 shadow-sm">
                <div style="position:relative;height:200px;overflow:hidden;">
                    ${l.photoPrincipale
                        ? `<img src="${ASSET_PATH}${l.photoPrincipale}" class="card-img-top" style="height:100%;object-fit:cover;">`
                        : `<div class="bg-light d-flex align-items-center justify-content-center" style="height:100%;"><i class="bi bi-image" style="font-size:50px;color:#ccc;"></i></div>`
                    }
                    <div style="position:absolute;top:10px;right:10px;display:flex;gap:5px;flex-direction:column;align-items:flex-end;">
                        <span class="badge ${l.disponible ? 'bg-success' : 'bg-danger'}">${l.disponible ? 'Disponible' : 'Indisponible'}</span>
                        ${l.hasPromo ? `<span class="badge" style="background:#e53935;"> -${l.pourcentage}%</span>` : ''}
                    </div>
                </div>
                <div class="card-body">
                    <h5 class="card-title">${l.titre}</h5>
                    <p class="text-muted mb-2">
                        <i class="bi bi-geo-alt"></i>
                        ${l.ville ? `${l.ville}, ${l.codePostal}` : 'Non renseigné'}
                    </p>
                    <div class="d-flex gap-3 mb-3" style="font-size:14px;">
                        <span><i class="bi bi-house-door"></i> ${l.nombreChambres} ch</span>
                        <span><i class="bi bi-droplet"></i> ${l.nombreSalleDeBain} sdb</span>
                        <span><i class="bi bi-arrows-angle-expand"></i> ${l.superficie} m²</span>
                    </div>
                    <div class="mb-3">
                        ${l.hasPromo
                            ? `<h4 class="mb-0">
                                <span style="text-decoration:line-through;color:#9ca3af;font-size:.85rem;">${l.prix}€</span>
                                <span style="color:#077f46;font-weight:800;">${l.prixFinal}€</span>
                                <small class="text-muted">/nuit</small>
                               </h4>`
                            : `<h4 class="text-primary mb-0">${l.prix}€ <small class="text-muted">/nuit</small></h4>`
                        }
                    </div>
                    <div class="d-flex gap-2">
                        <a href="${l.urlVoir}" class="btn btn-sm btn-outline-primary flex-fill"><i class="bi bi-eye"></i> Voir</a>
                        <a href="${l.urlModifier}" class="btn btn-sm btn-warning flex-fill"><i class="bi bi-pencil"></i> Modifier</a>
                        <a href="${l.urlPromotion}" class="btn btn-sm btn-outline-success" title="Gérer les promotions"><i class="bi bi-tag"></i></a>
                        <a href="${l.urlSupprimer}" class="btn btn-sm btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce logement ?')"><i class="bi bi-trash"></i></a>
                    </div>
                </div>
                <div class="card-footer text-muted small">Publié le ${l.createdAt}</div>
            </div>
        </div>
    `).join('');

    document.getElementById('results-count').textContent = logements.length;
    document.getElementById('total-count').textContent   = logements.length;
}

function debounceFilter() { clearTimeout(timer); timer = setTimeout(doFilter, 350); }

function resetAll() {
    ['f-search','f-ville','f-prix-min','f-prix-max','f-chambres','f-sup-min','f-sup-max']
        .forEach(id => document.getElementById(id).value = '');
    ['f-dispo','f-promo','f-sort']
        .forEach(id => document.getElementById(id).selectedIndex = 0);

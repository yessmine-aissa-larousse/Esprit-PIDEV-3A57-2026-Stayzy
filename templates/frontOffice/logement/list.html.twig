{% extends 'frontOffice/base.html.twig' %}

{% block title %}Mes Logements - Stayzy{% endblock %}

{% block body %}

<div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
        <h1 class="mb-2 mb-lg-0">🏠 Mes Logements</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                <li class="current">Mes Logements</li>
            </ol>
        </nav>
    </div>
</div>

<section class="section" style="padding: 60px 0; background: #f8f9fa;">
    <div class="container">
        
        {# Messages Flash #}
        {% for message in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                ✅ {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}
        {% for message in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                ❌ {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        {% endfor %}

        {# Header avec bouton ajouter #}
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3>Mes annonces ({{ logements|length }})</h3>
                <p class="text-muted">Gérez vos logements publiés sur la plateforme</p>
            </div>
            <a href="{{ path('proprietaire_logement_add') }}" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Publier un logement
            </a>
        </div>

        {# Recherche #}
        <div class="card mb-4">
            <div class="card-body">
                <form method="GET" class="row g-3">
                    <div class="col-md-10">
                        <input type="text" 
                               class="form-control" 
                               name="search" 
                               placeholder="🔍 Rechercher un logement..."
                               value="{{ app.request.query.get('search') }}">
                    </div>
                    <div class="col-md-2">
                        <button type="submit" class="btn btn-primary w-100">Rechercher</button>
                    </div>
                </form>
            </div>
        </div>

        {# Liste des logements #}
        {% if logements is empty %}
            <div class="text-center py-5">
                <i class="bi bi-house-door" style="font-size: 80px; color: #ddd;"></i>
                <h4 class="mt-4">Aucun logement publié</h4>
                <p class="text-muted">Commencez par publier votre premier logement !</p>
                <a href="{{ path('proprietaire_logement_add') }}" class="btn btn-primary mt-3">
                    <i class="bi bi-plus-circle"></i> Publier mon premier logement
                </a>
            </div>
        {% else %}
            <div class="row g-4">
                {% for logement in logements %}
                    <div class="col-lg-4 col-md-6">
                        <div class="card h-100 shadow-sm">
                            {# Image #}
                            <div style="position: relative; height: 200px; overflow: hidden;">
                                {% if logement.photoPrincipale %}
                                    <img src="{{ asset('uploads/logements/' ~ logement.photoPrincipale) }}" 
                                         class="card-img-top" 
                                         style="height: 100%; object-fit: cover;">
                                {% else %}
                                    <div class="bg-light d-flex align-items-center justify-content-center" style="height: 100%;">
                                        <i class="bi bi-image" style="font-size: 50px; color: #ccc;"></i>
                                    </div>
                                {% endif %}
                                
                                {# Badge statut #}
                                <div style="position: absolute; top: 10px; right: 10px; display:flex; gap:5px; flex-direction:column; align-items:flex-end;">
                                    {% if logement.disponible %}
                                        <span class="badge bg-success">Disponible</span>
                                    {% else %}
                                        <span class="badge bg-danger">Indisponible</span>
                                    {% endif %}
                                    {% set promoActive = logement.promoActive %}
                                    {% if promoActive %}
                                        <span class="badge" style="background:#e53935;"> -{{ promoActive.pourcentage }}%</span>
                                    {% endif %}
                                </div>
                            </div>

                            <div class="card-body">
                                <h5 class="card-title">{{ logement.titre }}</h5>
                                <p class="text-muted mb-2">
                                    <i class="bi bi-geo-alt"></i>
                                    {% if logement.adresse %}
                                        {{ logement.adresse.ville }}, {{ logement.adresse.codePostal }}
                                    {% else %}
                                        Non renseigné
                                    {% endif %}
                                </p>
                                
                                {# Caractéristiques #}
                                <div class="d-flex gap-3 mb-3" style="font-size: 14px;">
                                    <span><i class="bi bi-house-door"></i> {{ logement.nombreChambres }} ch</span>
                                    <span><i class="bi bi-droplet"></i> {{ logement.nombreSalleDeBain }} sdb</span>
                                    <span><i class="bi bi-arrows-angle-expand"></i> {{ logement.superficie }} m²</span>
                                </div>

                                {# Prix #}
                                <div class="mb-3">
                                    {% set promoActive = logement.promoActive %}
                                    {% if promoActive %}
                                        <h4 class="mb-0">
                                            <span style="text-decoration:line-through; color:#9ca3af; font-size:.85rem;">{{ logement.prix }}€</span>
                                            <span style="color:#077f46; font-weight:800;">{{ promoActive.prixPromo }}€</span>
                                            <small class="text-muted">/nuit</small>
                                        </h4>
                                    {% else %}
                                        <h4 class="text-primary mb-0">{{ logement.prix }}€ <small class="text-muted">/nuit</small></h4>
                                    {% endif %}                               
                                </div>

                                {# Actions #}
                                <div class="d-flex gap-2">
                                    <a href="{{ path('proprietaire_logement_details', {id: logement.id}) }}" 
                                       class="btn btn-sm btn-outline-primary flex-fill">
                                        <i class="bi bi-eye"></i> Voir
                                    </a>
                                    <a href="{{ path('proprietaire_logement_edit', {id: logement.id}) }}" 
                                       class="btn btn-sm btn-warning flex-fill">
                                        <i class="bi bi-pencil"></i> Modifier
                                    </a>
                                    <a href="{{ path('promotion_list', {logementId: logement.id}) }}"
                                    class="btn btn-sm btn-outline-success"
                                    title="Gérer les promotions">
                                        <i class="bi bi-tag"></i>
                                    </a>
                                    <a href="{{ path('proprietaire_logement_delete', {id: logement.id}) }}" 
                                       class="btn btn-sm btn-danger"
                                       onclick="return confirm('Êtes-vous sûr de vouloir supprimer ce logement ?')">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </div>

                            <div class="card-footer text-muted small">
                                Publié le {{ logement.createdAt|date('d/m/Y') }}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}

    </div>
</section>

{% endblock %}

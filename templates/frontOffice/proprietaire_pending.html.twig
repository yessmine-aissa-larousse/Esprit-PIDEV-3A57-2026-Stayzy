{% extends 'frontOffice/base.html.twig' %}

{% block title %}Compte en attente - Stayzy{% endblock %}

{% block body %}
<section style="padding: 80px 0; background: #f8f9fa; min-height: 80vh; display: flex; align-items: center;">
<div class="container">
<div class="row justify-content-center">
<div class="col-lg-7 col-md-9">

    <div class="card border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">

        {# En-tête orange #}
        <div class="text-center py-5" style="background: linear-gradient(135deg, #f57f17, #ff8f00);">
            <div style="width: 90px; height: 90px; background: rgba(255,255,255,0.2); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px;">
                <i class="bi bi-hourglass-split text-white" style="font-size: 2.5rem;"></i>
            </div>
            <h2 class="text-white fw-bold mb-1">Demande en cours d'examen</h2>
            <p class="mb-0" style="color: rgba(255,255,255,0.85); font-size: 15px;">
                Bonjour <strong>{{ user.prenom }}</strong>, votre dossier est bien reçu.
            </p>
        </div>

        <div class="card-body p-5">

            {# Message principal #}
            <div class="alert border-0 mb-4" style="background: #fff8e1; border-left: 4px solid #f57f17 !important; border-radius: 10px;">
                <p class="mb-0" style="color: #5d4037; font-size: 15px;">
                    <i class="bi bi-info-circle me-2 text-warning"></i>
                    Votre compte propriétaire est actuellement <strong>en attente de validation</strong> par notre équipe.
                    Vous ne pouvez pas accéder à votre espace tant que votre dossier n'est pas approuvé.
                </p>
            </div>

            {# Étapes #}
            <h6 class="fw-bold text-muted mb-3 text-uppercase" style="font-size: 12px; letter-spacing: 1px;">
                Processus de validation
            </h6>
            <div class="d-flex flex-column gap-3 mb-4">

                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 bg-success text-white" style="width: 34px; height: 34px; font-size: 14px;">
                        <i class="bi bi-check-lg"></i>
                    </div>
                    <div>
                        <strong>Inscription complétée</strong>
                        <p class="text-muted small mb-0">Votre demande a été soumise le {{ user.createdAt|date('d/m/Y à H:i') }}</p>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 text-white" style="width: 34px; height: 34px; font-size: 14px; background: #f57f17;">
                        <i class="bi bi-hourglass-split"></i>
                    </div>
                    <div>
                        <strong>Vérification en cours</strong>
                        <p class="text-muted small mb-0">Notre équipe examine votre dossier (délai habituel : 24-48h)</p>
                    </div>
                </div>

                <div class="d-flex align-items-start gap-3">
                    <div class="rounded-circle d-flex align-items-center justify-content-center flex-shrink-0 bg-light text-muted" style="width: 34px; height: 34px; font-size: 14px; border: 2px dashed #ccc;">
                        <i class="bi bi-unlock"></i>
                    </div>
                    <div>
                        <strong class="text-muted">Accès à votre espace</strong>
                        <p class="text-muted small mb-0">Vous recevrez un email dès que votre compte sera activé</p>
                    </div>
                </div>

            </div>

            {# Règles de la plateforme #}
            <div class="card border-0 mb-4" style="background: #f8f9fa; border-radius: 12px;">
                <div class="card-body p-4">
                    <h6 class="fw-bold mb-3">
                        <i class="bi bi-shield-check me-2 text-success"></i>Règles de la plateforme
                    </h6>
                    <ul class="list-unstyled mb-0">
                        <li class="mb-2">
                            <i class="bi bi-check2-circle text-success me-2"></i>
                            Chaque propriétaire est vérifié manuellement avant d'accéder à la plateforme
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check2-circle text-success me-2"></i>
                            Vos logements publiés doivent être réels et conformes aux photos
                        </li>
                        <li class="mb-2">
                            <i class="bi bi-check2-circle text-success me-2"></i>
                            Tout contenu frauduleux entraîne la suspension immédiate du compte
                        </li>
                        <li>
                            <i class="bi bi-check2-circle text-success me-2"></i>
                            Stayzy prélève une commission de 5% sur chaque réservation confirmée
                        </li>
                    </ul>
                </div>
            </div>

            {# Actions #}
            <div class="d-flex gap-2">
                <a href="{{ path('app_logout') }}" class="btn btn-outline-secondary flex-grow-1" style="border-radius: 10px;">
                    <i class="bi bi-box-arrow-right me-2"></i>Se déconnecter
                </a>
                <a href="mailto:contact@stayzy.com" class="btn text-white flex-grow-1" style="background: #f57f17; border-radius: 10px;">
                    <i class="bi bi-envelope me-2"></i>Contacter le support
                </a>
            </div>

        </div>
    </div>

</div>
</div>
</div>
</section>
{% endblock %}

{% extends 'frontOffice/base.html.twig' %}

{% block title %}Stayzy - Trouvez votre logement idéal{% endblock %}

{% block body %}

    <!-- Hero Section -->
    <section id="hero" class="hero section">
      <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="hero-wrapper">
          <div class="row g-4">

            <div class="col-lg-7">
              <div class="hero-content" data-aos="zoom-in" data-aos-delay="200">
                <div class="content-header">
                  <span class="hero-label">
                    <i class="bi bi-house-heart"></i>
                    Votre prochain logement vous attend
                  </span>
                  <h1>Trouvez le logement parfait pour votre séjour</h1>
                  <p>Découvrez notre sélection de logements vérifiés et réservez en toute confiance. Des appartements cosy aux villas de luxe, trouvez l'endroit idéal pour votre prochain séjour.</p>
                </div>

                {# BARRE DE RECHERCHE FONCTIONNELLE #}
                <div class="search-container" data-aos="fade-up" data-aos-delay="300">
                  <div class="search-header">
                    <h3>Commencez votre recherche</h3>
                    <p>Des centaines de logements disponibles</p>
                  </div>

                  <form action="{{ path('app_properties') }}" method="GET" class="property-search-form">
                    <div class="search-grid">
                      
                      {# Localisation #}
                      <div class="search-field">
                        <label for="search-location" class="field-label">Localisation</label>
                        <input type="text" 
                               id="search-location" 
                               name="ville" 
                               placeholder="Ville ou code postal">
                        <i class="bi bi-geo-alt field-icon"></i>
                      </div>

                      {# Type de logement #}
                      <div class="search-field">
                        <label for="search-type" class="field-label">Type de logement</label>
                        <select id="search-type" name="categorie">
                          <option value="">Tous types</option>
                          {% for categorie in categories %}
                            <option value="{{ categorie.id }}">{{ categorie.nom }}</option>
                          {% endfor %}
                        </select>
                        <i class="bi bi-building field-icon"></i>
                      </div>

                      {# Budget #}
                      <div class="search-field">
                        <label for="search-budget" class="field-label">Budget par nuit</label>
                        <select id="search-budget" name="prix_max">
                          <option value="">Tout budget</option>
                          <option value="50">≤ 50€</option>
                          <option value="100">≤ 100€</option>
                          <option value="150">≤ 150€</option>
                          <option value="200">≤ 200€</option>
                          <option value="300">≤ 300€</option>
                        </select>
                        <i class="bi bi-currency-euro field-icon"></i>
                      </div>

                      {# Chambres #}
                      <div class="search-field">
                        <label for="search-rooms" class="field-label">Chambres</label>
                        <select id="search-rooms" name="chambres">
                          <option value="any">Toutes</option>
                          <option value="1">1+</option>
                          <option value="2">2+</option>
                          <option value="3">3+</option>
                          <option value="4">4+</option>
                        </select>
                        <i class="bi bi-door-open field-icon"></i>
                      </div>
                    </div>

                    <button type="submit" class="search-btn">
                      <i class="bi bi-search"></i>
                      <span>Rechercher</span>
                    </button>
                  </form>
                </div>

                {# Stats dynamiques #}
                <div class="achievement-grid" data-aos="fade-up" data-aos-delay="400">
                  <div class="achievement-item">
                    <div class="achievement-number">
                      <span data-purecounter-start="0" 
                            data-purecounter-end="{{ logementsFeatured|length }}" 
                            data-purecounter-duration="1" 
                            class="purecounter"></span>+
                    </div>
                    <span class="achievement-text">Logements disponibles</span>
                  </div>
                  <div class="achievement-item">
                    <div class="achievement-number">
                      <span data-purecounter-start="0" 
                            data-purecounter-end="{{ categories|length }}" 
                            data-purecounter-duration="1" 
                            class="purecounter"></span>
                    </div>
                    <span class="achievement-text">Types de logements</span>
                  </div>
                  <div class="achievement-item">
                    <div class="achievement-number">
                      <span data-purecounter-start="0" 
                            data-purecounter-end="100" 
                            data-purecounter-duration="1" 
                            class="purecounter"></span>%
                    </div>
                    <span class="achievement-text">Satisfaction client</span>
                  </div>
                </div>
              </div>
            </div><!-- End Hero Content -->

            <div class="col-lg-5">
              <div class="hero-visual" data-aos="fade-left" data-aos-delay="400">
                <div class="visual-container">
                  
                  {# Logement vedette (le plus récent) #}
                  {% if logementsFeatured|length > 0 %}
                    {% set firstLogement = logementsFeatured[0] %}
                    <div class="featured-property">
                      <a href="{{ path('app_property_details', {id: firstLogement.id}) }}">
                        {% if firstLogement.photoPrincipale %}
                          <img src="{{ asset('uploads/logements/' ~ firstLogement.photoPrincipale) }}" 
                               alt="{{ firstLogement.titre }}" 
                               class="img-fluid">
                        {% else %}
                          <img src="{{ asset('frontOffice/img/real-estate/property-exterior-8.webp') }}" 
                               alt="Featured Property" 
                               class="img-fluid">
                        {% endif %}
                        <div class="property-info">
                          <div class="property-price">{{ firstLogement.prix }}€ <small>/nuit</small></div>
                          <div class="property-details">
                            <span>
                              <i class="bi bi-geo-alt"></i> 
                              {{ firstLogement.adresse.ville|default('') }}
                            </span>
                            <span>
                              <i class="bi bi-house"></i> 
                              {{ firstLogement.nombreChambres }} ch, {{ firstLogement.nombreSalleDeBain }} sdb
                            </span>
                          </div>
                        </div>
                      </a>
                    </div>

                    {# Images superposées (2e et 3e logements) #}
                    <div class="overlay-images">
                      {% if logementsFeatured|length > 1 %}
                        <div class="overlay-img overlay-1">
                          {% if logementsFeatured[1].photoPrincipale %}
                            <img src="{{ asset('uploads/logements/' ~ logementsFeatured[1].photoPrincipale) }}" 
                                 alt="{{ logementsFeatured[1].titre }}" 
                                 class="img-fluid">
                          {% else %}
                            <img src="{{ asset('frontOffice/img/real-estate/property-interior-4.webp') }}" 
                                 alt="Interior View" 
                                 class="img-fluid">
                          {% endif %}
                        </div>
                      {% endif %}
                      
                      {% if logementsFeatured|length > 2 %}
                        <div class="overlay-img overlay-2">
                          {% if logementsFeatured[2].photoPrincipale %}
                            <img src="{{ asset('uploads/logements/' ~ logementsFeatured[2].photoPrincipale) }}" 
                                 alt="{{ logementsFeatured[2].titre }}" 
                                 class="img-fluid">
                          {% else %}
                            <img src="{{ asset('frontOffice/img/real-estate/property-exterior-2.webp') }}" 
                                 alt="Exterior View" 
                                 class="img-fluid">
                          {% endif %}
                        </div>
                      {% endif %}
                    </div>
                  {% else %}
                    {# Fallback si aucun logement #}
                    <div class="featured-property">
                      <img src="{{ asset('frontOffice/img/real-estate/property-exterior-8.webp') }}" 
                           alt="Featured Property" 
                           class="img-fluid">
                    </div>
                  {% endif %}

                </div>
              </div>
            </div><!-- End Hero Visual -->

          </div>
        </div>
      </div>
    </section><!-- /Hero Section -->

    <!-- Featured Properties Section -->
    <section id="featured-properties" class="properties section light-background">
      <div class="container" data-aos="fade-up" data-aos-delay="100">
        
        <div class="section-title text-center mb-5">
          <span class="section-label">Nos logements</span>
          <h2>Logements récemment ajoutés</h2>
          <p>Découvrez notre sélection de logements de qualité</p>
        </div>

        {% if logementsFeatured|length > 0 %}
          <div class="row g-4">
            {% for logement in logementsFeatured|slice(0, 6) %}
              <div class="col-lg-4 col-md-6" data-aos="fade-up" data-aos-delay="{{ 100 + (loop.index * 50) }}">
                <div class="property-item">
                  <a href="{{ path('app_property_details', {id: logement.id}) }}" class="property-link">
                    <div class="property-image-wrapper">
                      {% if logement.photoPrincipale %}
                        <img src="{{ asset('uploads/logements/' ~ logement.photoPrincipale) }}" 
                             alt="{{ logement.titre }}" 
                             class="img-fluid">
                      {% else %}
                        <img src="{{ asset('frontOffice/img/real-estate/property-exterior-' ~ (loop.index % 9 + 1) ~ '.webp') }}" 
                             alt="{{ logement.titre }}" 
                             class="img-fluid">
                      {% endif %}
                      
                      <div class="property-status">
                        <span class="status-badge sale">Disponible</span>
                        {% if logement.categorie %}
                          <span class="status-badge featured">{{ logement.categorie.nom }}</span>
                        {% endif %}
                        {% set promoActive = logement.promoActive %}
                        {% if promoActive %}
                            <span class="status-badge" style="background:#e53935; color:#fff;"> -{{ promoActive.pourcentage }}%</span>
                        {% endif %}
                      </div>
                      
                      <div class="property-actions">
                          <button class="action-btn favorite-btn" 
                              data-logement-id="{{ logement.id }}"
                              title="Ajouter aux favoris">
                              <i class="bi bi-heart"></i>
                          </button>
                      </div>
                    </div>
                  </a>
                  
                  <div class="property-details">
                    <a href="{{ path('app_property_details', {id: logement.id}) }}" class="property-link">
                      <div class="property-header">
                        {% set promoActive = logement.promoActive %}
                        {% if promoActive %}
                            <div class="property-price">
                                {{ promoActive.prixPromo }}€ <span>/nuit</span>
                                <span style="text-decoration:line-through; color:#9ca3af; font-size:.8rem; font-weight:400; margin-left:4px;">{{ logement.prix }}€</span>
                            </div>
                        {% else %}
                            <div class="property-price">{{ logement.prix }}€ <span>/nuit</span></div>
                        {% endif %}                        
                        {% if logement.categorie %}
                          <div class="property-type">{{ logement.categorie.nom }}</div>
                        {% endif %}
                      </div>
                      
                      <h4 class="property-title">{{ logement.titre }}</h4>
                      
                      <p class="property-address">
                        <i class="bi bi-geo-alt"></i>
                        {% if logement.adresse %}
                          {{ logement.adresse.ville|default('') }}, {{ logement.adresse.pays|default('') }}
                        {% else %}
                          Localisation non renseignée
                        {% endif %}
                      </p>
                      
                      <div class="property-specs">
                        <div class="spec-item">
                          <i class="bi bi-house-door"></i>
                          <span>{{ logement.nombreChambres }} ch</span>
                        </div>
                        <div class="spec-item">
                          <i class="bi bi-droplet"></i>
                          <span>{{ logement.nombreSalleDeBain }} sdb</span>
                        </div>
                        <div class="spec-item">
                          <i class="bi bi-arrows-angle-expand"></i>
                          <span>{{ logement.superficie }} m²</span>
                        </div>
                      </div>
                    </a>
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="alert alert-info text-center">
            <i class="bi bi-info-circle"></i>
            Aucun logement disponible pour le moment.
          </div>
        {% endif %}

      </div>
    </section><!-- /Featured Properties Section -->

    <!-- Home About Section -->
    <section id="home-about" class="home-about section">
      <div class="container" data-aos="fade-up" data-aos-delay="100">
        <div class="row gy-5">

          <div class="col-lg-5" data-aos="zoom-in" data-aos-delay="200">
            <div class="image-gallery">
              <div class="primary-image">
                <img src="{{ asset('frontOffice/img/real-estate/property-exterior-1.webp') }}" alt="Modern Property" class="img-fluid">
                <div class="experience-badge">
                  <div class="badge-content">
                    <div class="number"><span data-purecounter-start="0" data-purecounter-end="5" data-purecounter-duration="1" class="purecounter"></span>+</div>
                    <div class="text">Années<br>d'expérience</div>
                  </div>
                </div>
              </div>
              <div class="secondary-image">
                <img src="{{ asset('frontOffice/img/real-estate/property-interior-4.webp') }}" alt="Luxury Interior" class="img-fluid">
              </div>
            </div>
          </div>

          <div class="col-lg-7" data-aos="fade-left" data-aos-delay="300">
            <div class="content">
              <div class="section-header">
                <span class="section-label">À propos de Stayzy</span>
                <h2>Votre partenaire de confiance pour trouver le logement idéal</h2>
              </div>

              <p>Depuis notre création, nous nous engageons à faciliter la recherche de logements pour nos clients. Notre plateforme offre une expérience simplifiée et sécurisée pour trouver votre prochain chez-vous.</p>

              <div class="achievements-list">
                <div class="achievement-item">
                  <div class="achievement-icon">
                    <i class="bi bi-house-door"></i>
                  </div>
                  <div class="achievement-content">
                    <h4><span data-purecounter-start="0" data-purecounter-end="{{ logementsFeatured|length }}" data-purecounter-duration="2" class="purecounter"></span>+ Logements</h4>
                    <p>Disponibles sur notre plateforme</p>
                  </div>
                </div>
                <div class="achievement-item">
                  <div class="achievement-icon">
                    <i class="bi bi-people"></i>
                  </div>
                  <div class="achievement-content">
                    <h4><span data-purecounter-start="0" data-purecounter-end="100" data-purecounter-duration="1" class="purecounter"></span>% Satisfaction</h4>
                    <p>Nos clients nous recommandent</p>
                  </div>
                </div>
              </div>

              <div class="action-section">
                <a href="{{ path('app_properties') }}" class="btn-cta">
                  <span>Découvrir nos logements</span>
                  <i class="bi bi-arrow-right"></i>
                </a>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section><!-- /Home About Section -->

{% endblock %}

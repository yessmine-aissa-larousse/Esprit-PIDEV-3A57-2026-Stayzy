{% extends 'frontOffice/base.html.twig' %}

{% block title %}Répondre à la réclamation{% endblock %}

{% block body %}

<!-- Page Title -->

<div class="page-title light-background">
    <div class="container d-lg-flex justify-content-between align-items-center">
        <h1 class="mb-2 mb-lg-0">Répondre à la réclamation</h1>
        <nav class="breadcrumbs">
            <ol>
                <li><a href="{{ path('app_home') }}">Accueil</a></li>
                <li><a href="{{ path('prop_reclamations') }}">Réclamations reçues</a></li>
                <li class="current">Répondre</li>
            </ol>
        </nav>
    </div>
</div>

<section class="section">
<div class="container">


<div class="row justify-content-center">
    <div class="col-lg-8">

        <h4 class="mb-4">
            Réclamation #{{ reclamation.id }}
        </h4>

        <div class="card shadow-sm border-0 p-4">

            {{ form_start(form) }}

            <div class="mb-4">
                <label class="form-label fw-semibold">
                    Votre réponse
                </label>

                {{ form_widget(form.contenu, {
                    'attr': {
                        'class': 'form-control',
                        'rows': 6,
                        'placeholder': 'Écrire votre réponse ici...'
                    }
                }) }}

                <div class="text-danger small mt-1">
                    {{ form_errors(form.contenu) }}
                </div>
            </div>

            <div class="d-flex justify-content-between">

                <a href="{{ path('prop_reclamations') }}"
                   class="btn btn-outline-secondary">
                    Annuler
                </a>

                <button class="btn btn-success px-4">
                    Envoyer la réponse
                </button>

            </div>

            {{ form_end(form) }}

        </div>

    </div>
</div>


</div>
</section>

{% endblock %}

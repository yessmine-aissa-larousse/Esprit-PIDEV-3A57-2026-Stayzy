{% block javascripts %}
    {{ parent() }}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
    // ════════════════════════════════════════
    // FIX SWIPER HERO — init en JS pur
    // (le init-swiper via JSON config entrait
    //  en conflit avec les boutons next/prev)
    // ════════════════════════════════════════
    document.addEventListener('DOMContentLoaded', function() {

        // Hero swiper
        if (document.getElementById('heroSwiper')) {
            new Swiper('#heroSwiper', {
                loop:  true,
                speed: 900,
                autoplay: { delay: 5000, disableOnInteraction: false },
                navigation: {
                    nextEl: '#heroNext',
                    prevEl: '#heroPrev'
                }
            });
        }

        // Similaires swiper
        if (document.getElementById('simSwiper')) {
            new Swiper('#simSwiper', {
                slidesPerView: 'auto',
                spaceBetween: 20,
                freeMode: true,
                navigation: {
                    nextEl: '#simNext',
                    prevEl: '#simPrev'
                },
                breakpoints: {
                    0:   { slidesPerView: 1.2, spaceBetween: 14 },
                    576: { slidesPerView: 2.1, spaceBetween: 18 },
                    992: { slidesPerView: 3.2, spaceBetween: 20 }
                }
            });
        }

        // Favoris
        document.querySelectorAll('.favorite-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                this.classList.toggle('active');
                const ico = this.querySelector('i');
                ico.className = this.classList.contains('active')
                    ? 'bi bi-heart-fill'
                    : 'bi bi-heart';
            });
        });

        // ════════════════════════════════════════
        // VARIABLES COMMUNES (lat/lng/adresse)
        // ← déclarées EN PREMIER pour être
        //   disponibles partout dans le bloc
        // ════════════════════════════════════════
        const latSaved     = parseFloat('{{ logement.adresse.latitude|default("")|e("js") }}') || null;
        const lngSaved     = parseFloat('{{ logement.adresse.longitude|default("")|e("js") }}') || null;
        const adresseTexte = '{{ ((logement.adresse.rue|default("")) ~ " " ~ (logement.adresse.ville|default("")) ~ " " ~ (logement.adresse.pays|default("")))|trim|e("js") }}';
        const popupTexte   = '<strong>{{ logement.titre|e("js") }}</strong><br>{{ logement.adresse.ville|default("")|e("js") }}';

        // ════════════════════════════════════════
        // MÉTÉO — OpenWeatherMap API
        // ════════════════════════════════════════
        const OWM_KEY    = 'b4f744b95d35ca8b42d5493363d9e6a0';
        const villeMeteo = '{{ logement.adresse.ville|default("")|e("js") }}';
        const paysMeteo  = '{{ logement.adresse.pays|default("")|e("js") }}';

        // Icônes emoji selon le code météo OWM
        function owmEmoji(code) {
            if (code >= 200 && code < 300) return '⛈️';
            if (code >= 300 && code < 400) return '🌦️';
            if (code >= 500 && code < 600) return '🌧️';
            if (code >= 600 && code < 700) return '❄️';
            if (code >= 700 && code < 800) return '🌫️';
            if (code === 800)              return '☀️';
            if (code === 801)              return '🌤️';
            if (code === 802)              return '⛅';
            if (code >= 803)              return '☁️';
            return '🌡️';
        }

        function afficherMeteo(data) {
            const temp    = Math.round(data.main.temp);
            const feels   = Math.round(data.main.feels_like);
            const desc    = data.weather[0].description;
            const code    = data.weather[0].id;
            const hum     = data.main.humidity;
            const wind    = Math.round(data.wind.speed * 3.6); // m/s → km/h
            const vis     = Math.round((data.visibility || 10000) / 1000);
            const pressure= data.main.pressure;
            const city    = data.name;
            const emoji   = owmEmoji(code);

            // Remplir badge hero
            document.getElementById('wh-icon').textContent  = emoji;
            document.getElementById('wh-temp').textContent  = temp + '°C';
            document.getElementById('wh-desc').textContent  = desc;
            document.getElementById('wh-city').textContent  = city;
            document.getElementById('weather-hero-badge').style.display = 'flex';

            // Remplir card détail
            document.getElementById('wd-city-title').textContent = city;
            document.getElementById('wd-temp').textContent      = temp;
            document.getElementById('wd-feels').textContent     = feels;
            document.getElementById('wd-icon').textContent      = emoji;
            document.getElementById('wd-desc').textContent      = desc;
            document.getElementById('wd-city').textContent      = city;
            document.getElementById('wd-hum').textContent       = hum;
            document.getElementById('wd-wind').textContent      = wind;
            document.getElementById('wd-vis').textContent       = vis;
            document.getElementById('wd-pressure').textContent  = pressure;

            document.getElementById('wd-loading').style.display = 'none';
            document.getElementById('wd-content').style.display = 'block';
        }

        function erreurMeteo() {
            document.getElementById('wd-loading').style.display  = 'none';
            document.getElementById('wd-error').style.display    = 'block';
            document.getElementById('wd-city-title').textContent = 'Indisponible';
        }

        function fetchMeteoParLatLng(lat, lng) {
            fetch('https://api.openweathermap.org/data/2.5/weather'
                + '?lat='   + lat
                + '&lon='   + lng
                + '&units=metric'
                + '&lang=fr'
                + '&appid=' + OWM_KEY)
            .then(r => r.json())
            .then(function(d) {
                if (d.cod === 200) afficherMeteo(d);
                else fetchMeteoParVille();   // fallback par ville
            })
            .catch(fetchMeteoParVille);
        }

        function fetchMeteoParVille() {
            if (!villeMeteo) { erreurMeteo(); return; }
            const q = villeMeteo + (paysMeteo ? ',' + paysMeteo : '');
            fetch('https://api.openweathermap.org/data/2.5/weather'
                + '?q='     + encodeURIComponent(q)
                + '&units=metric'
                + '&lang=fr'
                + '&appid=' + OWM_KEY)
            .then(r => r.json())
            .then(function(d) {
                if (d.cod === 200) afficherMeteo(d);
                else erreurMeteo();
            })
            .catch(erreurMeteo);
        }

        // Lancer la météo : priorité lat/lng enregistrés, sinon ville
        if (latSaved && lngSaved) {
            fetchMeteoParLatLng(latSaved, lngSaved);
        } else if (adresseTexte.trim()) {
            // Essayer de geocoder l'adresse pour obtenir lat/lng, puis météo
            fetch('https://nominatim.openstreetmap.org/search'
                + '?q=' + encodeURIComponent(adresseTexte)
                + '&format=json&limit=1&accept-language=fr')
            .then(r => r.json())
            .then(function(res) {
                if (res && res.length > 0) {
                    fetchMeteoParLatLng(parseFloat(res[0].lat), parseFloat(res[0].lon));
                } else {
                    fetchMeteoParVille();
                }
            })
            .catch(fetchMeteoParVille);
        } else {
            fetchMeteoParVille();
        }


        // ════════════════════════════════════════
        // MINI-CARTE LEAFLET
        // ════════════════════════════════════════

        function initMap(lat, lng) {
            const map = L.map('map-detail', { scrollWheelZoom: false }).setView([lat, lng], 15);
            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                attribution: '© OpenStreetMap'
            }).addTo(map);
            L.marker([lat, lng]).addTo(map).bindPopup(popupTexte).openPopup();

            // Fix définitif : forcer le conteneur Leaflet à rester
            // dans son propre stacking context, sous la navbar
            const pane = map.getPane('mapPane');
            if (pane) pane.style.zIndex = '0';

            // Baisser le z-index du container de contrôles
            const controlContainer = document.querySelector('#map-detail .leaflet-control-container');
            if (controlContainer) controlContainer.style.zIndex = '1';
        }

        if (latSaved && lngSaved) {
            initMap(latSaved, lngSaved);
        } else if (adresseTexte.trim()) {
            fetch('https://nominatim.openstreetmap.org/search'
                + '?q=' + encodeURIComponent(adresseTexte)
                + '&format=json&limit=1&accept-language=fr')
            .then(r => r.json())
            .then(function(res) {
                if (res && res.length > 0) {
                    initMap(parseFloat(res[0].lat), parseFloat(res[0].lon));
                } else {
                    document.getElementById('map-detail').closest('.section-card').style.display = 'none';
                }
            }).catch(function() {
                document.getElementById('map-detail').closest('.section-card').style.display = 'none';
            });
        } else {
            document.getElementById('map-detail').closest('.section-card').style.display = 'none';
        }

    }); // end DOMContentLoaded
    </script>
{% endblock %}

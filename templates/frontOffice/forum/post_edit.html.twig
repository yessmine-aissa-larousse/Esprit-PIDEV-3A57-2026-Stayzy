{% extends 'frontOffice/base.html.twig' %}

{% block title %}Modifier le post - Forum{% endblock %}

{% block body %}
    <section class="blog-details section">
        <div class="container" data-aos="fade-up">
            <div class="section-header">
                <h2 class="title">Modifier votre post</h2>
                <p>Vous pouvez mettre à jour le contenu de votre discussion.</p>
            </div>
            {% for message in app.flashes('error') %}
                <div class="alert alert-danger">{{ message }}</div>
            {% endfor %}
            {% for message in app.flashes('success') %}
                <div class="alert alert-success">{{ message }}</div>
            {% endfor %}
            {{ form_start(form, {attr: {class: 'comment-form', enctype: 'multipart/form-data'}}) }}
            <div class="mb-3">
                {{ form_label(form.title) }}
                {{ form_widget(form.title) }}
                {{ form_errors(form.title) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.content) }}
                {{ form_widget(form.content) }}
                {{ form_errors(form.content) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.excerpt) }}
                {{ form_widget(form.excerpt) }}
                {{ form_errors(form.excerpt) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.author) }}
                {{ form_widget(form.author) }}
                {{ form_errors(form.author) }}
            </div>
            <div class="mb-3">
                {{ form_label(form.image) }}
                {{ form_widget(form.image) }}
                {{ form_errors(form.image) }}
            </div>
            <div class="mb-4 d-none">
                {{ form_widget(form.isPublished) }}
            </div>
            <button type="submit" class="btn btn-primary">Enregistrer</button>
            <a href="{{ path('forum_post_show', {id: post.id}) }}" class="btn btn-outline-secondary ms-2">Annuler</a>
            {{ form_end(form) }}
        </div>
    </section>
    <script>
        // Function to set forum author in localStorage
        function setStoredAuthor(author) {
            if (author && author.trim()) {
                localStorage.setItem('forumAuthor', author.trim());
                return true;
            }
            return false;
        }

        document.addEventListener('DOMContentLoaded', function() {
            // Save author to localStorage when typing
            document.querySelectorAll('input[name*="[author]"]').forEach(function(input) {
                // Save on input (as user types)
                input.addEventListener('input', function() {
                    setStoredAuthor(this.value);
                });
                
                // Save on blur (when user leaves the field)
                input.addEventListener('blur', function() {
                    setStoredAuthor(this.value);
                });
                
                // Also save on form submit as backup
                input.form?.addEventListener('submit', function() {
                    setStoredAuthor(input.value);
                });
            });
        });
    </script>
{% endblock %}

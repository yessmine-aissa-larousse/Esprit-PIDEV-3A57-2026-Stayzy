{% extends 'frontOffice/base.html.twig' %}

{% block title %}{{ post.title }} - Forum{% endblock %}

{% block body %}
    <!-- Blog Details Section -->
    <section class="blog-details section">
        <div class="container" data-aos="fade-up">
            <article>
                <div class="article-header">
                    <h1 class="title">{{ post.title }}</h1>
                    <div class="article-meta">
                        <div class="author">
                            <div class="author-img">
                                <img src="https://ui-avatars.com/api/?name={{ post.author|url_encode }}&background=random" alt="{{ post.author }}" width="60" height="60" />
                            </div>
                            <div class="author-info">
                                <h4>{{ post.author }}</h4>
                                <span>Auteur</span>
                            </div>
                        </div>
                        <div class="post-info">
                            <span><i class="bi bi-calendar3"></i> {{ post.createdAt|date('d M Y') }}</span>
                            <span><i class="bi bi-chat-dots"></i> {{ post.commentsCount }} commentaire{{ post.commentsCount > 1 ? 's' : '' }}</span>
                        </div>
                    </div>
                </div>

                <div class="article-wrapper">
                    <div class="article-content">
                        <div class="content-section">
                            {% if post.excerpt %}
                                <p class="lead">{{ post.excerpt }}</p>
                            {% endif %}
                            <div class="content-body">
                                {{ post.content|nl2br }}
                            </div>
                        </div>
                    </div>
                </div>
            </article>

            <!-- Comments Section -->
            <div class="blog-comments mt-5">
                <div class="comments-header">
                    <h3 class="title">Commentaires</h3>
                    <div class="comments-stats">
                        <span class="count">{{ post.commentsCount }}</span>
                        <span class="label">commentaires</span>
                    </div>
                </div>

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">{{ message }}</div>
                {% endfor %}

                <!-- Comment Form -->
                <div class="blog-comment-form mb-5">
                    <div class="form-header">
                        <h3>Laisser un commentaire</h3>
                        <p>Votre adresse email ne sera pas publiée.</p>
                    </div>
                    {{ form_start(form, {attr: {class: 'comment-form'}}) }}
                    <div class="input-group mb-3">
                        {{ form_label(form.author) }}
                        {{ form_widget(form.author, {attr: {placeholder: 'Votre nom'}}) }}
                        {{ form_errors(form.author) }}
                    </div>
                    <div class="input-group mb-3">
                        {{ form_label(form.content) }}
                        {{ form_widget(form.content, {attr: {placeholder: 'Votre commentaire...'}}) }}
                        {{ form_errors(form.content) }}
                    </div>
                    <button type="submit" class="btn btn-primary">Publier le commentaire</button>
                    {{ form_end(form) }}
                </div>

                <!-- Comments List -->
                <div class="comments-container">
                    {% for comment in post.comments %}
                        <div class="comment-thread">
                            <div class="comment-box">
                                <div class="comment-wrapper">
                                    <div class="avatar-wrapper">
                                        <img src="https://ui-avatars.com/api/?name={{ comment.author|url_encode }}&background=random" alt="{{ comment.author }}" />
                                    </div>
                                    <div class="comment-content">
                                        <div class="comment-header">
                                            <div class="user-info">
                                                <h4>{{ comment.author }}</h4>
                                                <span class="time-badge">
                                                    <i class="bi bi-clock"></i> {{ comment.createdAt|date('d M Y à H:i') }}
                                                </span>
                                            </div>
                                        </div>
                                        <div class="comment-body">
                                            <p>{{ comment.content|nl2br }}</p>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <p class="text-muted">Aucun commentaire pour le moment. Soyez le premier à réagir !</p>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>
{% endblock %}

{% extends 'frontOffice/base.html.twig' %}

{% block title %}{{ post.title }} - Forum{% endblock %}

{% block body %}
    <!-- Blog Details Section -->
    <section class="blog-details section">
        <div class="container" data-aos="fade-up">
            <article>
                <div class="article-header">
                    <h1 class="title">{{ post.title }}</h1>
                    <div class="article-meta">
                        <div class="author">
                            <div class="author-img">
                                <img src="https://ui-avatars.com/api/?name={{ post.author|url_encode }}&background=random" alt="{{ post.author }}" width="60" height="60" />
                            </div>
                            <div class="author-info">
                                <h4>{{ post.author }}</h4>
                                <span>Auteur</span>
                            </div>
                        </div>
                        <div class="post-info">
                            <span><i class="bi bi-calendar3"></i> {{ post.createdAt|date('d M Y') }}</span>
                            <span><i class="bi bi-chat-dots"></i> {{ post.commentsCount }} commentaire{{ post.commentsCount > 1 ? 's' : '' }}</span>
                            <span class="avis-wrap d-flex gap-2 align-items-center">
                                <form method="post" action="{{ path('forum_post_avis', {id: post.id}) }}" class="d-inline">
                                    <button type="submit" class="btn btn-link btn-sm p-0 text-decoration-none" title="J'aime">
                                        <i class="bi bi-hand-thumbs-up"></i> {{ post.avisCount }}
                                    </button>
                                </form>
                                <form method="post" action="{{ path('forum_post_dislike', {id: post.id}) }}" class="d-inline">
                                    <button type="submit" class="btn btn-link btn-sm p-0 text-decoration-none" title="Je n'aime pas">
                                        <i class="bi bi-hand-thumbs-down"></i> {{ post.dislikeCount }}
                                    </button>
                                </form>
                            </span>
                        </div>
                    </div>
                </div>

                <div class="article-wrapper">
                    <div class="article-content">
                        <div class="content-section">
                            {% if post.excerpt %}
                                <p class="lead">{{ post.excerpt }}</p>
                            {% endif %}
                            <div class="content-body">
                                {{ post.content|nl2br }}
                            </div>
                        </div>
                    </div>
                </div>
            </article>

            <!-- Comments Section -->
            <div class="blog-comments mt-5">
                <div class="comments-header">
                    <h3 class="title">Commentaires</h3>
                    <div class="comments-stats">
                        <span class="count">{{ post.commentsCount }}</span>
                        <span class="label">commentaires</span>
                    </div>
                </div>

                {% for message in app.flashes('success') %}
                    <div class="alert alert-success">{{ message }}</div>
                {% endfor %}
                {% for message in app.flashes('error') %}
                    <div class="alert alert-danger">{{ message }}</div>
                {% endfor %}

                <!-- Comment Form -->
                <div class="blog-comment-form mb-5">
                    <div class="form-header">
                        <h3>Laisser un commentaire</h3>
                        <p>Votre adresse email ne sera pas publiée.</p>
                    </div>
                    {{ form_start(form, {attr: {class: 'comment-form'}}) }}
                    <div class="input-group mb-3">
                        {{ form_label(form.author) }}
                        {{ form_widget(form.author, {attr: {placeholder: 'Votre nom'}}) }}
                        {{ form_errors(form.author) }}
                    </div>
                    <div class="input-group mb-3">
                        {{ form_label(form.content) }}
                        {{ form_widget(form.content, {attr: {placeholder: 'Votre commentaire...'}}) }}
                        {{ form_errors(form.content) }}
                    </div>
                    <button type="submit" class="btn btn-primary">Publier le commentaire</button>
                    {{ form_end(form) }}
                </div>

                <!-- Comments List -->
                <div class="comments-container">
                    {% for comment in root_comments %}
                        <div class="comment-thread" id="comment-{{ comment.id }}">
                            <div class="comment-box">
                                <div class="comment-wrapper">
                                    <div class="avatar-wrapper">
                                        <img src="https://ui-avatars.com/api/?name={{ comment.author|url_encode }}&background=random" alt="{{ comment.author }}" />
                                    </div>
                                    <div class="comment-content">
                                        <div class="comment-header d-flex justify-content-between align-items-start flex-wrap">
                                            <div class="user-info">
                                                <h4>{{ comment.author }}</h4>
                                                <span class="time-badge">
                                                    <i class="bi bi-clock"></i> {{ comment.createdAt|date('d M Y à H:i') }}
                                                </span>
                                            </div>
                                            <div class="comment-actions d-flex align-items-center gap-2">
                                                <form method="post" action="{{ path('forum_comment_avis', {id: comment.id}) }}" class="d-inline">
                                                    <button type="submit" class="btn btn-link btn-sm p-0 text-decoration-none" title="J'aime">
                                                        <i class="bi bi-hand-thumbs-up"></i> {{ comment.avisCount }}
                                                    </button>
                                                </form>
                                                <form method="post" action="{{ path('forum_comment_dislike', {id: comment.id}) }}" class="d-inline">
                                                    <button type="submit" class="btn btn-link btn-sm p-0 text-decoration-none" title="Je n'aime pas">
                                                        <i class="bi bi-hand-thumbs-down"></i> {{ comment.dislikeCount }}
                                                    </button>
                                                </form>
                                                {% if current_author is same as(comment.author) %}
                                                    <a href="{{ path('forum_comment_edit', {id: comment.id}) }}" class="btn btn-sm btn-outline-warning" title="Modifier">Modifier</a>
                                                    <form method="post" action="{{ path('forum_comment_delete', {id: comment.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce commentaire ?');">
                                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_comment' ~ comment.id) }}">
                                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Supprimer">Supprimer</button>
                                                    </form>
                                                {% endif %}
                                            </div>
                                        </div>
                                        <div class="comment-body">
                                            <p>{{ comment.content|nl2br }}</p>
                                        </div>
                                        <div class="reply-form-toggle mt-2">
                                            <button type="button" class="btn btn-sm btn-outline-secondary reply-btn" data-comment-id="{{ comment.id }}" data-author="{{ comment.author }}">Répondre</button>
                                        </div>
                                        <div class="reply-form-wrapper d-none mt-2" id="reply-form-{{ comment.id }}">
                                            <form method="post" action="{{ path('forum_post_show', {id: post.id}) }}" class="border-start border-3 border-secondary ps-3">
                                                <input type="hidden" name="parent_id" value="{{ comment.id }}">
                                                <input type="hidden" name="comment_type[_token]" value="{{ csrf_token('comment_type') }}">
                                                <div class="mb-2">
                                                    <label class="form-label">Votre nom</label>
                                                    <input type="text" name="comment_type[author]" class="form-control" required placeholder="Votre nom" maxlength="180">
                                                </div>
                                                <div class="mb-2">
                                                    <label class="form-label">Réponse</label>
                                                    <textarea name="comment_type[content]" class="form-control" rows="3" required placeholder="Votre réponse..." minlength="3" maxlength="2000"></textarea>
                                                </div>
                                                <button type="submit" class="btn btn-primary btn-sm">Envoyer la réponse</button>
                                            </form>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            {% for reply in comment.replies %}
                                <div class="comment-thread ms-4 mt-3" id="comment-{{ reply.id }}">
                                    <div class="comment-box">
                                        <div class="comment-wrapper">
                                            <div class="avatar-wrapper">
                                                <img src="https://ui-avatars.com/api/?name={{ reply.author|url_encode }}&background=random" alt="{{ reply.author }}" />
                                            </div>
                                            <div class="comment-content">
                                                <div class="comment-header d-flex justify-content-between align-items-start flex-wrap">
                                                    <div class="user-info">
                                                        <h4>{{ reply.author }}</h4>
                                                        <span class="time-badge"><i class="bi bi-clock"></i> {{ reply.createdAt|date('d M Y à H:i') }}</span>
                                                    </div>
                                                    <div class="comment-actions d-flex align-items-center gap-2">
                                                        <form method="post" action="{{ path('forum_comment_avis', {id: reply.id}) }}" class="d-inline">
                                                            <button type="submit" class="btn btn-link btn-sm p-0 text-decoration-none"><i class="bi bi-hand-thumbs-up"></i> {{ reply.avisCount }}</button>
                                                        </form>
                                                        <form method="post" action="{{ path('forum_comment_dislike', {id: reply.id}) }}" class="d-inline">
                                                            <button type="submit" class="btn btn-link btn-sm p-0 text-decoration-none"><i class="bi bi-hand-thumbs-down"></i> {{ reply.dislikeCount }}</button>
                                                        </form>
                                                        {% if current_author is same as(reply.author) %}
                                                            <a href="{{ path('forum_comment_edit', {id: reply.id}) }}" class="btn btn-sm btn-outline-warning">Modifier</a>
                                                            <form method="post" action="{{ path('forum_comment_delete', {id: reply.id}) }}" class="d-inline" onsubmit="return confirm('Supprimer ce commentaire ?');">
                                                                <input type="hidden" name="_token" value="{{ csrf_token('delete_comment' ~ reply.id) }}">
                                                                <button type="submit" class="btn btn-sm btn-outline-danger">Supprimer</button>
                                                            </form>
                                                        {% endif %}
                                                    </div>
                                                </div>
                                                <div class="comment-body">
                                                    <p>{{ reply.content|nl2br }}</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% else %}
                        <p class="text-muted">Aucun commentaire pour le moment. Soyez le premier à réagir !</p>
                    {% endfor %}
                </div>
            </div>
        </div>
    </section>
    <script>
        document.querySelectorAll('.reply-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var id = this.getAttribute('data-comment-id');
                var wrap = document.getElementById('reply-form-' + id);
                wrap.classList.toggle('d-none');
            });
        });
    </script>
    {% include 'frontOffice/forum/_chatbot.html.twig' %}
{% endblock %}

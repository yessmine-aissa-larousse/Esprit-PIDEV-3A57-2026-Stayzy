// ===== FACE LOGIN =====
let faceStream = null;
let faceDetectionInterval = null;

async function startFaceLogin() {
    const modal = new bootstrap.Modal(document.getElementById('faceModal'));
    modal.show();

    document.getElementById('faceStatus').innerHTML =
        '<i class="bi bi-camera me-2"></i>Positionnez votre visage dans le cadre';

    faceStream = await navigator.mediaDevices.getUserMedia({ video: true });
    document.getElementById('faceVideo').srcObject = faceStream;

    faceDetectionInterval = setInterval(detectAndLogin, 2000);
}

async function detectAndLogin() {
    const video = document.getElementById('faceVideo');

    document.getElementById('faceStatus').className = 'alert alert-info mb-3';
    document.getElementById('faceStatus').innerHTML =
        '<i class="bi bi-hourglass me-2"></i>Analyse en cours...';

    clearInterval(faceDetectionInterval);

    const canvas = document.createElement('canvas');
    canvas.width  = video.videoWidth;
    canvas.height = video.videoHeight;
    canvas.getContext('2d').drawImage(video, 0, 0);
    const imageBase64 = canvas.toDataURL('image/jpeg').split(',')[1];

    const response = await fetch('/face/login', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ image: imageBase64 })
    });

    const result = await response.json();

    if (result.success) {
        document.getElementById('faceStatus').className = 'alert alert-success mb-3';
        document.getElementById('faceStatus').innerHTML =
            '<i class="bi bi-check-circle-fill me-2"></i>Bienvenue ' + result.name + '! Redirection...';
        stopCamera();
        setTimeout(() => window.location.href = result.redirect, 1500);
    } else {
        document.getElementById('faceStatus').className = 'alert alert-danger mb-3';
        document.getElementById('faceStatus').innerHTML =
            '<i class="bi bi-x-circle me-2"></i>' + (result.error || 'Visage non reconnu') + '. Réessayez.';
        setTimeout(() => {
            faceDetectionInterval = setInterval(detectAndLogin, 2000);
        }, 2000);
    }
}

function stopCamera() {
    if (faceStream) {
        faceStream.getTracks().forEach(t => t.stop());
        faceStream = null;
    }
    if (faceDetectionInterval) {
        clearInterval(faceDetectionInterval);
    }
}

document.getElementById('faceModal')?.addEventListener('hidden.bs.modal', stopCamera);

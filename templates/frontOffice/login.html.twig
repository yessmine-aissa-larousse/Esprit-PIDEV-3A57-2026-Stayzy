{% extends 'frontOffice/base.html.twig' %}

{% block title %}Se connecter - Stayzy{% endblock %}

{% block body %}
<main class="main">
    <section style="padding: 80px 0; background: #f8f9fa; min-height: 70vh; display: flex; align-items: center;">
        <div class="container">
            <div class="row justify-content-center">
                <div class="col-lg-5 col-md-7">

                    {% for message in app.flashes('success') %}
                        <div class="alert alert-success alert-dismissible fade show">
                            <i class="bi bi-check-circle me-2"></i>{{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}
                    {% for message in app.flashes('error') %}
                        <div class="alert alert-danger alert-dismissible fade show">
                            <i class="bi bi-exclamation-triangle me-2"></i>{{ message }}
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    {% endfor %}

                    <div class="card shadow-lg border-0" style="border-radius: 16px; overflow: hidden;">

                        <div style="background: #2e7d32; padding: 40px 30px 30px; text-align: center;">
                            <div style="background: rgba(255,255,255,0.15); width: 70px; height: 70px; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 15px;">
                                <i class="bi bi-house-heart" style="font-size: 32px; color: white;"></i>
                            </div>
                            <h3 style="color: white; font-weight: 700; margin: 0;">Bienvenue sur Stayzy</h3>
                            <p style="color: rgba(255,255,255,0.8); margin: 8px 0 0; font-size: 14px;">Connectez-vous à votre compte</p>
                        </div>

                        <div class="card-body" style="padding: 35px;">

                            {% if error %}
                                {% if 'Too many failed login attempts' in error.messageKey or 'throttl' in error.messageKey %}
                                <div class="alert alert-warning d-flex align-items-start" style="border-radius:10px;">
                                    <i class="bi bi-clock-history me-2 mt-1" style="font-size:20px;color:#f57f17;"></i>
                                    <div>
                                        <strong>Trop de tentatives échouées</strong><br>
                                        <small>Vous avez dépassé 3 tentatives incorrectes.<br>
                                        Veuillez patienter <strong>30 secondes</strong> avant de réessayer.</small>
                                    </div>
                                </div>
                                {% else %}
                                <div class="alert alert-danger d-flex align-items-center" style="border-radius:10px;">
                                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                                    <div>{{ error.messageKey|trans(error.messageData, 'security') }}</div>
                                </div>
                                {% endif %}
                            {% endif %}

                            <form method="post" action="{{ path('app_login') }}">

                                <div class="mb-4">
                                    <label for="email" class="form-label fw-semibold" style="color: #333;">
                                        <i class="bi bi-envelope me-1" style="color: #2e7d32;"></i> Adresse Email
                                    </label>
                                    <input type="email"
                                           id="email"
                                           name="_username"
                                           class="form-control form-control-lg"
                                           value="{{ last_username }}"
                                           placeholder="votre@email.com"
                                           required autofocus
                                           style="border-radius: 10px; border: 1.5px solid #ddd; padding: 12px 16px;">
                                </div>

                                <div class="mb-4">
                                    <label for="password" class="form-label fw-semibold" style="color: #333;">
                                        <i class="bi bi-lock me-1" style="color: #2e7d32;"></i> Mot de passe
                                    </label>
                                    <div class="input-group">
                                        <input type="password"
                                               id="password"
                                               name="_password"
                                               class="form-control form-control-lg"
                                               placeholder="••••••••"
                                               required
                                               style="border-radius: 10px 0 0 10px; border: 1.5px solid #ddd; padding: 12px 16px;">
                                        <button class="btn btn-outline-secondary" type="button"
                                                onclick="togglePassword()"
                                                style="border-radius: 0 10px 10px 0;">
                                            <i class="bi bi-eye" id="toggleIcon"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mb-4">
                                    <div class="form-check">
                                        <input class="form-check-input" type="checkbox" name="_remember_me" id="remember_me">
                                        <label class="form-check-label text-muted" for="remember_me" style="font-size: 14px;">
                                            Se souvenir de moi
                                        </label>
                                    </div>
                                </div>

                                        <a href="{{ path('app_forgot_password') }}" style="color: #2e7d32; font-size: 14px;">
                                            Mot de passe oublié?
                                        </a>                               
                                     </div>

                                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                                <!-- CAPTCHA code centré -->
                                <div class="mb-3">
                                    <div style="background:#f8f9fa;border:1.5px solid #e0e0e0;border-radius:12px;padding:16px;">

                                        <p style="text-align:center;font-weight:600;color:#333;font-size:13px;margin-bottom:10px;">
                                            <i class="bi bi-shield-lock" style="color:#2e7d32;margin-right:5px;"></i>
                                            Vérification de sécurité
                                        </p>

                                        <!-- Image + bouton refresh centrés -->
                                        <div style="display:flex;justify-content:center;align-items:center;gap:10px;margin-bottom:10px;">
                                            <img id="captchaImgLogin"
                                                 src="{{ path('captcha_image') }}"
                                                 alt="CAPTCHA"
                                                 style="display:block;border-radius:10px;border:2px solid #c8e6c9;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,.1);"
                                                 title="Cliquer pour rafraîchir">
                                            <button type="button"
                                                    onclick="refreshLoginCaptcha()"
                                                    style="background:#e8f5e9;border:1.5px solid #c8e6c9;border-radius:8px;color:#2e7d32;padding:6px 10px;cursor:pointer;font-size:16px;">
                                                <i class="bi bi-arrow-clockwise"></i>
                                            </button>
                                        </div>

                                        <!-- Input centré -->
                                        <div style="display:flex;justify-content:center;">
                                            <input type="text"
                                                   name="captcha_code"
                                                   placeholder="Entrez le code"
                                                   required
                                                   autocomplete="off"
                                                   maxlength="6"
                                                   style="width:200px;text-align:center;letter-spacing:8px;font-weight:700;font-size:18px;text-transform:uppercase;border:2px solid #c8e6c9;border-radius:10px;padding:10px;outline:none;background:#fff;">
                                        </div>

                                        <p style="text-align:center;font-size:11px;color:#888;margin-top:6px;margin-bottom:0;">
                                            Cliquez sur l'image pour en obtenir un nouveau
                                        </p>
                                    </div>
                                </div>

                                <button type="submit" class="btn btn-lg w-100 fw-semibold"
                                        style="background: #2e7d32; color: white; border-radius: 10px; padding: 14px; font-size: 16px; border: none;">
                                    <i class="bi bi-box-arrow-in-right me-2"></i> Se connecter
                                </button>

                            </form>

                            <!-- Google Sign-In -->
                            <div class="my-3 d-flex align-items-center gap-2">
                                <hr class="flex-grow-1 m-0"><span class="text-muted small">ou</span><hr class="flex-grow-1 m-0">
                            </div>
                            <a href="{{ path('connect_google') }}"
                               class="btn btn-lg w-100 d-flex align-items-center justify-content-center gap-2 fw-semibold"
                               style="border: 1.5px solid #ddd; border-radius: 10px; padding: 12px; color: #333; background: #fff;">
                                <img src="https://www.gstatic.com/firebasejs/ui/2.0.0/images/auth/google.svg" width="22" height="22" alt="Google">
                                Continuer avec Google
                            </a>

                            {# ===== FACE ID ===== #}
                            <div class="text-center mt-3">
                                <button type="button"
                                        onclick="startFaceLogin()"
                                        class="btn btn-lg w-100 fw-semibold"
                                        style="background: #1565c0; color: white; border-radius: 10px; padding: 14px; border: none;">
                                    <i class="bi bi-camera me-2"></i> Se connecter avec mon visage
                                </button>
                            </div>
                            {# ===== FIN FACE ID ===== #}

                            <hr style="margin: 25px 0; border-color: #eee;">

                            <div class="text-center">
                                <p class="text-muted mb-3" style="font-size: 14px;">Vous n'avez pas de compte?</p>
                                <div class="d-flex gap-2 justify-content-center">
                                    <a href="{{ path('app_register', {'role': 'client'}) }}"
                                       class="btn btn-outline-success btn-sm"
                                       style="border-radius: 8px; padding: 8px 20px;">
                                        <i class="bi bi-person me-1"></i> Client
                                    </a>
                                    <a href="{{ path('app_register', {'role': 'proprietaire'}) }}"
                                       class="btn btn-outline-success btn-sm"
                                       style="border-radius: 8px; padding: 8px 20px;">
                                        <i class="bi bi-building me-1"></i> Propriétaire
                                    </a>
                                </div>
                            </div>

                        </div>
                    </div>

                </div>
            </div>
        </div>
    </section>
</main>

{# ── Caméra : overlay fixe indépendant de Bootstrap ───────────────────────── #}

{# Fond sombre cliquable #}
<div id="faceBackdrop"
     onclick="stopFaceLogin()"
     style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.65);
            z-index:9998; cursor:pointer;"></div>

{# Fenêtre caméra centrée #}
<div id="faceWindow"
     style="display:none; position:fixed; top:50%; left:50%;
            transform:translate(-50%,-50%);
            z-index:9999; background:#fff; border-radius:18px;
            box-shadow:0 24px 64px rgba(0,0,0,0.45);
            width:400px; max-width:95vw; overflow:hidden;">

    {# En-tête #}
    <div style="background:#1565c0; padding:16px 20px;
                display:flex; align-items:center; justify-content:space-between;">
        <span style="color:#fff; font-weight:600; font-size:15px;">
            <i class="bi bi-camera me-2"></i>Reconnaissance Faciale
        </span>
        <button onclick="stopFaceLogin()" type="button"
                style="background:none; border:none; color:#fff; font-size:22px;
                       line-height:1; cursor:pointer;"
                aria-label="Fermer">&times;</button>
    </div>

    {# Corps #}
    <div style="padding:20px; text-align:center;">
        <div id="faceStatus"
             style="background:#e3f2fd; border:1px solid #90caf9; border-radius:10px;
                    padding:10px 14px; font-size:14px; margin-bottom:16px; color:#0d47a1;">
            <i class="bi bi-info-circle me-2"></i>Activation de la caméra…
        </div>

        <div style="position:relative; display:inline-block;">
            <video id="faceVideo" autoplay muted playsinline
                   width="360" height="270"
                   style="border-radius:12px; border:3px solid #1565c0;
                          display:block; background:#000;"></video>
            <canvas id="faceCanvas" width="360" height="270"
                    style="position:absolute; top:0; left:0;
                           border-radius:12px; pointer-events:none;"></canvas>
        </div>

        <div style="margin-top:14px;">
            <button onclick="stopFaceLogin()" type="button"
                    style="background:#f5f5f5; border:1px solid #ccc; border-radius:8px;
                           padding:8px 20px; cursor:pointer; font-size:14px; color:#555;">
                <i class="bi bi-x-circle me-1"></i> Fermer
            </button>
        </div>
    </div>
</div>
{# ── Fin overlay caméra ───────────────────────────────────────────────────── #}

{% endblock %}

{% block javascripts %}
{{ parent() }}
<script>
function refreshLoginCaptcha() {
    const img = document.getElementById('captchaImgLogin');
    if (img) img.src = '/captcha/image?' + Date.now();
}
document.addEventListener('DOMContentLoaded', function() {
    document.getElementById('captchaImgLogin')?.addEventListener('click', refreshLoginCaptcha);
});

function togglePassword() {
    const pwd = document.getElementById('password');
    const icon = document.getElementById('toggleIcon');
    if (pwd.type === 'password') {
        pwd.type = 'text';
        icon.className = 'bi bi-eye-slash';
    } else {
        pwd.type = 'password';
        icon.className = 'bi bi-eye';
    }
}

// ===== FACE LOGIN — overlay fixe (sans Bootstrap modal) =====
let faceStream = null;
let faceDetectionInterval = null;

async function startFaceLogin() {
    document.getElementById('faceBackdrop').style.display = 'block';
    document.getElementById('faceWindow').style.display  = 'block';
    setFaceStatus('info', '<i class="bi bi-camera me-2"></i>Activation de la caméra…');

    try {
        faceStream = await navigator.mediaDevices.getUserMedia({ video: true, audio: false });
        document.getElementById('faceVideo').srcObject = faceStream;
        setFaceStatus('info', '<i class="bi bi-camera me-2"></i>Positionnez votre visage dans le cadre');
        faceDetectionInterval = setInterval(detectAndLogin, 2000);
    } catch (err) {
        setFaceStatus('danger', '<i class="bi bi-x-circle me-2"></i>Caméra inaccessible : ' + err.message);
    }
}

function stopFaceLogin() {
    if (faceStream) {
        faceStream.getTracks().forEach(t => t.stop());
        faceStream = null;
    }
    clearInterval(faceDetectionInterval);
    faceDetectionInterval = null;
    document.getElementById('faceVideo').srcObject = null;
    document.getElementById('faceBackdrop').style.display = 'none';
    document.getElementById('faceWindow').style.display  = 'none';
    setFaceStatus('info', '<i class="bi bi-info-circle me-2"></i>Activation de la caméra…');
}

function setFaceStatus(type, html) {
    const el = document.getElementById('faceStatus');
    const colours = { info:'#e3f2fd', success:'#e8f5e9', danger:'#ffebee', warning:'#fff8e1' };
    const borders  = { info:'#90caf9', success:'#a5d6a7', danger:'#ef9a9a', warning:'#ffe082' };
    const texts    = { info:'#0d47a1', success:'#1b5e20', danger:'#b71c1c', warning:'#e65100' };
    el.style.background   = colours[type]  || colours.info;
    el.style.borderColor  = borders[type]  || borders.info;
    el.style.color        = texts[type]    || texts.info;
    el.innerHTML = html;
}

async function detectAndLogin() {
    const video = document.getElementById('faceVideo');
    if (!video.videoWidth) return;

    clearInterval(faceDetectionInterval);
    setFaceStatus('info', '<i class="bi bi-hourglass me-2"></i>Analyse en cours…');

    const snap = document.createElement('canvas');
    snap.width  = video.videoWidth;
    snap.height = video.videoHeight;
    snap.getContext('2d').drawImage(video, 0, 0);
    const imageBase64 = snap.toDataURL('image/jpeg').split(',')[1];

    let res;
    try {
        res = await fetch('/face/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ image: imageBase64 })
        });
    } catch (networkErr) {
        // True network error — Symfony unreachable
        console.error('[FaceLogin] network error:', networkErr);
        setFaceStatus('danger',
            '<i class="bi bi-wifi-off me-2"></i>Serveur inaccessible. Vérifiez que MAMP est démarré.');
        setTimeout(() => { if (faceStream) faceDetectionInterval = setInterval(detectAndLogin, 2000); }, 3000);
        return;
    }

    // Non-JSON response (Symfony 500 / redirect / debug page)
    const contentType = res.headers.get('content-type') || '';
    if (!contentType.includes('application/json')) {
        const raw = await res.text();
        console.error('[FaceLogin] HTTP', res.status, '— non-JSON response:', raw.substring(0, 300));
        setFaceStatus('danger',
            '<i class="bi bi-x-circle me-2"></i>Erreur serveur HTTP ' + res.status +
            '. Consultez la console du navigateur (F12) pour les détails.');
        setTimeout(() => { if (faceStream) faceDetectionInterval = setInterval(detectAndLogin, 2000); }, 3000);
        return;
    }

    const result = await res.json();

    if (result.success) {
        setFaceStatus('success',
            '<i class="bi bi-check-circle-fill me-2"></i>Bienvenue ' + result.name + ' ! Redirection…');
        stopFaceLogin();
        setTimeout(() => window.location.href = result.redirect, 1200);
    } else {
        const msg = result.error || 'Visage non reconnu';
        // Show Flask-unreachable error more clearly
        const display = msg.includes('Flask unreachable')
            ? '<i class="bi bi-plug me-2"></i>Serveur de reconnaissance non démarré. Lancez flask_face_server.py.'
            : '<i class="bi bi-x-circle me-2"></i>' + msg + '. Réessayez.';
        setFaceStatus('danger', display);
        setTimeout(() => { if (faceStream) faceDetectionInterval = setInterval(detectAndLogin, 2000); }, 2500);
    }
}
// ===== FIN FACE LOGIN =====
</script>
{% endblock %}
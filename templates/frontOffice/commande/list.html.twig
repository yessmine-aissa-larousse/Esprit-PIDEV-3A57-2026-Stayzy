{% extends 'frontOffice/base.html.twig' %}

{% block title %}Mes Commandes{% endblock %}

{% block body %}

<style>
    .orders-container {
        min-height: 80vh;
        background: linear-gradient(135deg, #f8fff9, #ffffff);
        padding-bottom: 60px;
    }

    .orders-title {
        font-size: 32px;
        font-weight: 700;
        color: #198754;
        letter-spacing: 1px;
    }

    .orders-card {
        border-radius: 20px;
        overflow: hidden;
        box-shadow: 0 15px 40px rgba(0,0,0,0.08);
        animation: fadeIn 0.6s ease-in-out;
    }

    .table thead {
        font-size: 14px;
        text-transform: uppercase;
        letter-spacing: 0.5px;
    }

    .table tbody tr {
        transition: 0.3s;
    }

    .table tbody tr:hover {
        background-color: #f2fff5;
        transform: scale(1.01);
    }

    .badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-weight: 500;
        font-size: 12px;
    }

    .btn-custom {
        border-radius: 30px;
        padding: 6px 18px;
        font-weight: 600;
        transition: 0.3s;
    }

    .btn-custom:hover {
        transform: scale(1.05);
        box-shadow: 0 5px 15px rgba(0,0,0,0.15);
    }

    .empty-state {
        padding: 60px 20px;
        text-align: center;
        color: #888;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="orders-container">

    <div class="mb-4 mt-5 text-center">
        <h2 class="orders-title">🛒 Mes Commandes</h2>
        <p class="text-muted">Consultez et gérez vos réservations</p>
    </div>

    {% for message in app.flashes('success') %}
        <div class="alert alert-success alert-dismissible fade show small mx-auto" style="max-width: 800px;" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    {% endfor %}

    <div class="card orders-card mx-auto" style="max-width: 1400px;">
        <div class="card-body p-0">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-success text-dark">
                    <tr>
                        <th>Logement</th>
                        <th>Date Début</th>
                        <th>Date Fin</th>
                        <th>Personnes</th>
                        <th>Prix</th>
                        <th>Status</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for commande in commandes %}
                        <tr>
                            <td class="fw-semibold">{{ commande.reservation.logement.titre }}</td>
                            <td>{{ commande.dateDebut|date('d/m/Y') }}</td>
                            <td>{{ commande.dateFin|date('d/m/Y') }}</td>
                            <td>{{ commande.reservation.nombrePersonnes }}</td>
                            <td class="fw-bold text-success">{{ commande.prixTotal }} DT</td>
                            <td>
                                {% set status = commande.paymentStatus %}
                                {% if status == 'EN_ATTENTE' %}
                                    <span class="badge bg-warning bg-opacity-25 text-warning">
                                        ⏳ En attente
                                    </span>
                                {% elseif status == 'PAYÉ' %}
                                    <span class="badge bg-success bg-opacity-25 text-success">
                                        ✔ Payé
                                    </span>
                                {% else %}
                                    <span class="badge bg-danger bg-opacity-25 text-danger">
                                        ✖ Annulé
                                    </span>
                                {% endif %}
                            </td>
                            <td class="text-end">
                                {% if status == 'EN_ATTENTE' %}
                                    <button class="btn btn-success btn-sm btn-custom checkout-button"
                                            data-stripe-key="{{ stripe_public_key }}"
                                            data-commande-id="{{ commande.id }}">
                                        💳 Payer
                                    </button>
                                {% elseif status == 'PAYÉ' %}
                                    <a href="{{ path('commande_commande_facture', {'id': commande.id}) }}"
                                       class="btn btn-outline-success btn-sm btn-custom"
                                       target="_blank">
                                        🧾 Imprimer Facture
                                    </a>
                                {% endif %}
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="8">
                                <div class="empty-state">
                                    <h5>Aucune commande trouvée</h5>
                                    <p>Vous n’avez pas encore effectué de réservation.</p>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>

</div>

<script>
document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.checkout-button').forEach(button => {
        button.addEventListener('click', async () => {
            const stripe = Stripe(button.dataset.stripeKey);
            const commandeId = button.dataset.commandeId;

            try {
                const res = await fetch(`/stripe/create-session/${commandeId}`, { method: 'POST' });
                const session = await res.json();
                if (session.id) {
                    stripe.redirectToCheckout({ sessionId: session.id });
                } else {
                    alert('Erreur lors de la création du paiement');
                }
            } catch (err) {
                console.error(err);
                alert('Impossible de contacter le serveur.');
            }
        });
    });
});
</script>

{% endblock %}
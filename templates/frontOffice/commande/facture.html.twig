<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Facture</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            font-size: 14px;
            color: #1b3a2a;
        }

        h1 {
            text-align: center;
            color: #27ae60;
            font-size: 28px;
        }

        hr {
            border: 2px solid #27ae60;
        }

        .client-info, .commande-info {
            margin-bottom: 25px;
        }

        .client-info p, .commande-info p {
            margin: 3px 0;
            font-size: 14px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-bottom: 25px;
        }

        th, td {
            border: 1px solid #27ae60;
            padding: 10px;
            text-align: left;
            font-size: 14px;
        }

        th {
            background-color: #2ecc71;
            color: white;
            font-size: 15px;
        }

        tr:nth-child(even) {
            background-color: #d5f5e3;
        }

        .total {
            text-align: right;
            font-size: 18px;
            font-weight: bold;
            color: #27ae60;
        }

        .footer {
            text-align: center;
            margin-top: 50px;
            font-size: 12px;
            color: #555;
        }
    </style>
</head>
<body>

<h1>FACTURE</h1>
<hr>

<div class="client-info">
    <p><strong>Numéro :</strong> {{ commande.id }}</p>
    <p><strong>Date :</strong> {{ commande.dateTransaction ? commande.dateTransaction|date('d/m/Y') : 'N/A' }}</p>
    <p><strong>Client :</strong> {{ commande.user.nom }} {{ commande.user.prenom }}</p>
    <p><strong>Email :</strong> {{ commande.user.email }}</p>
</div>

<div class="commande-info">
    <p><strong>Logement :</strong> {{ commande.reservation.logement.titre }}</p>
    <p><strong>Adresse :</strong> {{ commande.reservation.logement.adresse ? commande.reservation.logement.adresse|join(', ') : 'N/A' }}</p>
    <p><strong>Propriétaire :</strong> {{ commande.reservation.logement.proprietaire.nom }}</p>
    <p><strong>Date de début :</strong> {{ commande.dateDebut ? commande.dateDebut|date('d/m/Y') : 'N/A' }}</p>
    <p><strong>Date de fin :</strong> {{ commande.dateFin ? commande.dateFin|date('d/m/Y') : 'N/A' }}</p>

    {% set jours = (commande.dateDebut and commande.dateFin) ? commande.dateFin.diff(commande.dateDebut).days : 1 %}
    <p><strong>Durée :</strong> {{ jours }} nuit{{ jours > 1 ? 's' : '' }}</p>

    {% set personnes = commande.reservation.nombrePersonnes ?: 1 %}
    <p><strong>Nombre de personnes :</strong> {{ personnes }}</p>
</div>

<table>
    <thead>
        <tr>
            <th>Logement</th>
            <th>Prix unitaire</th>
            <th>Durée (nuits)</th>
            <th>Nombre de personnes</th>
            <th>Total</th>
        </tr>
    </thead>
    <tbody>
        {% set prixUnitaire = commande.prixTotal is not null ? (commande.prixTotal / jours) : 0 %}
        <tr>
            <td>{{ commande.reservation.logement.titre }}</td>
            <td>{{ prixUnitaire | number_format(2, ',', ' ') }} TND</td>
            <td>{{ jours }}</td>
            <td>{{ personnes }}</td>
            <td>{{ commande.prixTotal ?: 0 }} TND</td>
        </tr>
    </tbody>
</table>

<p class="total">Total à payer : {{ commande.prixTotal ?: 0 }} TND</p>

<div class="footer">
    Merci pour votre réservation !<br>
    Stayzy - Tous droits réservés
</div>

</body>
</html>
{% extends 'frontOffice/base.html.twig' %}
{% block title %}Mes visites{% endblock %}

{% block body %}

<div class="page-title light-background">
    <div class="container">
        <h1>Mes demandes de visite</h1>
    </div>
</div>

<section class="section">
<div class="container">

{% if visites|length > 0 %}

<div class="row g-4">

{% for v in visites %}
<div class="col-lg-6">

<div class="card shadow h-100 border-0">

<div class="card-body d-flex flex-column">

<div class="d-flex justify-content-between align-items-start mb-2">
<h5 class="fw-bold mb-0">{{ v.logement.titre }}</h5>

{% if v.statut == 'EN_ATTENTE' %}
<span class="badge bg-warning text-dark px-3 py-2">En attente</span>
{% elseif v.statut == 'ACCEPTEE' %}
<span class="badge bg-success px-3 py-2">Confirmée</span>
{% else %}
<span class="badge bg-danger px-3 py-2">Refusée</span>
{% endif %}
</div>

<div class="text-muted mb-3">
<i class="bi bi-calendar"></i>
{{ v.dateVisite|date('d/m/Y') }}
&nbsp; à &nbsp;
<i class="bi bi-clock"></i>
{{ v.heureVisite|date('H:i') }}
</div>

{% if v.note %}
<div class="bg-light rounded p-3 mb-3">
{{ v.note }}
</div>
{% endif %}

{% if v.statut == 'EN_ATTENTE' %}
<div class="mt-auto d-flex gap-2">
<a href="{{ path('client_visite_edit', {'id': v.id}) }}" class="btn btn-outline-primary w-100">
Modifier
</a>

<a href="{{ path('client_visite_delete', {'id': v.id}) }}" class="btn btn-outline-danger w-100">
Annuler
</a>
</div>
{% endif %}

</div>
</div>
</div>
{% endfor %}

</div>

{% else %}

<div class="row justify-content-center">
<div class="col-lg-6">
<div class="card shadow text-center p-5">

<h4 class="mb-3">Aucune visite demandée</h4>
<p class="text-muted">Vous n'avez encore envoyé aucune demande de visite.</p>

<a href="{{ path('app_properties') }}" class="btn btn-primary mt-3">
Voir les logements disponibles
</a>

</div>
</div>
</div>

{% endif %}

</div>
</section>

{% endblock %}

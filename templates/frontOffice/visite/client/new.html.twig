{% extends 'frontOffice/base.html.twig' %}
{% block title %}Demander une visite{% endblock %}

{% block body %}

<div class="page-title light-background">
  <div class="container">
    <h1>Nouvelle demande de visite</h1>
  </div>
</div>

<section class="section">
<div class="container">
<div class="row justify-content-center">
<div class="col-lg-8">

<div class="card shadow p-4">

<div class="alert alert-primary text-center mb-4">
<h4>Planifier une visite</h4>
</div>

{{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

<!-- Date -->
<div class="mb-4">
<strong>Date :</strong>
<div class="border rounded p-2 bg-light">
{{ form_widget(form.dateVisite, {'attr': {'class': 'form-control border-0 bg-light'}}) }}
</div>
<div class="text-danger small mt-1">{{ form_errors(form.dateVisite) }}</div>
</div>

<!-- Heure -->
<div class="mb-4">
<strong>Heure :</strong>
<div class="border rounded p-2 bg-light">
{{ form_widget(form.heureVisite, {'attr': {'class': 'form-control border-0 bg-light'}}) }}
</div>
<div class="text-danger small mt-1">{{ form_errors(form.heureVisite) }}</div>
</div>

<!-- Note -->
<div class="mb-4">
<strong>Message :</strong>
<div class="border rounded p-2 bg-light">
{{ form_widget(form.note, {'attr': {'class': 'form-control border-0 bg-light','rows':4}}) }}
</div>
<div class="text-danger small mt-1">{{ form_errors(form.note) }}</div>
</div>

<div class="text-center">
<button type="submit" class="btn btn-success px-4">
<i class="bi bi-calendar-check"></i> Demander
</button>
</div>

{{ form_end(form) }}

</div>
</div>
</div>
</div>
</section>

{% endblock %}

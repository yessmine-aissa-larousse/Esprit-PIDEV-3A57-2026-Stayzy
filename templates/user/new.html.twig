{% extends 'base.html.twig' %}

{% block title %}Ajouter un Utilisateur{% endblock %}

{% block body %}
<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h2 class="h5 mb-0"><i class="bi bi-plus-circle"></i> Ajouter un nouvel utilisateur</h2>
                </div>
                <div class="card-body">
                    {{ form_start(form) }}
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.nom) }}
                            {{ form_widget(form.nom) }}
                            {{ form_errors(form.nom) }}
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.prenom) }}
                            {{ form_widget(form.prenom) }}
                            {{ form_errors(form.prenom) }}
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        {{ form_label(form.email) }}
                        {{ form_widget(form.email) }}
                        {{ form_errors(form.email) }}
                    </div>
                    
                    <div class="mb-3">
                        {{ form_label(form.password) }}
                        {{ form_widget(form.password) }}
                        {{ form_errors(form.password) }}
                        <small class="text-muted"><i class="bi bi-info-circle"></i> Minimum 6 caractères</small>
                    </div>
                    
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.tel) }}
                            {{ form_widget(form.tel) }}
                            {{ form_errors(form.tel) }}
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            {{ form_label(form.adresse) }}
                            {{ form_widget(form.adresse) }}
                            {{ form_errors(form.adresse) }}
                        </div>
                    </div>
                    
                    <div class="mb-3">
                        {{ form_label(form.imageUrl) }}
                        {{ form_widget(form.imageUrl) }}
                        {{ form_errors(form.imageUrl) }}
                    </div>
                    
                    <div class="mb-3">
                        {{ form_label(form.roles) }}
                        <div class="form-check-group">
                            {{ form_widget(form.roles) }}
                        </div>
                        {{ form_errors(form.roles) }}
                    </div>
                    
                    <div class="mb-3 form-check">
                        {{ form_widget(form.isActive) }}
                        {{ form_label(form.isActive) }}
                        {{ form_errors(form.isActive) }}
                    </div>
                    
                    <div class="d-flex justify-content-between mt-4">
                        <a href="{{ path('app_user_index') }}" class="btn btn-secondary">
                            <i class="bi bi-arrow-left"></i> Retour à la liste
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-circle"></i> Ajouter l'utilisateur
                        </button>
                    </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
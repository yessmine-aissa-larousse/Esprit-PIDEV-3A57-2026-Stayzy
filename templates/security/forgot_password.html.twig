{% extends 'frontOffice/base.html.twig' %}
{% block title %}Mot de passe oublié - Stayzy{% endblock %}
{% block body %}
<section style="padding: 80px 0; background: #f8f9fa; min-height: 70vh;">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-lg-5">
                <div class="card shadow-lg border-0" style="border-radius: 16px;">
                    <div style="background: #2e7d32; padding: 30px; text-align: center; border-radius: 16px 16px 0 0;">
                        <h3 style="color: white; margin: 0;">🔑 Mot de passe oublié</h3>
                    </div>
                    <div class="card-body p-4">
                        {% if success %}
                            <div class="alert alert-success">
                                ✅ Si cet email existe, vous recevrez un lien de réinitialisation.
                            </div>
                        {% else %}
                            <form method="post">
                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Adresse Email</label>
                                    <input type="email" name="email" class="form-control form-control-lg"
                                           placeholder="votre@email.com" required>
                                </div>
                                <button type="submit" class="btn btn-lg w-100"
                                        style="background: #2e7d32; color: white; border-radius: 10px;">
                                    Envoyer le lien
                                </button>
                            </form>
                        {% endif %}
                        <div class="text-center mt-3">
                            <a href="{{ path('app_login') }}" style="color: #2e7d32;">
                                ← Retour à la connexion
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
{% endblock %}
